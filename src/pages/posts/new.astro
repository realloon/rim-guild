---
import Layout from '../../layouts/Layout.astro'
import PostForm from '../../components/PostForm.astro'
import ErrorBox from '../../components/ui/ErrorBox.astro'
import { actions } from 'astro:actions'

if (!Astro.locals.auth) {
  return Astro.redirect('/login?next=/posts/new')
}

const result = Astro.getActionResult(actions.createPost)

if (result && !result.error) {
  return Astro.redirect(`/posts/${result.data.id}`)
}
---

<Layout title="发布需求 · 边缘工会">
  <main>
    <div class="page-heading">
      <div>
        <h1>发布项目需求</h1>
        <p>把项目背景、需要的角色和当前进度写清楚，合作者才能从第一眼判断自己是否适合加入。</p>
      </div>
    </div>

    <section class="editor-card">
      <PostForm />
      <ErrorBox error={result?.error} />
    </section>
  </main>
</Layout>

<style>
  .editor-card {
    padding: clamp(22px, 5vw, 46px);
    border: 1px solid var(--border);
    border-top: 3px solid var(--forest);
    background: var(--bg-raised);
    box-shadow: var(--shadow);
  }
</style>
