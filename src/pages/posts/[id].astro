---
import Layout from '../../layouts/Layout.astro'
import AuthorAvatar from '../../components/AuthorAvatar.astro'
import ErrorBox from '../../components/ui/ErrorBox.astro'
import {
  POST_SELECT,
  postFromRow,
  roleLabel,
  roleStatusLabel,
  tagLabel,
  formatDate,
  type Post,
  type PostRow,
} from '../../lib/posts'
import { avatarUrl } from '../../lib/avatar'
import { actions } from 'astro:actions'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const { id } = Astro.params

const row = await db
  .prepare(`${POST_SELECT} WHERE p.id = ? GROUP BY p.id`)
  .bind(Number(id))
  .first<PostRow>()

const post: Post | undefined = row ? postFromRow(row) : undefined

if (!post) {
  Astro.response.status = 404
}

const isOwner = !!post && Astro.locals.auth?.profileToken === post.author_token
const myProfileToken = Astro.locals.auth?.profileToken ?? null

const roleStatusResult = Astro.getActionResult(actions.updateRoleStatus)
if (roleStatusResult && !roleStatusResult.error && post) {
  return Astro.redirect(`/posts/${post.id}`)
}
const interestResult = Astro.getActionResult(actions.registerInterest)
if (interestResult && !interestResult.error && post) {
  return Astro.redirect(`/posts/${post.id}`)
}
const cancelResult = Astro.getActionResult(actions.cancelInterest)
if (cancelResult && !cancelResult.error && post) {
  return Astro.redirect(`/posts/${post.id}`)
}
const deleteResult = Astro.getActionResult(actions.deletePost)
if (deleteResult && !deleteResult.error) {
  return Astro.redirect('/me')
}
const updateResult = Astro.getActionResult(actions.addPostUpdate)
if (updateResult && !updateResult.error && post) {
  return Astro.redirect(`/posts/${post.id}`)
}

let updateRows: { id: number; content: string; created_at: string }[] = []
let responseRows: {
  post_id: number
  role_type: string
  profile_token: string
  created_at: string
  author_name: string
  author_id: string
}[] = []

if (post) {
  const { results: updates } = await db
    .prepare(
      'SELECT id, content, created_at FROM post_updates WHERE post_id = ? ORDER BY created_at DESC, id DESC',
    )
    .bind(post.id)
    .all<{ id: number; content: string; created_at: string }>()
  updateRows = updates

  const { results: responses } = await db
    .prepare(
      `SELECT r.post_id, r.role_type, r.profile_token, r.created_at, p.author_name, p.author_id
			FROM responses r
			JOIN profiles p ON p.token = r.profile_token
			WHERE r.post_id = ?
			ORDER BY r.created_at ASC`,
    )
    .bind(post.id)
    .all<{
      post_id: number
      role_type: string
      profile_token: string
      created_at: string
      author_name: string
      author_id: string
    }>()
  responseRows = responses
}

const responsesByRole = new Map<string, typeof responseRows>()
for (const resp of responseRows) {
  const list = responsesByRole.get(resp.role_type) ?? []
  list.push(resp)
  responsesByRole.set(resp.role_type, list)
}
---

<script>
  const forms = document.querySelectorAll<HTMLFormElement>('[data-confirm]')
  forms.forEach(form => {
    form.addEventListener('submit', event => {
      const message = form.dataset.confirm
      if (!confirm(message)) {
        event.preventDefault()
      }
    })
  })
</script>

<Layout
  title={post ? `${post.title} · 边缘工会` : '需求不存在 · 边缘工会'}
  back
>
  <main class="detail-page">
    {
      post ? (
        <article class="post-detail">
          <div class="detail-record-line">
            <span>OPEN CALL / REQ-{String(post.id).padStart(2, '0')}</span>
            <span>{post.roles.filter(role => role.status === 'open').length} 个开放岗位</span>
          </div>

          <header class="detail-header">
            <p class="eyebrow">PROJECT REQUEST</p>
            <h1>{post.title}</h1>
            <div class="detail-meta">
              <AuthorAvatar
                seed={post.author_token}
                name={post.author_name}
                href={`/authors/${post.author_id}`}
                size={32}
              />
              <span class="meta-separator">/</span>
              <time>{formatDate(post.created_at)}</time>
            </div>
          </header>

          <div class="detail-columns">
            <div class="detail-main">
              {post.description && (
                <div class="detail-description">
                  <p>{post.description}</p>
                </div>
              )}

              {post.tags.length > 0 && (
                <div class="post-tags">
                  {post.tags.map(tag => (
                    <span class="tag tag-muted">{tagLabel(tag)}</span>
                  ))}
                </div>
              )}

              <section class="role-section">
                <div class="section-heading">
                  <div>
                    <p class="eyebrow">LOOKING FOR</p>
                    <h2>招揽需求</h2>
                  </div>
                  <span class="section-count">{post.roles.length} 个角色</span>
                </div>

                <div class="role-requirements">
                  {post.roles.map(role => {
                    const responses = responsesByRole.get(role.type) ?? []
                    const registered = responses.some(
                      r => r.profile_token === myProfileToken,
                    )
                    return (
                      <div class="role-requirement">
                        <div class="role-requirement-head">
                          <div class="role-title">
                            <span class="tag">{roleLabel(role.type)}</span>
                            <span class="role-count-label">
                              共需 {role.count} 人
                              {responses.length > 0
                                ? `，${responses.length} 人已认领`
                                : ''}
                            </span>
                          </div>
                          <span class={`status status-${role.status}`}>
                            {roleStatusLabel(role.status)}
                          </span>
                        </div>
                        <p>{role.description}</p>

                        {responses.length > 0 && (
                          <div class="response-area">
                            <span class="response-label">已加入</span>
                            <div class="response-avatars">
                              {responses.map(resp => (
                                <a class="author" href={`/authors/${resp.author_id}`}>
                                  <img
                                    class="author-avatar"
                                    src={avatarUrl(resp.profile_token, 30)}
                                    width={30}
                                    height={30}
                                    alt={`${resp.author_name} 的头像`}
                                    title={resp.author_name}
                                  />
                                </a>
                              ))}
                            </div>
                          </div>
                        )}

                        <div class="role-actions">
                          {isOwner ? (
                            <form method="POST" action={actions.updateRoleStatus}>
                              <input type="hidden" name="postId" value={post.id} />
                              <input type="hidden" name="roleType" value={role.type} />
                              <input
                                type="hidden"
                                name="status"
                                value={role.status === 'open' ? 'closed' : 'open'}
                              />
                              <button class="btn btn-ghost btn-sm" type="submit">
                                {role.status === 'open' ? '停止招募' : '重新开放'}
                              </button>
                            </form>
                          ) : role.status === 'open' ? (
                            !myProfileToken ? (
                              <a
                                class="btn btn-sm"
                                href={`/login?next=/posts/${post.id}`}
                              >
                                登录后认领
                              </a>
                            ) : registered ? (
                              <form method="POST" action={actions.cancelInterest}>
                                <input type="hidden" name="postId" value={post.id} />
                                <input
                                  type="hidden"
                                  name="roleType"
                                  value={role.type}
                                />
                                <button class="btn btn-ghost btn-sm" type="submit">
                                  取消认领
                                </button>
                              </form>
                            ) : (
                              <form method="POST" action={actions.registerInterest}>
                                <input type="hidden" name="postId" value={post.id} />
                                <input
                                  type="hidden"
                                  name="roleType"
                                  value={role.type}
                                />
                                <button class="btn btn-sm" type="submit">
                                  认领
                                </button>
                              </form>
                            )
                          ) : null}
                        </div>
                      </div>
                    )
                  })}
                </div>
              </section>

              <section class="post-updates">
                <div class="section-heading">
                  <div>
                    <p class="eyebrow">FIELD LOG</p>
                    <h2>项目更新</h2>
                  </div>
                  <span class="section-count">{updateRows.length} 条记录</span>
                </div>
                {updateRows.length > 0 ? (
                  <ul>
                    {updateRows.map(update => (
                      <li>
                        <p>{update.content}</p>
                        <time>{formatDate(update.created_at)}</time>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="field-note">还没有更新</p>
                )}
                {isOwner && (
                  <form class="update-form" method="POST" action={actions.addPostUpdate}>
                    <input type="hidden" name="postId" value={post.id} />
                    <textarea
                      name="content"
                      required
                      maxlength="1000"
                      placeholder="发布项目进展，例如：画师已加入，还在找开发者……"
                    />
                    <ErrorBox error={updateResult?.error} />
                    <button class="btn btn-sm" type="submit">发布更新</button>
                  </form>
                )}
              </section>

              <ErrorBox
                error={
                  roleStatusResult?.error ??
                  deleteResult?.error ??
                  interestResult?.error ??
                  cancelResult?.error
                }
              />
            </div>

            <aside class="detail-aside">
              <section class="contact-box">
                <strong>发布者联系方式</strong>
                {post.author_qq && <div>QQ：{post.author_qq}</div>}
                {post.author_github && <div>GitHub：{post.author_github}</div>}
                {post.author_steam && <div>Steam：{post.author_steam}</div>}
                {!post.author_qq && !post.author_github && !post.author_steam && (
                  <div>未填写</div>
                )}
              </section>

              <p class="aside-note">如果你对这个项目感兴趣，可以先认领一个开放岗位，再通过联系方式开始交流。</p>

              {isOwner && (
                <div class="post-owner-actions">
                  <a class="btn btn-ghost" href={`/posts/${post.id}/edit`}>编辑需求</a>
                  <form
                    method="POST"
                    action={actions.deletePost}
                    data-confirm="确定删除这条需求吗？删除后不可恢复。"
                  >
                    <input type="hidden" name="postId" value={post.id} />
                    <button class="btn btn-danger" type="submit">删除</button>
                  </form>
                </div>
              )}
            </aside>
          </div>
        </article>
      ) : (
        <p class="not-found">该需求不存在或已被删除</p>
      )
    }
  </main>
</Layout>

<style>
  .post-detail {
    max-width: 1080px;
    margin: 0 auto;
  }

  .detail-record-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 13px;
    border-bottom: 1px solid var(--border);
    color: var(--text-dim);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.09em;
  }

  .detail-header {
    padding: 40px 0 34px;
    border-bottom: 1px solid var(--border);
  }

  .detail-header h1 {
    max-width: 900px;
    margin: 0 0 24px;
    color: var(--forest);
    font-size: clamp(2.35rem, 5vw, 5.3rem);
    font-weight: 500;
    line-height: 1.02;
  }

  .detail-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .detail-meta .author {
    color: var(--text);
    font-weight: 700;
  }

  .detail-meta .author:hover {
    color: var(--accent-strong);
  }

  .meta-separator {
    color: var(--border-strong);
  }

  .detail-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(230px, 280px);
    gap: clamp(40px, 7vw, 92px);
    padding-top: 44px;
  }

  .detail-description {
    margin-bottom: 22px;
    padding: 22px 24px;
    border-left: 3px solid var(--accent);
    background: var(--detail-description-surface);
  }

  .detail-description p {
    margin: 0;
    white-space: pre-wrap;
    color: var(--text);
    font-size: 1rem;
    line-height: 1.85;
  }

  .role-section {
    margin-top: 40px;
  }

  .role-section .section-heading {
    margin-bottom: 16px;
  }

  .role-requirements {
    display: grid;
    gap: 12px;
  }

  .role-requirement {
    padding: 20px 22px;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    box-shadow: var(--shadow-small);
  }

  .role-requirement:has(.status-closed) {
    opacity: 0.68;
  }

  .role-requirement-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .role-title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
  }

  .role-requirement > p {
    margin: 15px 0 0;
    white-space: pre-wrap;
    color: var(--text);
    line-height: 1.7;
  }

  .response-area {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
    padding-top: 13px;
    border-top: 1px dashed var(--border);
  }

  .response-label {
    flex: 0 0 auto;
    color: var(--text-dim);
    font-size: 0.72rem;
  }

  .response-avatars {
    display: flex;
    align-items: center;
  }

  .response-avatars .author + .author {
    margin-left: -6px;
  }

  .response-avatars .author-avatar {
    border-color: var(--bg-raised);
  }

  .role-actions {
    margin-top: 16px;
  }

  .role-actions form {
    display: inline-flex;
  }

  .post-updates {
    margin-top: 54px;
  }

  .post-updates .section-heading {
    margin-bottom: 17px;
  }

  .update-form {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .update-form textarea {
    min-height: 130px;
    margin-bottom: 12px;
  }

  .detail-aside {
    position: sticky;
    top: 110px;
    align-self: start;
  }

  .aside-note {
    margin: 18px 0 0;
    color: var(--text-dim);
    font-size: 0.78rem;
    line-height: 1.7;
  }

  .post-owner-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .post-owner-actions form {
    display: inline-flex;
  }

  @media (max-width: 900px) {
    .detail-columns {
      grid-template-columns: minmax(0, 1fr) 230px;
      gap: 32px;
    }
  }

  @media (max-width: 720px) {
    .detail-record-line {
      align-items: flex-start;
      flex-direction: column;
      gap: 5px;
    }

    .detail-header {
      padding-top: 30px;
    }

    .detail-header h1 {
      font-size: clamp(2.25rem, 13vw, 4.5rem);
    }

    .detail-columns {
      display: flex;
      flex-direction: column;
      padding-top: 32px;
    }

    .detail-aside {
      position: static;
    }
  }

  @media (max-width: 460px) {
    .role-requirement {
      padding: 17px;
    }

    .role-requirement-head {
      align-items: flex-start;
      flex-direction: column;
    }

    .role-requirement-head .status {
      align-self: flex-start;
    }

    .response-area {
      align-items: flex-start;
      flex-direction: column;
      gap: 7px;
    }
  }
</style>
