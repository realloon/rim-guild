---
import Layout from '../../layouts/Layout.astro'
import { roleLabel, statusLabel, formatDate, type Post } from '../../lib/posts'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const { id } = Astro.params

const post = await db
	.prepare('SELECT * FROM posts WHERE id = ?')
	.bind(Number(id))
	.first<Post>()

if (!post) {
	Astro.response.status = 404
}
---

<Layout title={post ? `${post.title} · 边缘工会` : '需求不存在 · 边缘工会'}>
	<div class="container">
		<header class="site-header">
			<h1><a href="/">边缘工会</a></h1>
			<a class="btn" href="/posts/new">发布需求</a>
		</header>

		<main>
			{post ? (
				<article class="post-detail">
					<h1>{post.title}</h1>
					<div class="post-meta">
						<span class="tag">{roleLabel(post.role_type)}</span>
						<span>{statusLabel(post.status)}</span>
						<time>{formatDate(post.created_at)}</time>
					</div>
					<p class="description">{post.description}</p>
					<div class="contact-box">
						<strong>联系方式</strong>
						{post.contact}
					</div>
				</article>
			) : (
				<p class="not-found">该需求不存在或已被删除</p>
			)}
		</main>
	</div>
</Layout>
