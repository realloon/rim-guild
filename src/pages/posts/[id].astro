---
import Layout from '../../layouts/Layout.astro'
import AuthorAvatar from '../../components/AuthorAvatar.astro'
import { POST_SELECT, postFromRow, roleLabel, statusLabel, formatDate, type Post } from '../../lib/posts'
import { actions } from 'astro:actions'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const { id } = Astro.params

const row = await db
	.prepare(`${POST_SELECT} WHERE p.id = ? GROUP BY p.id`)
	.bind(Number(id))
	.first()

const post: Post | undefined = row ? postFromRow(row) : undefined

if (!post) {
	Astro.response.status = 404
}

const isOwner = !!post && Astro.locals.auth?.profileToken === post.author_token

const statusResult = Astro.getActionResult(actions.updatePostStatus)
if (statusResult && !statusResult.error && post) {
	return Astro.redirect(`/posts/${post.id}`)
}
const deleteResult = Astro.getActionResult(actions.deletePost)
if (deleteResult && !deleteResult.error) {
	return Astro.redirect('/me')
}
---

<Layout title={post ? `${post.title} · 边缘工会` : '需求不存在 · 边缘工会'} back>
	<main>
			{post ? (
				<article class="post-detail">
					<h1>{post.title}</h1>
					<div class="post-meta">
						<span class="tags">
							{post.roles.map((role) => <span class="tag">{roleLabel(role.type)}</span>)}
						</span>
						<span class="meta-side">
							<AuthorAvatar seed={post.author_token} name={post.author_name} href={`/authors/${post.author_id}`} size={28} />
							<span class={`status status-${post.status}`}>{statusLabel(post.status)}</span>
							<time>{formatDate(post.created_at)}</time>
						</span>
					</div>
					{post.description && <p class="description">{post.description}</p>}
					<div class="role-requirements">
						{post.roles.map((role) => (
							<div class="role-requirement">
								<span class="tag">{roleLabel(role.type)}</span>
								<p>{role.description}</p>
							</div>
						))}
					</div>
					<div class="contact-box">
						<strong>联系方式</strong>
						{post.contact}
					</div>

					{isOwner && (
						<div class="post-owner-actions">
							<a class="btn btn-ghost" href={`/posts/${post.id}/edit`}>编辑</a>
							<form method="POST" action={actions.updatePostStatus}>
								<input type="hidden" name="postId" value={post.id} />
								<input type="hidden" name="status" value={post.status === 'open' ? 'closed' : 'open'} />
								<button class="btn btn-ghost" type="submit">
									{post.status === 'open' ? '关闭需求' : '重新开放'}
								</button>
							</form>
							<form method="POST" action={actions.deletePost} data-confirm="确定删除这条需求吗？删除后不可恢复。">
								<input type="hidden" name="postId" value={post.id} />
								<button class="btn btn-danger" type="submit">删除</button>
							</form>
						</div>
					)}

					{(statusResult?.error || deleteResult?.error) && (
						<div class="error">
							{(statusResult?.error?.message ?? deleteResult?.error?.message) && (
								<p>{statusResult?.error?.message ?? deleteResult?.error?.message}</p>
							)}
						</div>
					)}
				</article>
			) : (
				<p class="not-found">该需求不存在或已被删除</p>
			)}
		</main>
</Layout>

<script>
	const forms = document.querySelectorAll('[data-confirm]')
	forms.forEach((form) => {
		form.addEventListener('submit', (event) => {
			const message = (form as HTMLElement).dataset.confirm
			if (!confirm(message)) {
				event.preventDefault()
			}
		})
	})
</script>
