---
import Layout from '../../layouts/Layout.astro'
import AuthorAvatar from '../../components/AuthorAvatar.astro'
import { POST_SELECT, postFromRow, roleLabel, statusLabel, formatDate, type Post } from '../../lib/posts'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const { id } = Astro.params

const row = await db
	.prepare(`${POST_SELECT} WHERE p.id = ? GROUP BY p.id`)
	.bind(Number(id))
	.first()

const post: Post | undefined = row ? postFromRow(row) : undefined

if (!post) {
	Astro.response.status = 404
}
---

<Layout title={post ? `${post.title} · 边缘工会` : '需求不存在 · 边缘工会'}>
	<div class="container">
		<header class="site-header">
			<h1><a href="/">边缘工会</a></h1>
			<a class="btn" href="/posts/new">发布需求</a>
		</header>

		<nav class="quick-nav">
			<a href="/">返回列表</a>
			<a href="/me">我的主页</a>
		</nav>

		<main>
			{post ? (
				<article class="post-detail">
					<h1>{post.title}</h1>
					<div class="post-meta">
						<span class="tags">
							{post.roles.map((role) => <span class="tag">{roleLabel(role.type)}</span>)}
						</span>
						<span class="meta-side">
							<AuthorAvatar seed={post.author_token} name={post.author_name} href={`/authors/${post.author_id}`} size={28} />
							<span>{statusLabel(post.status)}</span>
							<time>{formatDate(post.created_at)}</time>
						</span>
					</div>
					{post.description && <p class="description">{post.description}</p>}
					<div class="role-requirements">
						{post.roles.map((role) => (
							<div class="role-requirement">
								<span class="tag">{roleLabel(role.type)}</span>
								<p>{role.description}</p>
							</div>
						))}
					</div>
					<div class="contact-box">
						<strong>联系方式</strong>
						{post.contact}
					</div>
				</article>
			) : (
				<p class="not-found">该需求不存在或已被删除</p>
			)}
		</main>
	</div>
</Layout>
