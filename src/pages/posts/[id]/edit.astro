---
import Layout from '../../../layouts/Layout.astro'
import PostForm from '../../../components/PostForm.astro'
import { AUTHOR_COOKIE, POST_SELECT, postFromRow, type Post } from '../../../lib/posts'
import { actions } from 'astro:actions'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const { id } = Astro.params

const row = await db
	.prepare(`${POST_SELECT} WHERE p.id = ? GROUP BY p.id`)
	.bind(Number(id))
	.first()

const post: Post | undefined = row ? postFromRow(row) : undefined
const isOwner = post && Astro.cookies.get(AUTHOR_COOKIE)?.value === post.author_token

if (!post) {
	Astro.response.status = 404
} else if (!isOwner) {
	Astro.response.status = 403
}

const result = Astro.getActionResult(actions.updatePost)
if (result && !result.error && post) {
	return Astro.redirect(`/posts/${post.id}`)
}
---

<Layout title={post ? `编辑 ${post.title} · 边缘工会` : '需求不存在 · 边缘工会'} back>
	<main>
		{post ? (
			isOwner ? (
				<>
					<h2>编辑项目需求</h2>
					<PostForm post={post} />

					{result?.error && (
						<div class="error">
							{result.error.message && <p>{result.error.message}</p>}
							{result.error.issues?.map((issue) => <p>{issue.message}</p>)}
						</div>
					)}
				</>
			) : (
				<p class="not-found">你没有权限编辑这条需求</p>
			)
		) : (
			<p class="not-found">该需求不存在或已被删除</p>
		)}
	</main>
</Layout>
