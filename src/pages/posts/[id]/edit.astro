---
import Layout from '../../../layouts/Layout.astro'
import PostForm from '../../../components/PostForm.astro'
import ErrorBox from '../../../components/ui/ErrorBox.astro'
import {
  POST_SELECT,
  postFromRow,
  type Post,
  type PostRow,
} from '../../../lib/posts'
import { actions } from 'astro:actions'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const { id } = Astro.params

const row = await db
  .prepare(`${POST_SELECT} WHERE p.id = ? GROUP BY p.id`)
  .bind(Number(id))
  .first<PostRow>()

const post: Post | undefined = row ? postFromRow(row) : undefined
const isOwner = !!post && Astro.locals.auth?.profileToken === post.author_token

if (!post) {
  Astro.response.status = 404
} else if (!isOwner) {
  Astro.response.status = 403
}

const result = Astro.getActionResult(actions.updatePost)
if (result && !result.error && post) {
  return Astro.redirect(`/posts/${post.id}`)
}
---

<Layout
  title={post ? `编辑 ${post.title} · 边缘工会` : '需求不存在 · 边缘工会'}
  back
>
  <main>
    {
      post ? (
        isOwner ? (
          <>
            <div class="page-heading">
              <div>
                <h1>编辑项目需求</h1>
                <p>更新项目说明、招揽角色或人数，让所有正在关注这条需求的人看到最新状态。</p>
              </div>
            </div>

            <section class="editor-card">
              <PostForm post={post} />
              <ErrorBox error={result?.error} />
            </section>
          </>
        ) : (
          <p class="not-found">你没有权限编辑这条需求</p>
        )
      ) : (
        <p class="not-found">该需求不存在或已被删除</p>
      )
    }
  </main>
</Layout>

<style>
  .editor-card {
    padding: clamp(22px, 5vw, 46px);
    border: 1px solid var(--border);
    border-top: 3px solid var(--forest);
    background: var(--bg-raised);
    box-shadow: var(--shadow);
  }
</style>
