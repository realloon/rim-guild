---
import Layout from '../layouts/Layout.astro'
import Button from '../components/ui/Button.astro'
import CommissionList from '../components/CommissionList.astro'
import ProfileCard from '../components/ProfileCard.astro'
import Section from '../components/Section.astro'
import ErrorBox from '../components/ui/ErrorBox.astro'
import CheckboxGroup from '../components/ui/CheckboxGroup.astro'
import Control from '../components/ui/Control.astro'
import Field from '../components/ui/Field.astro'
import {
  REQUIREMENT_TYPES,
  listClaimedCommissions,
  listCommissionsByAuthor,
} from '../lib/commissions'
import { findProfileByToken } from '../lib/profiles'
import { actions } from 'astro:actions'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const profileToken = Astro.locals.auth?.profileToken

if (!profileToken) {
  return Astro.redirect('/login?next=/me')
}

const profile = await findProfileByToken(db, profileToken)

if (!profile) {
  throw new Error('登录会话对应的个人资料不存在')
}

const {
  author_name: nickname,
  qq: myQq,
  github: myGithub,
  steam: mySteam,
  email: loggedEmail,
  creator_types: myCreatorTypes,
} = profile

const commissions = await listCommissionsByAuthor(db, profileToken)

const claimedCommissions = await listClaimedCommissions(db, profileToken)

const result = Astro.getActionResult(actions.updateProfile)
if (result && !result.error) {
  return Astro.redirect('/me')
}
---

<Layout title="我的主页 · 边缘工会">
  <main>
    <aside>
      <nav aria-label="个人主页索引">
        <a href="#profile">
          <span>01</span>
          个人资料
        </a>
        <a href="#commissions">
          <span>02</span>
          我的委托
        </a>
        <a href="#claims">
          <span>03</span>
          我认领的
        </a>
      </nav>
    </aside>

    <div>
      <ProfileCard
        id="profile"
        seed={profileToken}
        name={nickname}
        subtitle={loggedEmail}
      >
        <form method="POST" action={actions.updateProfile}>
          <Field label="昵称" for="authorName">
            <Control
              as="input"
              id="authorName"
              name="authorName"
              required
              maxlength="30"
              value={nickname}
              placeholder="为自己取一个昵称"
            />
          </Field>
          <CheckboxGroup
            legend="创作者身份"
            name="creatorTypes"
            options={REQUIREMENT_TYPES}
            checked={myCreatorTypes}
          />
          <fieldset class="social-contacts">
            <legend>联系方式</legend>
            <div>
              <Field label="QQ" for="qq">
                <Control
                  as="input"
                  id="qq"
                  name="qq"
                  maxlength="50"
                  value={myQq}
                  placeholder="选填"
                />
              </Field>
              <Field label="GitHub" for="github">
                <Control
                  as="input"
                  id="github"
                  name="github"
                  maxlength="100"
                  value={myGithub}
                  placeholder="选填"
                />
              </Field>
              <Field label="Steam" for="steam">
                <Control
                  as="input"
                  id="steam"
                  name="steam"
                  maxlength="100"
                  value={mySteam}
                  placeholder="选填"
                />
              </Field>
            </div>
          </fieldset>

          <ErrorBox error={result?.error} />

          <Button type="submit">保存资料</Button>
        </form>
      </ProfileCard>

      <Section
        id="commissions"
        title="我的委托"
        meta={`${commissions.length}条记录`}
      >
        <CommissionList
          commissions={commissions}
          emptyMessage="还没有发布委托"
        />
      </Section>

      <Section
        id="claims"
        title="我认领的"
        meta={`${claimedCommissions.length}条记录`}
      >
        <CommissionList
          commissions={claimedCommissions}
          emptyMessage="还没有认领需求"
        />
      </Section>
    </div>
  </main>
</Layout>

<style>
  main {
    display: flex;
    flex-direction: row;
    align-items: start;
    gap: 48px;
  }

  main > div {
    flex-grow: 1;

    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  aside {
    position: sticky;
    top: 136px;

    nav {
      display: flex;
      flex-direction: column;

      a {
        display: flex;
        align-items: center;
        gap: 1em;

        color: var(--text-muted);
        font-size: 0.875rem;
        text-wrap-mode: nowrap;

        padding-inline: 1em 2em;
        padding-block: 12px;
        border-left: 1px solid var(--line-muted);

        transition: 0.2s;

        span {
          color: var(--accent);
          font-family: var(--mono);
          font-size: 0.75rem;
          font-weight: bolder;
        }

        &:hover {
          border-color: var(--accent);
          background-color: color-mix(
            in oklch,
            var(--accent) 22%,
            light-dark(white, black)
          );
          color: var(--accent-strong);
        }
      }
    }

    @media (max-width: 768px) {
      display: none;
    }
  }

  section[id] {
    scroll-margin-top: 80px;

    &:first-of-type {
      scroll-margin-top: 136px;
    }
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 16px;

    padding-top: 24px;

    .social-contacts {
      padding: unset;
      border: unset;
      margin-inline: unset;
      background: transparent;

      legend {
        font-size: 0.75rem;
        font-weight: bold;

        padding-inline: unset;
        margin-bottom: 1rem;

        color: var(--text-muted);
      }

      div {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
    }

    button[type='submit'] {
      align-self: start;
    }
  }
</style>
