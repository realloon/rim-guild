---
import Layout from '../layouts/Layout.astro'
import PostListItem from '../components/PostListItem.astro'
import ErrorBox from '../components/ui/ErrorBox.astro'
import CheckboxGroup from '../components/ui/CheckboxGroup.astro'
import {
  POST_SELECT,
  ROLE_TYPES,
  postFromRow,
  roleLabel,
  roleStatusLabel,
  formatDate,
  type Post,
  type PostRow,
  type RoleType,
} from '../lib/posts'
import { avatarUrl } from '../lib/avatar'
import { actions } from 'astro:actions'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const profileToken = Astro.locals.auth?.profileToken

if (!profileToken) {
  return Astro.redirect('/login?next=/me')
}

const profile = await db
  .prepare(
    'SELECT author_name, qq, github, steam, roles, email FROM profiles WHERE token = ?',
  )
  .bind(profileToken)
  .first<{
    author_name: string
    qq: string
    github: string
    steam: string
    roles: string
    email: string
  }>()

const nickname = profile?.author_name ?? ''
const myQq = profile?.qq ?? ''
const myGithub = profile?.github ?? ''
const mySteam = profile?.steam ?? ''
const loggedEmail = profile?.email ?? ''
const myRoles = profile?.roles
  ? (profile.roles.split(',').filter(Boolean) as RoleType[])
  : []

const { results } = await db
  .prepare(
    `${POST_SELECT}
		WHERE p.author_token = ?
		GROUP BY p.id
		ORDER BY p.created_at DESC, p.id DESC`,
  )
  .bind(profileToken)
  .all<PostRow>()
const posts: Post[] = results.map(postFromRow)

const { results: claimedRows } = await db
  .prepare(
    `SELECT p.id AS post_id, p.title AS post_title, p.author_name, r.role_type, r.created_at,
			pr.status AS role_status, pr.count, pr.description
		FROM responses r
		JOIN posts p ON p.id = r.post_id
		LEFT JOIN post_roles pr ON pr.post_id = r.post_id AND pr.role_type = r.role_type
		WHERE r.profile_token = ?
		ORDER BY r.created_at DESC`,
  )
  .bind(profileToken)
  .all<{
    post_id: number
    post_title: string
    author_name: string
    role_type: string
    created_at: string
    role_status: string
    count: number
    description: string
  }>()

const result = Astro.getActionResult(actions.updateProfile)
if (result && !result.error) {
  return Astro.redirect('/me')
}
---

<Layout title="我的主页 · 边缘工会">
  <main class="profile-page">
    <section class="profile-card">
      <div class="profile-hero">
        <div class="profile-identity">
          <img
            class="author-avatar"
            src={avatarUrl(profileToken, 72)}
            width={72}
            height={72}
            alt="我的头像"
          />
          <div>
            <p class="eyebrow">YOUR GUILD PROFILE</p>
            <h1>{nickname}</h1>
            <span class="profile-email" title="已登录账号">{loggedEmail}</span>
          </div>
        </div>
        <span class="profile-badge">MEMBER / ACTIVE</span>
      </div>

      <form class="profile-form" method="POST" action={actions.updateProfile}>
        <label class="form-field" for="authorName">
          昵称
          <input
            id="authorName"
            name="authorName"
            required
            maxlength="30"
            value={nickname}
            placeholder="例如：阿哲"
          />
        </label>
        <CheckboxGroup
          legend="我的身份（可多选）"
          name="roles"
          options={ROLE_TYPES}
          checked={myRoles}
        />
        <fieldset class="form-section">
          <legend>联系方式</legend>
          <div class="contact-fields">
            <label class="form-field" for="qq">
              QQ 号
              <input
                id="qq"
                name="qq"
                maxlength="50"
                value={myQq}
                placeholder="选填"
              />
            </label>
            <label class="form-field" for="github">
              GitHub 账号
              <input
                id="github"
                name="github"
                maxlength="100"
                value={myGithub}
                placeholder="选填"
              />
            </label>
            <label class="form-field" for="steam">
              Steam 账号
              <input
                id="steam"
                name="steam"
                maxlength="100"
                value={mySteam}
                placeholder="选填"
              />
            </label>
          </div>
        </fieldset>

        <ErrorBox error={result?.error} />

        <button class="btn" type="submit">保存资料</button>
      </form>
    </section>

    <section class="profile-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">MY OPEN CALLS</p>
          <h2>我的需求</h2>
        </div>
        <span class="section-count">{posts.length} 条记录</span>
      </div>
      {
        posts.length > 0 ? (
          <ul class="post-list">
            {posts.map(post => (
              <PostListItem post={post} />
            ))}
          </ul>
        ) : (
          <p class="empty">你还没有发布过需求</p>
        )
      }
    </section>

    <section class="profile-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">MY CLAIMS</p>
          <h2>我的认领</h2>
        </div>
        <span class="section-count">{claimedRows.length} 条记录</span>
      </div>
      {
        claimedRows.length > 0 ? (
          <ul class="post-list claim-list">
            {claimedRows.map(claim => (
              <li>
                <a class="post-card-link" href={`/posts/${claim.post_id}`}>
                  <div class="post-card-top">
                    <span class="post-card-type">
                      <span class={`claim-dot claim-${claim.role_status}`}></span>
                      我的认领
                    </span>
                    <span class={`status status-${claim.role_status}`}>
                      {roleStatusLabel(claim.role_status as 'open' | 'closed')}
                    </span>
                  </div>
                  <h2>{claim.post_title}</h2>
                  {claim.description && (
                    <p class="post-excerpt">{claim.description}</p>
                  )}
                </a>
                <div class="post-card-footer">
                  <span class="tags">
                    <span class="tag">
                      {roleLabel(claim.role_type as RoleType)}
                    </span>
                  </span>
                  <span class="meta-side">
                    <span class="author-name">{claim.author_name}</span>
                    <time>{formatDate(claim.created_at)}</time>
                  </span>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">你还没有认领过需求</p>
        )
      }
    </section>
  </main>
</Layout>

<style>
  .contact-fields {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .contact-fields .form-field {
    margin-bottom: 0;
  }

  .claim-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-dim);
  }

  .claim-open {
    background: var(--success);
    box-shadow: 0 0 0 3px var(--forest-soft);
  }

  .claim-closed {
    background: var(--border-strong);
  }

  .author-name {
    color: var(--text-dim);
    font-size: 0.8rem;
  }

  @media (max-width: 720px) {
    .contact-fields {
      grid-template-columns: 1fr;
    }
  }
</style>
