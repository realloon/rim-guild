---
import Layout from '../layouts/Layout.astro'
import CommissionListItem from '../components/CommissionListItem.astro'
import ErrorBox from '../components/ui/ErrorBox.astro'
import CheckboxGroup from '../components/ui/CheckboxGroup.astro'
import {
  COMMISSION_SELECT,
  CREATOR_TYPES,
  commissionFromRow,
  type Commission,
  type CommissionRow,
  type RequirementType,
} from '../lib/commissions'
import { avatarUrl } from '../lib/avatar'
import { actions } from 'astro:actions'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const profileToken = Astro.locals.auth?.profileToken

if (!profileToken) {
  return Astro.redirect('/login?next=/me')
}

const profile = await db
  .prepare(
    'SELECT author_name, qq, github, steam, creator_types, email FROM profiles WHERE token = ?',
  )
  .bind(profileToken)
  .first<{
    author_name: string
    qq: string
    github: string
    steam: string
    creator_types: string
    email: string
  }>()

const nickname = profile?.author_name ?? ''
const myQq = profile?.qq ?? ''
const myGithub = profile?.github ?? ''
const mySteam = profile?.steam ?? ''
const loggedEmail = profile?.email ?? ''
const myCreatorTypes = profile?.creator_types
  ? (profile.creator_types.split(',').filter(Boolean) as RequirementType[])
  : []

const { results } = await db
  .prepare(
    `${COMMISSION_SELECT}
		WHERE c.author_token = ?
		GROUP BY c.id
		ORDER BY c.created_at DESC, c.id DESC`,
  )
  .bind(profileToken)
  .all<CommissionRow>()
const commissions: Commission[] = results.map(commissionFromRow)

const { results: claimedRows } = await db
  .prepare(
    `SELECT c.id AS commission_id, c.title AS commission_title, c.author_name, c.author_token, c.author_id, c.created_at,
			cr.status AS requirement_status, cr.count, cr.description, r.requirement_type
		FROM claims r
		JOIN commissions c ON c.id = r.commission_id
		LEFT JOIN requirements cr ON cr.commission_id = r.commission_id AND cr.requirement_type = r.requirement_type
		WHERE r.profile_token = ?
		ORDER BY r.created_at DESC`,
  )
  .bind(profileToken)
  .all<{
    commission_id: number
    commission_title: string
    author_name: string
    author_token: string
    author_id: string
    requirement_type: string
    created_at: string
    requirement_status: string
    count: number
    description: string
  }>()

const claimedCommissions: Commission[] = claimedRows.map(claim => ({
  id: claim.commission_id,
  title: claim.commission_title,
  description: claim.description,
  tags: [],
  requirements: [
    {
      type: claim.requirement_type as RequirementType,
      description: claim.description,
      count: claim.count,
      status: claim.requirement_status as 'open' | 'closed',
    },
  ],
  author_name: claim.author_name,
  author_token: claim.author_token,
  author_id: claim.author_id,
  author_qq: '',
  author_github: '',
  author_steam: '',
  created_at: claim.created_at,
}))

const result = Astro.getActionResult(actions.updateProfile)
if (result && !result.error) {
  return Astro.redirect('/me')
}
---

<Layout title="我的主页 · 边缘工会">
  <main>
    <div class="profile-layout">
      <aside class="profile-index">
        <nav aria-label="个人主页索引">
          <a href="#profile">
            <span>01</span>
            个人资料
          </a>
          <a href="#commissions">
            <span>02</span>
            我的委托
          </a>
          <a href="#claims">
            <span>03</span>
            我认领的
          </a>
        </nav>
      </aside>

      <div class="profile-content">
        <section class="profile-card" id="profile">
          <div class="profile-hero">
            <div class="profile-identity">
              <img
                class="author-avatar"
                src={avatarUrl(profileToken, 72)}
                width={72}
                height={72}
                alt=""
              />
              <div>
                <h1>{nickname}</h1>
                <span class="profile-email" title="已登录账号"
                  >{loggedEmail}</span
                >
              </div>
            </div>
            <span class="profile-badge">注册会员</span>
          </div>

          <form
            class="profile-form"
            method="POST"
            action={actions.updateProfile}
          >
            <label class="form-field" for="authorName">
              昵称
              <input
                id="authorName"
                name="authorName"
                required
                maxlength="30"
                value={nickname}
                placeholder="例如：阿哲"
              />
            </label>
            <CheckboxGroup
              legend="创作者身份"
              name="creatorTypes"
              options={CREATOR_TYPES}
              checked={myCreatorTypes}
            />
            <fieldset class="form-section">
              <legend>联系方式</legend>
              <div class="contact-fields">
                <label class="form-field" for="qq">
                  QQ
                  <input
                    id="qq"
                    name="qq"
                    maxlength="50"
                    value={myQq}
                    placeholder="选填"
                  />
                </label>
                <label class="form-field" for="github">
                  GitHub
                  <input
                    id="github"
                    name="github"
                    maxlength="100"
                    value={myGithub}
                    placeholder="选填"
                  />
                </label>
                <label class="form-field" for="steam">
                  Steam
                  <input
                    id="steam"
                    name="steam"
                    maxlength="100"
                    value={mySteam}
                    placeholder="选填"
                  />
                </label>
              </div>
            </fieldset>

            <ErrorBox error={result?.error} />

            <button class="btn" type="submit">保存资料</button>
          </form>
        </section>

        <section class="profile-section" id="commissions">
          <div class="section-heading">
            <h2>我的委托</h2>
            <span class="section-count">{commissions.length}条记录</span>
          </div>
          {
            commissions.length > 0 ? (
              <ul class="commission-list">
                {commissions.map(commission => (
                  <CommissionListItem commission={commission} />
                ))}
              </ul>
            ) : (
              <p class="empty">还没有发布委托</p>
            )
          }
        </section>

        <section class="profile-section" id="claims">
          <div class="section-heading">
            <h2>我认领的</h2>
            <span class="section-count">{claimedRows.length}条记录</span>
          </div>
          {
            claimedCommissions.length > 0 ? (
              <ul class="commission-list">
                {claimedCommissions.map(commission => (
                  <CommissionListItem commission={commission} />
                ))}
              </ul>
            ) : (
              <p class="empty">还没有认领需求</p>
            )
          }
        </section>
      </div>
    </div>
  </main>
</Layout>

<style>
  .profile-layout {
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr);
    gap: clamp(32px, 6vw, 84px);
    align-items: start;
  }

  .profile-index {
    position: sticky;
    top: calc(var(--site-header-height) + var(--main-padding-top));
    align-self: start;
  }

  .profile-index nav {
    display: grid;
    gap: 0;
    border-left: 1px solid
      color-mix(in oklch, var(--line) 50%, var(--text-muted));
  }

  .profile-index a {
    display: grid;
    grid-template-columns: 27px 1fr;
    gap: 8px;
    padding: 9px 10px 9px 12px;
    border-left: 2px solid transparent;
    color: var(--text-muted);
    font-size: 0.8rem;
    text-decoration: none;
    transition: 0.2s;
  }

  .profile-index a span {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.63rem;
    font-weight: 700;
  }

  .profile-index a:hover {
    border-color: var(--accent);
    background: color-mix(
      in oklch,
      var(--accent) 22%,
      light-dark(white, black)
    );
    color: color-mix(in oklch, var(--accent) 78%, light-dark(black, white));
  }

  .profile-content > :is(.profile-card, .profile-section) {
    scroll-margin-top: calc(
      var(--site-header-height) + var(--main-padding-top)
    );
  }

  .contact-fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .profile-form .form-section {
    padding: 0;
    border: 0;
    background: transparent;
  }

  .profile-form .form-section legend {
    margin-bottom: 18px;
  }

  .contact-fields .form-field {
    margin-bottom: 0;
  }

  @media (max-width: 720px) {
    .profile-layout {
      display: block;
    }

    .profile-index {
      display: none;
    }
  }
</style>
