---
import Layout from '../layouts/Layout.astro'
import ErrorBox from '../components/ui/ErrorBox.astro'
import { actions } from 'astro:actions'

const next = Astro.url.searchParams.get('next')
const redirectTo =
  next && next.startsWith('/') && !next.startsWith('//') ? next : '/me'

const mode =
  Astro.url.searchParams.get('mode') === 'register' ? 'register' : 'login'
const action = mode === 'register' ? actions.register : actions.login

const loginResult = Astro.getActionResult(actions.login)
const registerResult = Astro.getActionResult(actions.register)

if (
  (loginResult && !loginResult.error) ||
  (registerResult && !registerResult.error)
) {
  return Astro.redirect(redirectTo)
}

const result = mode === 'register' ? registerResult : loginResult
---

<Layout title={mode === 'register' ? '注册 · 边缘工会' : '登录 · 边缘工会'}>
  <main class="auth-page">
    <section class="auth-intro">
      <div class="auth-symbol" aria-hidden="true">
        <svg viewBox="0 0 120 120" fill="none">
          <rect x="14" y="14" width="92" height="92" stroke="currentColor" />
          <path d="M31 39h58M31 60h37M31 81h58" stroke="currentColor" stroke-width="2" />
          <path d="m78 52 11 8-11 8" stroke="var(--accent)" stroke-width="3" stroke-linecap="square" />
        </svg>
      </div>
      <h1>进入协作现场。</h1>
      <p>
        用一个账号管理你发布的委托，也让合作者知道该从哪里找到你。
      </p>
      <div class="auth-principles">
        <div><span>01</span><strong>发布</strong><small>说清楚你正在做什么</small></div>
        <div><span>02</span><strong>匹配</strong><small>找到能补上缺口的人</small></div>
      </div>
    </section>

    <section class="auth-card">
      <h2>{mode === 'register' ? '注册账号' : '登录'}</h2>
      <p class="auth-note">
        {mode === 'register'
          ? '创建账号后，你可以发布委托、认领需求并维护个人资料。'
          : '登录后继续管理你的委托和协作记录。'}
      </p>

      <form method="POST" action={action}>
        <label class="form-field" for="email">
          邮箱
          <input
            id="email"
            name="email"
            type="email"
            required
            maxlength="200"
            placeholder="you@example.com"
          />
        </label>
        <label class="form-field" for="password">
          密码
          <input
            id="password"
            name="password"
            type="password"
            required
            minlength={mode === 'register' ? 8 : undefined}
            placeholder={mode === 'register' ? '至少 8 位' : undefined}
          />
        </label>

        <ErrorBox error={result?.error} />

        <button class="btn btn-primary btn-block" type="submit">
          {mode === 'register' ? '注册' : '登录'}
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" />
          </svg>
        </button>
      </form>

      <p class="auth-switch">
        {
          mode === 'register' ? (
            <>
              已有账号？
              <a href={`/login?next=${encodeURIComponent(redirectTo)}`}>去登录</a>
            </>
          ) : (
            <>
              没有账号？
              <a
                href={`/login?mode=register&next=${encodeURIComponent(redirectTo)}`}
              >去注册</a>
            </>
          )
        }
      </p>
    </section>
  </main>
</Layout>

<style>
  .auth-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 460px);
    gap: clamp(50px, 10vw, 150px);
    align-items: center;
    max-width: 1000px;
    min-height: calc(100vh - 200px);
    padding-top: 40px;
  }

  .auth-intro h1 {
    max-width: 520px;
    margin: 0 0 22px;
    color: var(--forest);
    font-size: clamp(2.6rem, 6vw, 5.4rem);
    font-weight: 500;
    line-height: 0.98;
  }

  .auth-intro > p {
    max-width: 420px;
    margin-bottom: 30px;
    color: var(--text-dim);
  }

  .auth-symbol {
    width: 130px;
    margin: 0 0 30px;
    color: var(--forest);
  }

  .auth-symbol svg {
    width: 100%;
    height: auto;
  }

  .auth-principles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 440px;
    border-top: 1px solid var(--border);
  }

  .auth-principles > div {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 0 8px;
    padding: 14px 12px 0 0;
  }

  .auth-principles > div + div {
    padding-left: 14px;
    border-left: 1px solid var(--border);
  }

  .auth-principles span {
    grid-row: span 2;
    color: var(--accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    font-weight: 700;
  }

  .auth-principles strong {
    color: var(--forest);
    font-family: Georgia, "Noto Serif SC", "Source Han Serif SC", serif;
    font-size: 1rem;
  }

  .auth-principles small {
    color: var(--text-dim);
    font-size: 0.72rem;
  }

  .auth-card {
    padding: clamp(24px, 5vw, 42px);
    border: 1px solid var(--border-strong);
    border-top: 4px solid var(--accent);
    background: var(--bg-raised);
    box-shadow: var(--shadow);
  }

  .auth-card h2 {
    margin: 0;
    color: var(--forest);
    font-size: 2rem;
    font-weight: 500;
  }

  .auth-note {
    margin: 14px 0 28px;
    color: var(--text-dim);
    font-size: 0.87rem;
  }

  .auth-card .btn svg {
    width: 15px;
    height: 15px;
  }

  .auth-switch {
    margin: 24px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.83rem;
    text-align: center;
  }

  .auth-switch a {
    color: var(--accent-strong);
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .auth-page {
      display: block;
      min-height: auto;
      padding-top: 24px;
    }

    .auth-intro {
      margin-bottom: 40px;
    }

    .auth-symbol {
      width: 92px;
      margin-bottom: 22px;
    }

    .auth-intro h1 {
      font-size: clamp(2.8rem, 14vw, 5rem);
    }
  }
</style>
