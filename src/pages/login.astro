---
import { actions } from 'astro:actions'
import { env } from 'cloudflare:workers'
import { getSiteStats } from '../lib/site'
import Layout from '../layouts/Layout.astro'
import Button from '../components/ui/Button.astro'
import SiteStats from '../components/SiteStats.astro'
import ErrorBox from '../components/ui/ErrorBox.astro'
import Control from '../components/ui/Control.astro'
import Field from '../components/ui/Field.astro'

const db = env.rim_guild_db
const { commissionCount, registeredUserCount } = await getSiteStats(db)

const next = Astro.url.searchParams.get('next')
const redirectTo =
  next && next.startsWith('/') && !next.startsWith('//') ? next : '/me'

const mode =
  Astro.url.searchParams.get('mode') === 'register' ? 'register' : 'login'
const action = mode === 'register' ? actions.register : actions.login

const loginResult = Astro.getActionResult(actions.login)
const registerResult = Astro.getActionResult(actions.register)

if (
  (loginResult && !loginResult.error) ||
  (registerResult && !registerResult.error)
) {
  return Astro.redirect(redirectTo)
}

const result = mode === 'register' ? registerResult : loginResult
---

<Layout title={mode === 'register' ? '注册 · 边缘工会' : '登录 · 边缘工会'}>
  <main>
    <header>
      <h1>
        <span>加入</span>
        <span>边缘工会</span>
      </h1>
      <p>成为工会会员，发布的委托，招揽合作者，或寻找合适你的委托。</p>
      <SiteStats
        variant="inline"
        registeredUserCount={registeredUserCount}
        commissionCount={commissionCount}
      />
    </header>

    <section>
      <h2>{mode === 'register' ? '注册账号' : '登录'}</h2>
      <p>
        {
          mode === 'register'
            ? '注册后，你可以发布委托、认领需求并维护个人资料'
            : '登录后继续管理你的委托和协作记录'
        }
      </p>

      <form method="POST" action={action}>
        <Field for="email">
          邮箱
          <Control
            as="input"
            id="email"
            name="email"
            type="email"
            required
            maxlength="200"
            placeholder="you@example.com"
          />
        </Field>
        <Field for="password">
          密码
          <Control
            as="input"
            id="password"
            name="password"
            type="password"
            required
            minlength={mode === 'register' ? 8 : undefined}
            placeholder={mode === 'register' ? '至少8位' : undefined}
          />
        </Field>

        <ErrorBox error={result?.error} />

        <Button variant="primary" block type="submit">
          {mode === 'register' ? '注册' : '登录'}
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 8h10m-4-4 4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="square"
              stroke-linejoin="miter"></path>
          </svg>
        </Button>
      </form>

      <p>
        {
          mode === 'register' ? (
            <>
              已有账号？
              <a href={`/login?next=${encodeURIComponent(redirectTo)}`}>
                去登录
              </a>
            </>
          ) : (
            <>
              没有账号？
              <a
                href={`/login?mode=register&next=${encodeURIComponent(redirectTo)}`}
              >
                去注册
              </a>
            </>
          )
        }
      </p>
    </section>
  </main>
</Layout>

<style>
  main {
    display: flex;
    align-items: center;
    flex-direction: row;
    gap: 40px 16px;

    @media (max-width: 768px) {
      flex-direction: column;
    }
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 16px;

    h1 {
      color: var(--forest);
      font-size: 4rem;
      line-height: 1.25;

      @media (max-width: 768px) {
        text-align: center;
      }

      span {
        text-wrap-mode: nowrap;
        &:last-of-type {
          color: var(--accent);
        }
      }
    }

    p {
      color: var(--text-muted);
      line-height: 1.5;
    }
  }

  section:last-child {
    flex-grow: 1;
    flex-shrink: 0;

    padding: 32px;
    border: 1px solid var(--line-muted);
    border-top: 4px solid var(--accent);
    background-color: var(--surface);
    box-shadow: var(--shadow);

    @media (min-width: 768px) {
      transform: rotate(1deg);
      transition: 0.2s;
      &:hover {
        transform: rotate(0);
      }
    }

    h2 {
      margin: 0;
      color: var(--forest);
      font-size: 2rem;
      font-weight: 500;
    }

    p:first-of-type {
      margin: 14px 0 28px;
      color: var(--text-muted);
      font-size: 0.87rem;
    }

    p:last-of-type {
      margin: 24px 0 0;
      padding-top: 18px;
      border-top: 1px solid var(--line);
      color: var(--text-muted);
      font-size: 0.83rem;
      text-align: center;

      a {
        color: var(--accent-strong);
        font-weight: 700;
      }
    }
  }
</style>
