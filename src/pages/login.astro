---
import { actions } from 'astro:actions'
import { env } from 'cloudflare:workers'
import { getSiteStats } from '../lib/site'
import Layout from '../layouts/Layout.astro'
import Button from '../components/ui/Button.astro'
import SiteStats from '../components/SiteStats.astro'
import ErrorBox from '../components/ui/ErrorBox.astro'
import Control from '../components/ui/Control.astro'
import Field from '../components/ui/Field.astro'

const db = env.rim_guild_db
const { commissionCount, registeredUserCount } = await getSiteStats(db)

const next = Astro.url.searchParams.get('next')
const redirectTo =
  next && next.startsWith('/') && !next.startsWith('//') ? next : '/me'

const mode =
  Astro.url.searchParams.get('mode') === 'register' ||
  Astro.url.searchParams.get('_action') === 'register'
    ? 'register'
    : 'login'
const action = mode === 'register' ? actions.register : actions.login

const loginResult = Astro.getActionResult(actions.login)
const registerResult = Astro.getActionResult(actions.register)

if (
  (loginResult && !loginResult.error) ||
  (registerResult && !registerResult.error)
) {
  return Astro.redirect(redirectTo)
}

const result = mode === 'register' ? registerResult : loginResult
---

<script>
  type Mode = 'login' | 'register'

  const form = document.querySelector('form[data-auth-form]') as HTMLFormElement
  const title = document.querySelector('[data-auth-title]') as HTMLElement
  const description = document.querySelector(
    '[data-auth-description]',
  ) as HTMLElement
  const submit = document.querySelector('[data-auth-submit]') as HTMLElement
  const switchLabel = document.querySelector(
    '[data-auth-switch-label]',
  ) as HTMLElement
  const switchLink = document.querySelector(
    '[data-auth-switch]',
  ) as HTMLAnchorElement
  const password = form.elements.namedItem('password') as HTMLInputElement
  const loginAction = form.dataset.loginAction!
  const registerAction = form.dataset.registerAction!

  const copy = {
    login: {
      title: '登录',
      description: '登录后继续管理你的委托和协作记录',
      submit: '登录',
      switchLabel: '没有账号？',
      switchText: '去注册',
    },
    register: {
      title: '注册账号',
      description: '注册后，你可以发布委托、认领需求并维护个人资料',
      submit: '注册',
      switchLabel: '已有账号？',
      switchText: '去登录',
    },
  } as const

  const updateMode = (mode: Mode) => {
    const isRegister = mode === 'register'
    const content = copy[mode]

    form.dataset.mode = mode
    form.action = isRegister ? registerAction : loginAction
    title.textContent = content.title
    description.textContent = content.description
    submit.textContent = content.submit
    switchLabel.textContent = content.switchLabel
    switchLink.textContent = content.switchText
    password.toggleAttribute('minlength', isRegister)
    password.placeholder = isRegister ? '至少8位' : ''

    const url = new URL(window.location.href)
    if (isRegister) {
      url.searchParams.set('mode', 'register')
    } else {
      url.searchParams.delete('mode')
    }
    window.history.replaceState(null, '', url)

    const switchUrl = new URL(url)
    if (isRegister) {
      switchUrl.searchParams.delete('mode')
    } else {
      switchUrl.searchParams.set('mode', 'register')
    }
    switchLink.href = `${switchUrl.pathname}${switchUrl.search}`

    const error = form.querySelector('[role="alert"]') as HTMLElement | null
    error?.setAttribute('hidden', '')
    document.title = `${content.title} · 边缘工会`
  }

  switchLink.addEventListener('click', event => {
    event.preventDefault()
    const currentMode = form.dataset.mode === 'register' ? 'register' : 'login'
    updateMode(currentMode === 'register' ? 'login' : 'register')
  })
</script>

<Layout title={mode === 'register' ? '注册 · 边缘工会' : '登录 · 边缘工会'}>
  <main>
    <header>
      <h1>
        <span>加入</span>
        <span>边缘工会</span>
      </h1>
      <p>成为工会会员，发布的委托，招揽合作者，或寻找合适你的委托。</p>
      <SiteStats
        variant="inline"
        registeredUserCount={registeredUserCount}
        commissionCount={commissionCount}
      />
    </header>

    <section>
      <h2 data-auth-title>{mode === 'register' ? '注册账号' : '登录'}</h2>
      <p data-auth-description>
        {
          mode === 'register'
            ? '注册后，你可以发布委托、认领需求并维护个人资料'
            : '登录后继续管理你的委托和协作记录'
        }
      </p>

      <form
        method="POST"
        action={action}
        data-auth-form
        data-mode={mode}
        data-login-action={actions.login}
        data-register-action={actions.register}
      >
        <Field for="email">
          邮箱
          <Control
            as="input"
            id="email"
            name="email"
            type="email"
            required
            maxlength="200"
            placeholder="you@example.com"
          />
        </Field>
        <Field for="password">
          密码
          <Control
            as="input"
            id="password"
            name="password"
            type="password"
            required
            minlength={mode === 'register' ? 8 : undefined}
            placeholder={mode === 'register' ? '至少8位' : undefined}
          />
        </Field>

        <ErrorBox error={result?.error} />

        <Button variant="primary" block type="submit">
          <span data-auth-submit>{mode === 'register' ? '注册' : '登录'}</span>
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 8h10m-4-4 4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="square"
              stroke-linejoin="miter"></path>
          </svg>
        </Button>
      </form>

      <span>
        <span data-auth-switch-label>
          {mode === 'register' ? '已有账号？' : '没有账号？'}
        </span>
        <a
          data-auth-switch
          href={mode === 'register'
            ? `/login?next=${encodeURIComponent(redirectTo)}`
            : `/login?mode=register&next=${encodeURIComponent(redirectTo)}`}
        >
          {mode === 'register' ? '去登录' : '去注册'}
        </a>
      </span>
    </section>
  </main>
</Layout>

<style>
  main {
    display: flex;
    align-items: center;
    flex-direction: row;
    gap: 40px 16px;

    @media (max-width: 768px) {
      flex-direction: column;
    }
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 16px;

    h1 {
      color: var(--forest);
      font-size: 4rem;
      line-height: 1.25;

      @media (max-width: 768px) {
        text-align: center;
      }

      span {
        text-wrap-mode: nowrap;
        &:last-of-type {
          color: var(--accent);
        }
      }
    }

    p {
      color: var(--text-muted);
      line-height: 1.5;
    }
  }

  section {
    flex-grow: 1;
    flex-shrink: 0;

    display: flex;
    flex-direction: column;
    gap: 16px;

    padding: 32px;
    border: 1px solid var(--line-muted);
    border-top: 4px solid var(--accent);
    background-color: var(--surface);
    box-shadow: var(--shadow);

    h2 {
      color: var(--forest);
      font-size: 2rem;
      font-weight: normal;
    }

    p {
      color: var(--text-muted);
      font-size: 0.87rem;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    & > span {
      color: var(--text-muted);
      font-size: 0.875rem;
      text-align: center;

      padding-top: 16px;
      border-top: 1px dashed var(--line);

      a {
        color: var(--accent-strong);
        font-weight: 700;
      }
    }
  }
</style>
