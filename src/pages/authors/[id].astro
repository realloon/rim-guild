---
import Layout from '../../layouts/Layout.astro'
import CommissionListItem from '../../components/CommissionListItem.astro'
import {
  COMMISSION_SELECT,
  commissionFromRow,
  requirementTypeLabel,
  type Commission,
  type CommissionRow,
  type RequirementType,
} from '../../lib/commissions'
import { avatarUrl } from '../../lib/avatar'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const { id } = Astro.params

const profile = await db
  .prepare(
    'SELECT token, author_name, qq, github, steam, creator_types FROM profiles WHERE author_id = ?',
  )
  .bind(id)
  .first<{
    token: string
    author_name: string
    qq: string
    github: string
    steam: string
    creator_types: string
  }>()

const authorCreatorTypes: RequirementType[] = profile?.creator_types
  ? (profile.creator_types.split(',').filter(Boolean) as RequirementType[])
  : []

let commissions: Commission[] = []
if (profile) {
  const { results } = await db
    .prepare(
      `${COMMISSION_SELECT}
			WHERE c.author_token = ?
			GROUP BY c.id
			ORDER BY c.created_at DESC, c.id DESC`,
    )
    .bind(profile.token)
    .all<CommissionRow>()
  commissions = results.map(commissionFromRow)
}

if (!profile) {
  Astro.response.status = 404
}
---

<Layout
  title={profile
    ? `${profile.author_name} · 边缘工会`
    : '作者不存在 · 边缘工会'}
>
  <main>
    {
      profile ? (
        <>
          <section class="profile-card">
            <div class="profile-hero">
              <div class="profile-identity">
                <img
                  class="author-avatar"
                  src={avatarUrl(profile.token, 72)}
                  width={72}
                  height={72}
                  alt={`${profile.author_name} 的头像`}
                />
                <div>
                  <h1>{profile.author_name}</h1>
                  {authorCreatorTypes.length > 0 && (
                    <div class="tags">
                      {authorCreatorTypes.map(creatorType => (
                        <span class="tag">
                          {requirementTypeLabel(creatorType)}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
              <span class="profile-badge">发布者</span>
            </div>
            {(profile.qq || profile.github || profile.steam) && (
              <div class="profile-contacts">
                {profile.qq && (
                  <div class="profile-contact-item">
                    <strong>QQ</strong>
                    <span>{profile.qq}</span>
                  </div>
                )}
                {profile.github && (
                  <div class="profile-contact-item">
                    <strong>GITHUB</strong>
                    <span>{profile.github}</span>
                  </div>
                )}
                {profile.steam && (
                  <div class="profile-contact-item">
                    <strong>STEAM</strong>
                    <span>{profile.steam}</span>
                  </div>
                )}
              </div>
            )}
          </section>

          <div class="section-heading">
            <h2>{profile.author_name}的委托</h2>
            <span class="section-count">{commissions.length}条记录</span>
          </div>
          {commissions.length > 0 ? (
            <ul class="commission-list">
              {commissions.map(commission => (
                <CommissionListItem commission={commission} />
              ))}
            </ul>
          ) : (
            <p class="empty">TA还没有发布委托</p>
          )}
        </>
      ) : (
        <p class="not-found">该作者不存在</p>
      )
    }
  </main>
</Layout>
