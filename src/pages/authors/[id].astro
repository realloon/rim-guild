---
import Layout from '../../layouts/Layout.astro'
import {
	POST_SELECT,
	postFromRow,
	roleLabel,
	formatDate,
	type Post,
	type RoleType,
} from '../../lib/posts'
import { avatarUrl } from '../../lib/avatar'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const { id } = Astro.params

const profile = await db
	.prepare('SELECT token, author_name, contact, roles FROM profiles WHERE author_id = ?')
	.bind(id)
	.first<{ token: string; author_name: string; contact: string; roles: string }>()

const authorRoles: RoleType[] = profile?.roles
	? (profile.roles.split(',').filter(Boolean) as RoleType[])
	: []

let posts: Post[] = []
if (profile) {
	const { results } = await db
		.prepare(
			`${POST_SELECT}
			WHERE p.author_token = ?
			GROUP BY p.id
			ORDER BY p.created_at DESC, p.id DESC`
		)
		.bind(profile.token)
		.all()
	posts = results.map(postFromRow)
}

if (!profile) {
	Astro.response.status = 404
}
---

<Layout title={profile ? `${profile.author_name} · 边缘工会` : '作者不存在 · 边缘工会'}>
	<div class="container">
		<header class="site-header">
			<h1><a href="/">边缘工会</a></h1>
			<a class="btn" href="/posts/new">发布需求</a>
		</header>

		<nav class="quick-nav">
			<a href="/">返回列表</a>
			<a href="/me">我的主页</a>
		</nav>

		<main>
			{profile ? (
				<>
					<section class="profile-card">
						<div class="profile-head">
							<img class="author-avatar" src={avatarUrl(profile.token, 64)} width={64} height={64} alt={`${profile.author_name} 的头像`} />
							<div>
								<h2>{profile.author_name}</h2>
								{authorRoles.length > 0 && (
									<div class="tags">
										{authorRoles.map((role) => <span class="tag">{roleLabel(role)}</span>)}
									</div>
								)}
								<p class="field-note">{profile.contact}</p>
							</div>
						</div>
					</section>

					<h2>TA 的需求（{posts.length}）</h2>
					{posts.length > 0 ? (
						<ul class="post-list">
							{
								posts.map((post) => (
									<li>
										<a href={`/posts/${post.id}`}>
											<h2>{post.title}</h2>
											{post.description && <p class="post-excerpt">{post.description}</p>}
											<div class="post-meta">
												<span class="tags">
													{post.roles.map((role) => <span class="tag">{roleLabel(role.type)}</span>)}
												</span>
												<time>{formatDate(post.created_at)}</time>
											</div>
										</a>
									</li>
								))
							}
						</ul>
					) : (
						<p class="empty">TA 还没有发布过需求</p>
					)}
				</>
			) : (
				<p class="not-found">该作者不存在</p>
			)}
		</main>
	</div>
</Layout>
