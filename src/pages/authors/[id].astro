---
import Layout from '../../layouts/Layout.astro'
import CommissionList from '../../components/CommissionList.astro'
import ProfileCard from '../../components/ProfileCard.astro'
import Section from '../../components/Section.astro'
import Notice from '../../components/ui/Notice.astro'
import { listCommissionsByAuthor, requirementTypeLabel } from '../../lib/commissions'
import {
  findProfileByAuthorId,
  listContactMethods,
} from '../../lib/profiles'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const { id } = Astro.params
if (!id) throw new Error('作者 ID 缺失')

const profile = await findProfileByAuthorId(db, id)

const commissions = profile
  ? await listCommissionsByAuthor(db, profile.token)
  : []
const contactMethods = profile ? listContactMethods(profile) : []

if (!profile) {
  Astro.response.status = 404
}
---

<Layout
  title={profile
    ? `${profile.author_name} · 边缘工会`
    : '作者不存在 · 边缘工会'}
>
  <main>
    {
      profile ? (
        <>
          <ProfileCard
            seed={profile.token}
            name={profile.author_name}
            tags={profile.creator_types.map(requirementTypeLabel)}
            contacts={contactMethods}
          />

          <Section
            title={`${profile.author_name}的委托`}
            meta={`${commissions.length}条记录`}
          >
            <CommissionList
              commissions={commissions}
              emptyMessage="TA还没有发布委托"
            />
          </Section>
        </>
      ) : (
        <Notice>该作者不存在</Notice>
      )
    }
  </main>
</Layout>
