---
import Layout from '../../layouts/Layout.astro'
import PostListItem from '../../components/PostListItem.astro'
import {
  POST_SELECT,
  postFromRow,
  roleLabel,
  type Post,
  type PostRow,
  type RoleType,
} from '../../lib/posts'
import { avatarUrl } from '../../lib/avatar'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const { id } = Astro.params

const profile = await db
  .prepare(
    'SELECT token, author_name, qq, github, steam, roles FROM profiles WHERE author_id = ?',
  )
  .bind(id)
  .first<{
    token: string
    author_name: string
    qq: string
    github: string
    steam: string
    roles: string
  }>()

const authorRoles: RoleType[] = profile?.roles
  ? (profile.roles.split(',').filter(Boolean) as RoleType[])
  : []

let posts: Post[] = []
if (profile) {
  const { results } = await db
    .prepare(
      `${POST_SELECT}
			WHERE p.author_token = ?
			GROUP BY p.id
			ORDER BY p.created_at DESC, p.id DESC`,
    )
    .bind(profile.token)
    .all<PostRow>()
  posts = results.map(postFromRow)
}

if (!profile) {
  Astro.response.status = 404
}
---

<Layout
  title={profile
    ? `${profile.author_name} · 边缘工会`
    : '作者不存在 · 边缘工会'}
  back
>
  <main>
    {
      profile ? (
        <>
          <section class="profile-card">
            <div class="profile-hero">
              <div class="profile-identity">
                <img
                  class="author-avatar"
                  src={avatarUrl(profile.token, 72)}
                  width={72}
                  height={72}
                  alt={`${profile.author_name} 的头像`}
                />
                <div>
                  <h1>{profile.author_name}</h1>
                  {authorRoles.length > 0 && (
                    <div class="tags">
                      {authorRoles.map(role => (
                        <span class="tag">{roleLabel(role)}</span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
              <span class="profile-badge">发布者</span>
            </div>
            {(profile.qq || profile.github || profile.steam) && (
              <div class="profile-contacts">
                {profile.qq && (
                  <div class="profile-contact-item">
                    <strong>QQ</strong>
                    <span>{profile.qq}</span>
                  </div>
                )}
                {profile.github && (
                  <div class="profile-contact-item">
                    <strong>GITHUB</strong>
                    <span>{profile.github}</span>
                  </div>
                )}
                {profile.steam && (
                  <div class="profile-contact-item">
                    <strong>STEAM</strong>
                    <span>{profile.steam}</span>
                  </div>
                )}
              </div>
            )}
          </section>

          <div class="section-heading">
            <div>
              <h2>TA 的需求</h2>
            </div>
            <span class="section-count">{posts.length} 条记录</span>
          </div>
          {posts.length > 0 ? (
            <ul class="post-list">
              {posts.map(post => (
                <PostListItem post={post} />
              ))}
            </ul>
          ) : (
            <p class="empty">TA 还没有发布过需求</p>
          )}
        </>
      ) : (
        <p class="not-found">该作者不存在</p>
      )
    }
  </main>
</Layout>
