---
import Layout from '../layouts/Layout.astro'
import AuthorAvatar from '../components/AuthorAvatar.astro'
import { ROLE_TYPES, POST_SELECT, postFromRow, roleLabel, formatDate, type Post, type RoleType } from '../lib/posts'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const roleParam = Astro.url.searchParams.get('role')
const activeRole: RoleType | null = roleParam && roleParam in ROLE_TYPES ? (roleParam as RoleType) : null

const sql = activeRole
	? `${POST_SELECT}
		WHERE p.status = 'open'
		AND EXISTS (
			SELECT 1 FROM post_roles pr2 WHERE pr2.post_id = p.id AND pr2.role_type = ?
		)
		GROUP BY p.id
		ORDER BY p.created_at DESC, p.id DESC`
	: `${POST_SELECT}
		WHERE p.status = 'open'
		GROUP BY p.id
		ORDER BY p.created_at DESC, p.id DESC`

const { results } = await db
	.prepare(sql)
	.bind(...(activeRole ? [activeRole] : []))
	.all()
const posts: Post[] = results.map(postFromRow)
---

<Layout title="边缘工会 · RimWorld 模组需求平台">
	<main>
		<nav class="role-filter" aria-label="按类型筛选">
			<a href="/" class={activeRole === null ? 'active' : ''}>全部</a>
			{
				Object.entries(ROLE_TYPES).map(([value, label]) => (
					<a href={`/?role=${value}`} class={activeRole === value ? 'active' : ''}>
						{label}
					</a>
				))
			}
		</nav>

		{results.length > 0 ? (
				<ul class="post-list">
					{
						posts.map((post) => (
							<li>
								<a href={`/posts/${post.id}`}>
									<h2>{post.title}</h2>
									{post.description && <p class="post-excerpt">{post.description}</p>}
									<div class="post-meta">
										<span class="tags">
											{post.roles.map((role) => <span class="tag">{roleLabel(role.type)}</span>)}
										</span>
										<span class="meta-side">
											<AuthorAvatar seed={post.author_token} name={post.author_name} href={`/authors/${post.author_id}`} size={28} />
											<time>{formatDate(post.created_at)}</time>
										</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			) : (
				<p class="empty">{activeRole ? '该类型下还没有需求' : '还没有需求，来发布第一条吧'}</p>
			)}
		</main>
</Layout>
