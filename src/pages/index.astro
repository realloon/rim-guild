---
import Layout from '../layouts/Layout.astro'
import CommissionListItem from '../components/CommissionListItem.astro'
import Input from '../components/ui/Input.astro'
import {
  REQUIREMENT_TYPES,
  COMMISSION_SELECT,
  commissionFromRow,
  type Commission,
  type CommissionRow,
  type RequirementType,
} from '../lib/commissions'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const requirementParam = Astro.url.searchParams.get('requirement')
const activeRequirementType: RequirementType | null =
  requirementParam && requirementParam in REQUIREMENT_TYPES
    ? (requirementParam as RequirementType)
    : null
const q = (Astro.url.searchParams.get('q') ?? '').trim()

const myProfileToken = Astro.locals.auth?.profileToken ?? null

// 主列表（类型筛选 + 关键词搜索叠加）
const conditions = [
  `EXISTS (
		SELECT 1 FROM requirements r2
		WHERE r2.commission_id = c.id AND r2.status = 'open'
	)`,
]
const params: string[] = []
if (activeRequirementType) {
  conditions.push(
    `EXISTS (
			SELECT 1 FROM requirements r2
			WHERE r2.commission_id = c.id AND r2.requirement_type = ? AND r2.status = 'open'
		)`,
  )
  params.push(activeRequirementType)
}
if (q) {
  const escaped = q.replace(/[%_]/g, m => `\\${m}`)
  conditions.push(
    `(c.title LIKE ? ESCAPE '\\' OR c.description LIKE ? ESCAPE '\\')`,
  )
  params.push(`%${escaped}%`, `%${escaped}%`)
}

const { results } = await db
  .prepare(
    `${COMMISSION_SELECT}
		WHERE ${conditions.join('\n\t\tAND ')}
		GROUP BY c.id
		ORDER BY c.created_at DESC, c.id DESC`,
  )
  .bind(...params)
  .all<CommissionRow>()
const commissions: Commission[] = results.map(commissionFromRow)
const stats = await db
  .prepare(
    `SELECT
			(SELECT COUNT(*) FROM commissions) AS commission_count,
			(SELECT COUNT(*) FROM profiles) AS user_count`,
  )
  .first<{ commission_count: number; user_count: number }>()
const commissionCount = stats?.commission_count ?? 0
const registeredUserCount = stats?.user_count ?? 0
const clearSearchHref = activeRequirementType
  ? `/?requirement=${activeRequirementType}`
  : '/'
---

<Layout title="边缘工会 · RimWorld模组委托平台">
  <main>
    <section class="home-hero">
      <div>
        <h1>在边缘工会，<em>让创意成为创造</em></h1>
        <p>边缘工会连接需求与创作者</p>
        <div>
          <a
            class="btn"
            href={myProfileToken
              ? '/commissions/new'
              : '/login?next=/commissions/new'}
          >
            发布委托
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M8 3v10M3 8h10"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"></path>
            </svg>
          </a>
          <a class="text-link" href="#board">
            查看委托
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M3 8h10m-4-4 4 4-4 4"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
                stroke-linejoin="miter"></path>
            </svg>
          </a>
        </div>
      </div>

      <aside aria-label="开放委托概览">
        <svg aria-hidden="true" viewBox="0 0 150 150" fill="none">
          <circle cx="75" cy="75" r="54" stroke="currentColor" stroke-width="1"
          ></circle>
          <circle
            cx="75"
            cy="75"
            r="39"
            stroke="currentColor"
            stroke-width="1"
            stroke-dasharray="3 6"></circle>
          <path
            d="M75 27v96M27 75h96"
            stroke="currentColor"
            stroke-width="1"
            stroke-dasharray="2 7"></path>
          <path
            d="m75 46 11 18 21 4-15 15 3 21-20-10-20 10 3-21-15-15 21-4 11-18Z"
            fill="color-mix(in oklch, var(--accent) 22%, light-dark(white, black))"
            stroke="var(--accent)"
            stroke-width="2"></path>
        </svg>
        <p>
          让对的人遇上合适的项目，让合适的项目遇上对的人
        </p>
        <dl>
          <div>
            <dt>注册会员</dt>
            <dd>{registeredUserCount}</dd>
          </div>
          <div>
            <dt>委托数量</dt>
            <dd>{commissionCount}</dd>
          </div>
        </dl>
      </aside>
    </section>

    <section class="board-section" id="board">
      <h2>委托列表</h2>

      <nav aria-label="按类型筛选">
        <a
          href={q ? `/?q=${encodeURIComponent(q)}` : '/'}
          class:list={{ active: activeRequirementType === null }}
        >
          全部
        </a>
        {
          Object.entries(REQUIREMENT_TYPES).map(([value, label]) => (
            <a
              href={
                q
                  ? `/?requirement=${value}&q=${encodeURIComponent(q)}`
                  : `/?requirement=${value}`
              }
              class:list={{ active: activeRequirementType === value }}
            >
              {label}
            </a>
          ))
        }
      </nav>

      <form method="GET" action="/">
        {
          activeRequirementType && (
            <input
              type="hidden"
              name="requirement"
              value={activeRequirementType}
            />
          )
        }
        <label for="commission-search">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle
              cx="8.5"
              cy="8.5"
              r="5.5"
              stroke="currentColor"
              stroke-width="1.5"></circle>
            <path
              d="m13 13 4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="square"></path>
          </svg>
          <span class="sr-only">搜索委托标题或描述</span>
          <Input
            variant="search"
            id="commission-search"
            type="search"
            name="q"
            value={q}
            placeholder="搜索委托标题或描述……"
          />
        </label>
        <button class="btn" type="submit">
          搜索
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 8h10m-4-4 4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="square"
              stroke-linejoin="miter"></path>
          </svg>
        </button>
      </form>

      {
        commissions.length > 0 ? (
          <ul class="commission-list">
            {commissions.map(commission => (
              <CommissionListItem commission={commission} />
            ))}
          </ul>
        ) : (
          <div class="empty-state">
            <span>{q ? '没有匹配结果' : '暂无委托'}</span>
            <p>{q ? '没有找到匹配的委托' : '还没有委托，来发布第一份吧'}</p>
            {q && (
              <a class="text-link" href={clearSearchHref}>
                清除搜索
              </a>
            )}
          </div>
        )
      }
    </section>
  </main>
</Layout>

<style>
  .home-hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;

    & > div {
      display: flex;
      flex-direction: column;
      gap: 32px;

      h1 {
        color: var(--forest);
        font-size: 4rem;
        line-height: 1.25;

        em {
          display: block;
          color: var(--accent);
          font-style: normal;
        }
      }

      p {
        max-width: 580px;
        color: var(--text-muted);
        font-size: 1rem;
      }

      div {
        display: flex;
        align-items: center;
        gap: 24px;

        .btn svg {
          width: 14px;
          height: 14px;
        }
      }
    }
  }

  aside {
    box-sizing: border-box;
    position: relative;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;

    color: var(--forest);
    background: color-mix(in srgb, var(--surface) 64%, transparent);

    width: 265px;
    padding: 24px;
    border: 1px solid var(--forest);
    box-shadow: 11px 11px 0 light-dark(rgb(73 57 40 / 0.07), rgb(0 0 0 / 0.25));
    transform: translateX(-16px) rotate(1.5deg);

    &::before,
    &::after {
      content: '';
      position: absolute;
      width: 13px;
      height: 13px;
      border-color: var(--accent);
    }

    &::before {
      top: -6px;
      left: -6px;
      border-top: 2px solid;
      border-left: 2px solid;
    }

    &::after {
      right: -6px;
      bottom: -6px;
      border-right: 2px solid;
      border-bottom: 2px solid;
    }

    & > svg {
      width: 200px;
      margin-bottom: -16px;
    }

    & > p {
      font-family: var(--serif);
      line-height: 1.5;
      text-align: center;
    }

    & > dl {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      margin-block: unset;
      border-top: 1px dashed var(--line);
      padding-top: 16px;

      div {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
      }

      dt {
        color: var(--text-muted);
        font-size: 0.7rem;
      }

      dd {
        margin: 0;
        color: color-mix(in oklch, var(--accent) 78%, light-dark(black, white));
        font-family: var(--serif);
        font-size: 1.5rem;
      }
    }
  }

  .board-section {
    scroll-margin-top: 112px;

    display: flex;
    flex-direction: column;
    gap: 24px;

    nav {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;

      padding-block: 14px;
      border-block: 1px solid var(--line);

      a {
        color: var(--text-muted);
        font-size: 0.875rem;

        padding: 5px 12px;
        border: 1px solid transparent;
        border-radius: 13px;

        transition: 0.2s;

        &:hover {
          border-color: color-mix(in oklch, var(--line) 50%, var(--text-muted));
          color: color-mix(
            in oklch,
            var(--accent) 78%,
            light-dark(black, white)
          );
        }

        &.active {
          color: var(--on-forest);
          background-color: var(--forest);
          border-color: var(--forest);
        }
      }
    }

    form {
      display: flex;
      gap: 12px;

      label {
        display: flex;
        align-items: center;
        flex: 1;
        gap: 10px;
        min-width: 0;
        min-height: 48px;
        padding: 0 14px;
        border: 1px solid
          color-mix(in oklch, var(--line) 50%, var(--text-muted));
        border-radius: 3px;
        background-color: var(--surface);
        color: var(--text-muted);
        box-shadow: inset 0 1px 2px
          light-dark(rgb(73 57 40 / 0.04), rgb(0 0 0 / 0.2));

        &:focus-within {
          border-color: var(--accent);
          box-shadow: 0 0 0 3px
            light-dark(rgb(189 93 67 / 0.13), rgb(232 140 108 / 0.22));
        }

        svg {
          width: 19px;
          height: 19px;
          flex: 0 0 auto;
        }

      }

      button {
        padding-inline: 24px;

        svg {
          width: 14px;
          height: 14px;
        }
      }
    }

    .empty-state {
      display: grid;
      min-height: 230px;
      padding: 42px 24px;
      border: 1px dashed color-mix(in oklch, var(--line) 50%, var(--text-muted));
      place-items: center;
      text-align: center;

      & > span {
        color: var(--accent);
        font-family: var(--mono);
        font-size: 0.68rem;
        font-weight: 700;
      }

      p {
        margin: 8px 0 10px;
        color: var(--text-muted);
      }
    }
  }

  @media (max-width: 768px) {
    .home-hero div h1 {
      font-size: 3rem;
    }

    .home-hero {
      display: block;
      width: 100%;
      min-height: auto;
      padding-top: 12px;
    }

    aside {
      margin: 50px auto 0;
      transform: rotate(0.8deg);
    }

    form {
      align-items: stretch;
      flex-direction: column;
    }

    form > button {
      width: 100%;
    }
  }
</style>
