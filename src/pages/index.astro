---
import Layout from '../layouts/Layout.astro'
import Button from '../components/ui/Button.astro'
import CommissionList from '../components/CommissionList.astro'
import SiteStats from '../components/SiteStats.astro'
import Control from '../components/ui/Control.astro'
import {
  REQUIREMENT_TYPES,
  isRequirementType,
  listOpenCommissions,
  type RequirementType,
} from '../lib/commissions'
import { getSiteStats } from '../lib/site'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const requirementParam = Astro.url.searchParams.get('requirement')
const activeRequirementType: RequirementType | null =
  requirementParam && isRequirementType(requirementParam)
    ? requirementParam
    : null
const q = (Astro.url.searchParams.get('q') ?? '').trim()

const myProfileToken = Astro.locals.auth?.profileToken ?? null
const commissions = await listOpenCommissions(db, {
  search: q || undefined,
})
const hasVisibleCommissions = commissions.some(commission =>
  activeRequirementType
    ? commission.requirements.some(
        requirement =>
          requirement.status === 'open' &&
          requirement.type === activeRequirementType,
      )
    : true,
)
const { commissionCount, registeredUserCount } = await getSiteStats(db)
const clearSearchHref = activeRequirementType
  ? `/?requirement=${activeRequirementType}`
  : '/'
---

<Layout title="边缘工会 · RimWorld模组委托平台">
  <main>
    <section>
      <header>
        <h1>在边缘工会，<em>让创意成为创造</em></h1>
        <p>边缘工会连接需求与创作者</p>
        <div>
          <Button
            href={myProfileToken
              ? '/commissions/new'
              : '/login?next=/commissions/new'}
          >
            发布委托
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M8 3v10M3 8h10"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"></path>
            </svg>
          </Button>
          <Button variant="link" href="#board">
            查看委托
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M3 8h10m-4-4 4 4-4 4"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
                stroke-linejoin="miter"></path>
            </svg>
          </Button>
        </div>
      </header>

      <aside aria-label="开放委托概览">
        <svg aria-hidden="true" viewBox="0 0 150 150" fill="none">
          <circle cx="75" cy="75" r="54" stroke="currentColor" stroke-width="1"
          ></circle>
          <circle
            cx="75"
            cy="75"
            r="39"
            stroke="currentColor"
            stroke-width="1"
            stroke-dasharray="3 6"></circle>
          <path
            d="M75 27v96M27 75h96"
            stroke="currentColor"
            stroke-width="1"
            stroke-dasharray="2 7"></path>
          <path
            d="m75 46 11 18 21 4-15 15 3 21-20-10-20 10 3-21-15-15 21-4 11-18Z"
            fill="color-mix(in oklch, var(--accent) 22%, light-dark(white, black))"
            stroke="var(--accent)"
            stroke-width="2"></path>
        </svg>
        <p>让对的人遇上合适的项目，让合适的项目遇上对的人</p>
        <SiteStats
          variant="card"
          commissionCount={commissionCount}
          registeredUserCount={registeredUserCount}
        />
      </aside>
    </section>

    <section id="board">
      <h2>委托清单</h2>

      <nav aria-label="按类型筛选">
        <a
          href={q ? `/?q=${encodeURIComponent(q)}` : '/'}
          aria-current={activeRequirementType === null ? 'page' : undefined}
        >
          全部
        </a>
        {
          Object.entries(REQUIREMENT_TYPES).map(([value, label]) => (
            <a
              href={
                q
                  ? `/?requirement=${value}&q=${encodeURIComponent(q)}`
                  : `/?requirement=${value}`
              }
              aria-current={
                activeRequirementType === value ? 'page' : undefined
              }
            >
              {label}
            </a>
          ))
        }
      </nav>

      <form method="GET" action="/">
        <input
          type="hidden"
          name="requirement"
          value={activeRequirementType ?? ''}
          data-requirement-filter
        />
        <label for="commission-search">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle
              cx="8.5"
              cy="8.5"
              r="5.5"
              stroke="currentColor"
              stroke-width="1.5"></circle>
            <path
              d="m13 13 4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="square"></path>
          </svg>
          <span class="sr-only">搜索委托标题或描述</span>
          <Control
            as="input"
            variant="search"
            id="commission-search"
            type="search"
            name="q"
            value={q}
            placeholder="搜索委托标题或描述……"
          />
        </label>
        <Button type="submit">
          搜索
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 8h10m-4-4 4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="square"
              stroke-linejoin="miter"></path>
          </svg>
        </Button>
      </form>

      <CommissionList
        commissions={commissions}
        requirementFilter={activeRequirementType}
      >
        <div slot="empty" class="empty-state" hidden={hasVisibleCommissions}>
          <span>{q ? '没有匹配结果' : '暂无委托'}</span>
          <p>{q ? '没有找到匹配的委托' : '还没有委托，来发布第一份吧'}</p>
          {
            q && (
              <Button variant="link" href={clearSearchHref}>
                清除搜索
              </Button>
            )
          }
        </div>
      </CommissionList>
    </section>
  </main>
</Layout>

<script>
  const nav = document.querySelector(
    'nav[aria-label="按类型筛选"]',
  ) as HTMLElement
  const list = document.querySelector(
    'ul[data-filter-list]',
  ) as HTMLUListElement
  const emptyState = document.querySelector('.empty-state') as HTMLElement
  const filterInput = document.querySelector(
    'input[data-requirement-filter]',
  ) as HTMLInputElement
  const links = Array.from(nav.querySelectorAll('a')) as HTMLAnchorElement[]
  const items = Array.from(
    list.querySelectorAll('li[data-requirements]'),
  ) as HTMLLIElement[]
  const clearSearchLink = emptyState.querySelector(
    'a',
  ) as HTMLAnchorElement | null

  const filterFromLink = (link: HTMLAnchorElement) =>
    new URL(link.href, window.location.href).searchParams.get('requirement')

  const initialFilter = filterFromLink(
    nav.querySelector('a[aria-current="page"]') as HTMLAnchorElement,
  )

  const applyFilter = (filter: string | null, updateUrl = true) => {
    let visibleCount = 0

    for (const item of items) {
      const visible =
        !filter || item.dataset.requirements?.split(' ').includes(filter)
      item.hidden = !visible
      if (visible) visibleCount++
    }

    emptyState.hidden = visibleCount > 0
    filterInput.value = filter ?? ''
    for (const link of links) {
      if (filterFromLink(link) === filter) {
        link.setAttribute('aria-current', 'page')
      } else {
        link.removeAttribute('aria-current')
      }
    }

    if (updateUrl) {
      const url = new URL(window.location.href)
      if (filter) {
        url.searchParams.set('requirement', filter)
      } else {
        url.searchParams.delete('requirement')
      }
      window.history.replaceState(null, '', url)
    }

    if (clearSearchLink) {
      const url = new URL(window.location.href)
      url.searchParams.delete('q')
      clearSearchLink.href = `${url.pathname}${url.search}`
    }
  }

  for (const link of links) {
    link.addEventListener('click', event => {
      event.preventDefault()
      applyFilter(filterFromLink(link))
    })
  }

  applyFilter(initialFilter, false)
</script>

<style>
  main > section:first-child {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;

    & > header {
      display: flex;
      flex-direction: column;
      gap: 32px;

      h1 {
        color: var(--forest);
        font-size: 4rem;
        line-height: 1.25;

        em {
          display: block;
          color: var(--accent);
          font-style: normal;
        }
      }

      p {
        max-width: 580px;
        color: var(--text-muted);
        font-size: 1rem;
      }

      div {
        display: flex;
        align-items: center;
        gap: 24px;
      }
    }
  }

  aside {
    box-sizing: border-box;
    position: relative;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;

    color: var(--forest);
    background: color-mix(in srgb, var(--surface) 64%, transparent);

    width: 265px;
    padding: 24px;
    border: 1px solid var(--forest);
    box-shadow: 11px 11px 0 light-dark(rgb(73 57 40 / 0.07), rgb(0 0 0 / 0.25));
    transform: translateX(-16px) rotate(1.5deg);

    &::before,
    &::after {
      content: '';
      position: absolute;
      width: 13px;
      height: 13px;
      border-color: var(--accent);
    }

    &::before {
      top: -6px;
      left: -6px;
      border-top: 2px solid;
      border-left: 2px solid;
    }

    &::after {
      right: -6px;
      bottom: -6px;
      border-right: 2px solid;
      border-bottom: 2px solid;
    }

    & > svg {
      width: 200px;
      margin-bottom: -16px;
    }

    & > p {
      font-family: var(--serif);
      line-height: 1.5;
      text-align: center;
    }
  }

  #board {
    scroll-margin-top: 112px;

    display: flex;
    flex-direction: column;
    gap: 24px;

    nav {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;

      padding-block: 14px;
      border-block: 1px solid var(--line);

      a {
        color: var(--text-muted);
        font-size: 0.875rem;

        padding: 5px 12px;
        border: 1px solid transparent;
        border-radius: 13px;

        transition: 0.2s;

        &:hover {
          border-color: var(--line-muted);
          color: var(--accent-strong);
        }

        &[aria-current='page'] {
          color: var(--on-forest);
          background-color: var(--forest);
          border-color: var(--forest);
        }
      }
    }

    form {
      display: flex;
      gap: 12px;

      label {
        display: flex;
        align-items: center;
        flex: 1;
        gap: 10px;
        min-width: 0;
        min-height: 48px;
        padding: 0 14px;
        border: 1px solid var(--line-muted);
        border-radius: 3px;
        background-color: var(--surface);
        color: var(--text-muted);
        box-shadow: inset 0 1px 2px
          light-dark(rgb(73 57 40 / 0.04), rgb(0 0 0 / 0.2));

        &:focus-within {
          border-color: var(--accent);
          box-shadow: 0 0 0 3px
            light-dark(rgb(189 93 67 / 0.13), rgb(232 140 108 / 0.22));
        }

        svg {
          width: 19px;
          height: 19px;
          flex: 0 0 auto;
        }
      }

      button {
        padding-inline: 24px;
      }
    }

    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 230px;
      padding: 42px 24px;
      border: 1px dashed var(--line-muted);
      text-align: center;

      & > span {
        color: var(--accent);
        font-family: var(--mono);
        font-size: 0.68rem;
        font-weight: 700;
      }

      p {
        margin: 8px 0 10px;
        color: var(--text-muted);
      }
    }
  }

  @media (max-width: 768px) {
    main > section:first-child > header h1 {
      font-size: 3rem;
    }

    main > section:first-child {
      display: block;
      width: 100%;
      min-height: auto;
      padding-top: 12px;
    }

    aside {
      margin: 50px auto 0;
      transform: rotate(0.8deg);
    }

    form {
      align-items: stretch;
      flex-direction: column;
    }

    form > button {
      width: 100%;
    }
  }
</style>
