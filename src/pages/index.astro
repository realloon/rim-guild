---
import Layout from '../layouts/Layout.astro'
import PostListItem from '../components/PostListItem.astro'
import {
  ROLE_TYPES,
  POST_SELECT,
  postFromRow,
  type Post,
  type PostRow,
  type RoleType,
} from '../lib/posts'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const roleParam = Astro.url.searchParams.get('role')
const activeRole: RoleType | null =
  roleParam && roleParam in ROLE_TYPES ? (roleParam as RoleType) : null
const q = (Astro.url.searchParams.get('q') ?? '').trim()

const myProfileToken = Astro.locals.auth?.profileToken ?? null
let myRoles: string[] = []
if (myProfileToken) {
  const profile = await db
    .prepare('SELECT roles FROM profiles WHERE token = ?')
    .bind(myProfileToken)
    .first<{ roles: string }>()
  myRoles = (profile?.roles ?? '').split(',').filter(Boolean)
}

const canUseRecommended = myProfileToken !== null && myRoles.length > 0
const isRecommended = roleParam === 'mine' && canUseRecommended
const activeFilter = isRecommended ? 'mine' : activeRole

// 主列表（类型筛选 + 关键词搜索叠加）
const conditions = [
  `EXISTS (
		SELECT 1 FROM post_roles pr2
		WHERE pr2.post_id = p.id AND pr2.status = 'open'
	)`,
]
const params: string[] = []
if (isRecommended) {
  const placeholders = myRoles.map(() => '?').join(',')
  conditions.push('p.author_token != ?')
  params.push(myProfileToken)
  conditions.push(
    `EXISTS (
			SELECT 1 FROM post_roles pr2
			WHERE pr2.post_id = p.id AND pr2.role_type IN (${placeholders}) AND pr2.status = 'open'
		)`,
  )
  params.push(...myRoles)
}
if (activeRole) {
  conditions.push(
    `EXISTS (
			SELECT 1 FROM post_roles pr2
			WHERE pr2.post_id = p.id AND pr2.role_type = ? AND pr2.status = 'open'
		)`,
  )
  params.push(activeRole)
}
if (q) {
  const escaped = q.replace(/[%_]/g, m => `\\${m}`)
  conditions.push(
    `(p.title LIKE ? ESCAPE '\\' OR p.description LIKE ? ESCAPE '\\')`,
  )
  params.push(`%${escaped}%`, `%${escaped}%`)
}

const { results } = await db
  .prepare(
    `${POST_SELECT}
		WHERE ${conditions.join('\n\t\tAND ')}
		GROUP BY p.id
		ORDER BY p.created_at DESC, p.id DESC`,
  )
  .bind(...params)
  .all<PostRow>()
const posts: Post[] = results.map(postFromRow)
const stats = await db
  .prepare(
    `SELECT
			(SELECT COUNT(*) FROM posts) AS project_count,
			(SELECT COUNT(*) FROM profiles) AS user_count`,
  )
  .first<{ project_count: number; user_count: number }>()
const projectCount = stats?.project_count ?? 0
const registeredUserCount = stats?.user_count ?? 0
const clearFilterHref = isRecommended
  ? q
    ? '/?role=mine'
    : '/'
  : activeRole
    ? q
      ? `/?role=${activeRole}`
      : '/'
    : '/'
---

<Layout title="边缘工会 · RimWorld 模组需求平台">
  <main>
    <section class="home-hero">
      <div class="hero-copy">
        <h1>让每一份模组需求，<em>找到合适的搭档。</em></h1>
        <p class="hero-lede">
          发布需求，寻找画师、开发者和其他合作者。边缘工会把还在草稿里的想法，带到真正的制作现场。
        </p>
        <div class="hero-actions">
          <a
            class="btn"
            href={myProfileToken ? '/posts/new' : '/login?next=/posts/new'}
          >
            发布需求
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M8 3v10M3 8h10"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"></path>
            </svg>
          </a>
          <a class="text-link" href="#board">
            浏览需求
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M3 8h10m-4-4 4 4-4 4"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
                stroke-linejoin="miter"></path>
            </svg>
          </a>
        </div>
      </div>

      <aside class="hero-note" aria-label="开放需求概览">
        <div class="hero-mark" aria-hidden="true">
          <svg viewBox="0 0 150 150" fill="none">
            <circle
              cx="75"
              cy="75"
              r="54"
              stroke="currentColor"
              stroke-width="1"></circle>
            <circle
              cx="75"
              cy="75"
              r="39"
              stroke="currentColor"
              stroke-width="1"
              stroke-dasharray="3 6"></circle>
            <path
              d="M75 27v96M27 75h96"
              stroke="currentColor"
              stroke-width="1"
              stroke-dasharray="2 7"></path>
            <path
              d="m75 46 11 18 21 4-15 15 3 21-20-10-20 10 3-21-15-15 21-4 11-18Z"
              fill="var(--accent-soft)"
              stroke="var(--accent)"
              stroke-width="2"></path>
          </svg>
        </div>
        <p>一个清晰的岗位，往往就是一个模组项目真正开始的地方。</p>
        <dl>
          <div>
            <dt>项目需求</dt>
            <dd>{projectCount}</dd>
          </div>
          <div>
            <dt>注册用户</dt>
            <dd>{registeredUserCount}</dd>
          </div>
        </dl>
      </aside>
    </section>

    <section class="board-section" id="board">
      <div class="section-heading board-heading">
        <h2>{isRecommended ? '适合我的' : '最新需求'}</h2>
      </div>

      <nav class="filter-nav" aria-label="按类型筛选">
        <a
          href={q ? `/?q=${encodeURIComponent(q)}` : '/'}
          class:list={{ active: activeFilter === null }}>全部</a
        >
        {
          canUseRecommended && (
            <a
              href={
                q ? `/?role=mine&q=${encodeURIComponent(q)}` : '/?role=mine'
              }
              class:list={{ active: isRecommended }}
            >
              适合我的
            </a>
          )
        }
        {
          Object.entries(ROLE_TYPES).map(([value, label]) => (
            <a
              href={
                q
                  ? `/?role=${value}&q=${encodeURIComponent(q)}`
                  : `/?role=${value}`
              }
              class:list={{ active: activeRole === value }}
            >
              {label}
            </a>
          ))
        }
      </nav>

      <form class="search-form" method="GET" action="/">
        {
          activeFilter && (
            <input type="hidden" name="role" value={activeFilter} />
          )
        }
        <label class="search-input" for="post-search">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle
              cx="8.5"
              cy="8.5"
              r="5.5"
              stroke="currentColor"
              stroke-width="1.5"></circle>
            <path
              d="m13 13 4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="square"></path>
          </svg>
          <span class="sr-only">搜索项目标题或描述</span>
          <input
            id="post-search"
            type="search"
            name="q"
            value={q}
            placeholder="搜索项目标题或描述……"
          />
        </label>
        <button class="btn" type="submit">
          搜索
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 8h10m-4-4 4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="square"
              stroke-linejoin="miter"></path>
          </svg>
        </button>
      </form>

      {
        posts.length > 0 ? (
          <ul class="post-list">
            {posts.map(post => (
              <PostListItem post={post} />
            ))}
          </ul>
        ) : (
          <div class="empty-state">
            <span>
              {q ? '没有匹配结果' : isRecommended ? '暂无匹配需求' : '暂无需求'}
            </span>
            <p>
              {q
                ? '没有找到匹配的需求'
                : isRecommended
                  ? '暂时没有符合你身份的开放岗位'
                  : '还没有需求，来发布第一条吧'}
            </p>
            {(q || isRecommended) && (
              <a class="text-link" href={clearFilterHref}>
                {isRecommended ? '清除筛选' : '清除搜索'}
              </a>
            )}
          </div>
        )
      }
    </section>
  </main>
</Layout>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.7fr);
    gap: clamp(36px, 8vw, 120px);
    align-items: center;
    min-height: 500px;
    padding: 26px 0 72px;
  }

  .hero-copy h1 {
    max-width: 760px;
    margin: 0;
    color: var(--forest);
    font-size: clamp(2.7rem, 6.2vw, 6.6rem);
    font-weight: 500;
    line-height: 0.98;
  }

  .hero-copy h1 em {
    display: block;
    color: var(--accent);
    font-style: normal;
  }

  .hero-lede {
    max-width: 580px;
    margin: 30px 0 0;
    color: var(--text-dim);
    font-size: 1rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 30px;
  }

  .hero-actions .btn svg {
    width: 15px;
    height: 15px;
  }

  .hero-note {
    position: relative;
    min-height: 360px;
    padding: 20px;
    border: 1px solid var(--forest);
    background: var(--hero-note-surface);
    box-shadow: 11px 11px 0 var(--shadow-small-color);
    transform: rotate(1.3deg);
  }

  .hero-note::before,
  .hero-note::after {
    position: absolute;
    width: 13px;
    height: 13px;
    border-color: var(--accent);
    content: '';
  }

  .hero-note::before {
    top: -6px;
    left: -6px;
    border-top: 2px solid;
    border-left: 2px solid;
  }

  .hero-note::after {
    right: -6px;
    bottom: -6px;
    border-right: 2px solid;
    border-bottom: 2px solid;
  }

  .hero-mark {
    display: grid;
    margin: 0 auto 16px;
    color: var(--forest);
    place-items: center;
  }

  .hero-mark svg {
    width: min(100%, 190px);
    height: auto;
  }

  .hero-note > p {
    margin: 0 0 20px;
    color: var(--forest);
    font-family: Georgia, 'Noto Serif SC', 'Source Han Serif SC', serif;
    font-size: 1rem;
    line-height: 1.55;
    text-align: center;
  }

  .hero-note dl {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin: 0;
    padding-top: 15px;
    border-top: 1px solid var(--border);
  }

  .hero-note dl div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  .hero-note dt {
    color: var(--text-dim);
    font-size: 0.7rem;
  }

  .hero-note dd {
    margin: 0;
    color: var(--accent-strong);
    font-family: Georgia, 'Noto Serif SC', 'Source Han Serif SC', serif;
    font-size: 1.5rem;
  }

  .board-section {
    scroll-margin-top: 110px;
  }

  .board-heading {
    margin-bottom: 24px;
  }

  .search-form {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
  }

  .search-input {
    display: flex;
    align-items: center;
    flex: 1;
    gap: 10px;
    min-width: 0;
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    background: var(--bg-raised);
    color: var(--text-dim);
    box-shadow: inset 0 1px 2px var(--control-shadow-color);
  }

  .search-input:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--focus-ring-color);
  }

  .search-input svg {
    width: 19px;
    height: 19px;
    flex: 0 0 auto;
  }

  .search-input input {
    min-height: 44px;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    box-shadow: none;
  }

  .search-input input:focus {
    border: 0;
    box-shadow: none;
  }

  .search-form > .btn {
    min-width: 100px;
  }

  .search-form > .btn svg {
    width: 15px;
    height: 15px;
  }

  .filter-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 24px;
    padding: 14px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .filter-nav a {
    padding: 5px 11px;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--text-dim);
    font-size: 0.8rem;
    text-decoration: none;
    transition: 0.2s;
  }

  .filter-nav a:hover {
    border-color: var(--border-strong);
    color: var(--accent-strong);
  }

  .filter-nav a.active {
    border-color: var(--forest);
    background: var(--forest);
    color: var(--on-forest);
  }

  .empty-state {
    display: grid;
    min-height: 230px;
    padding: 42px 24px;
    border: 1px dashed var(--border-strong);
    place-items: center;
    text-align: center;
  }

  .empty-state > span {
    color: var(--accent);
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .empty-state p {
    margin: 8px 0 10px;
    color: var(--text-dim);
  }

  @media (max-width: 900px) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr) minmax(230px, 0.65fr);
      gap: 38px;
    }
  }

  @media (max-width: 700px) {
    .home-hero {
      display: block;
      min-height: auto;
      padding-top: 12px;
    }

    .hero-copy h1 {
      font-size: clamp(2.7rem, 14vw, 5rem);
    }

    .hero-note {
      max-width: 360px;
      margin: 50px auto 0;
      transform: rotate(0.8deg);
    }
  }

  @media (max-width: 460px) {
    .search-form {
      align-items: stretch;
      flex-direction: column;
    }

    .search-form > .btn {
      width: 100%;
    }
  }
</style>
