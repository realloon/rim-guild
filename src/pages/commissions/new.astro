---
import Layout from '../../layouts/Layout.astro'
import CommissionForm from '../../components/CommissionForm.astro'
import ErrorBox from '../../components/ui/ErrorBox.astro'
import { actions } from 'astro:actions'

if (!Astro.locals.auth) {
  return Astro.redirect('/login?next=/commissions/new')
}

const result = Astro.getActionResult(actions.createCommission)

if (result && !result.error) {
  return Astro.redirect(`/commissions/${result.data.id}`)
}
---

<Layout title="发布委托 · 边缘工会">
  <main>
    <header>
      <h1>发布委托</h1>
      <p>将创意交予最适合的创作者</p>
    </header>

    <section>
      <CommissionForm />
      <ErrorBox error={result?.error} />
    </section>
  </main>
</Layout>

<style>
  header {
    h1 {
      font-size: 2.5rem;
      color: var(--forest);
      margin-bottom: 16px;
    }

    p {
      color: var(--text-muted);
    }
  }

  section {
    padding: clamp(16px, 100%, 32px);
    border: 1px solid var(--line);
    border-top: 3px solid var(--forest);
    background-color: var(--surface);
    box-shadow: var(--shadow);

    @media (max-width: 768px) {
      padding-inline: 16px;
      margin-inline: -8px;
    }
  }
</style>
