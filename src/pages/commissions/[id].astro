---
import { actions } from 'astro:actions'
import { env } from 'cloudflare:workers'
import { findProfileByToken, listContactMethods } from '../../lib/profiles'
import {
  findCommission,
  incrementCommissionViews,
  listCommissionClaims,
  listCommissionComments,
  listCommissionUpdates,
  tagLabel,
  formatDate,
  type CommissionClaim,
} from '../../lib/commissions'
import Layout from '../../layouts/Layout.astro'
import AuthorAvatar from '../../components/AuthorAvatar.astro'
import CommissionComments from '../../components/CommissionComments.astro'
import CommissionUpdates from '../../components/CommissionUpdates.astro'
import RequirementCard from '../../components/RequirementCard.astro'
import Section from '../../components/Section.astro'
import Button from '../../components/ui/Button.astro'
import BadgeList from '../../components/ui/BadgeList.astro'
import ErrorBox from '../../components/ui/ErrorBox.astro'
import Notice from '../../components/ui/Notice.astro'
import TocNav from '../../components/TocNav.astro'
import IconQq from '../../components/icon/IconQq.astro'
import IconGithub from '../../components/icon/IconGithub.astro'
import IconSteam from '../../components/icon/IconSteam.astro'

const db = env.rim_guild_db
const { id } = Astro.params

const commission = await findCommission(db, Number(id))

if (!commission) {
  Astro.response.status = 404
}

const isOwner =
  !!commission && Astro.locals.auth?.profileToken === commission.author_token
const myProfileToken = Astro.locals.auth?.profileToken ?? null
const viewer =
  commission && myProfileToken && !isOwner
    ? ((await findProfileByToken(db, myProfileToken)) ?? null)
    : null
if (commission && myProfileToken && !isOwner && !viewer) {
  throw new Error('登录会话对应的个人资料不存在')
}
const contactMethods = commission
  ? listContactMethods({
      qq: commission.author_qq,
      github: commission.author_github,
      steam: commission.author_steam,
    })
  : []

const requirementActionResults = [
  Astro.getActionResult(actions.updateRequirementStatus),
  Astro.getActionResult(actions.claimRequirement),
  Astro.getActionResult(actions.cancelClaim),
]
if (
  requirementActionResults.some(result => result && !result.error) &&
  commission
) {
  return Astro.redirect(`/commissions/${commission.id}`)
}
const requirementError = requirementActionResults.find(
  result => result?.error,
)?.error
const deleteResult = Astro.getActionResult(actions.deleteCommission)
if (deleteResult && !deleteResult.error) {
  return Astro.redirect('/me')
}
const updateResult = Astro.getActionResult(actions.addCommissionUpdate)
if (updateResult && !updateResult.error && commission) {
  return Astro.redirect(`/commissions/${commission.id}`)
}
const commentResult = Astro.getActionResult(actions.addCommissionComment)
if (commentResult && !commentResult.error && commission) {
  return Astro.redirect(`/commissions/${commission.id}`)
}
const commentDeleteResult = Astro.getActionResult(
  actions.deleteCommissionComment,
)
if (commentDeleteResult && !commentDeleteResult.error && commission) {
  return Astro.redirect(`/commissions/${commission.id}`)
}

const viewCount = commission
  ? ((await incrementCommissionViews(
      db,
      commission.id,
      myProfileToken,
    )) ?? commission.view_count)
  : 0

const commissionUpdates = commission
  ? await listCommissionUpdates(db, commission.id)
  : []
const commissionComments = commission
  ? await listCommissionComments(db, commission.id)
  : []
const claimRows: CommissionClaim[] = commission
  ? await listCommissionClaims(db, commission.id)
  : []

const claimsByRequirement = new Map<
  CommissionClaim['requirement_type'],
  CommissionClaim[]
>()

claimRows.forEach(claim => {
  const list = claimsByRequirement.get(claim.requirement_type) ?? []
  list.push(claim)
  claimsByRequirement.set(claim.requirement_type, list)
})

const navs = [
  { label: '需求', href: '#requirements' },
  { label: '委托进展', href: '#updates' },
]
---

<script>
  const forms = Array.from(document.forms).filter(form =>
    form.hasAttribute('data-confirm'),
  )

  forms.forEach(form => {
    form.addEventListener('submit', event => {
      const message = form.dataset.confirm
      if (!confirm(message)) {
        event.preventDefault()
      }
    })
  })
</script>

<Layout
  title={commission
    ? `${commission.title} · 边缘公会`
    : '委托不存在 · 边缘公会'}
>
  <main>
    {
      commission ? (
        <article>
          <header>
            <h1>{commission.title}</h1>

            <address>
              <AuthorAvatar
                seed={commission.author_token}
                name={commission.author_name}
                href={`/authors/${commission.author_id}`}
                size={24}
              />
              <time datetime={commission.created_at}>
                {formatDate(commission.created_at)}
              </time>
              <span>{viewCount}次浏览</span>
            </address>
          </header>

          <div class="main-wrapper">
            <section>
              {commission.description && <p>{commission.description}</p>}

              {commission.tags.length > 0 && (
                <BadgeList
                  items={commission.tags.map(tag => '#' + tagLabel(tag))}
                  variant="muted"
                />
              )}

              <Section
                id="requirements"
                title="需求"
                meta={`${commission.requirements.length}项需求`}
              >
                <ul>
                  {commission.requirements.map(requirement => (
                    <RequirementCard
                      commissionId={commission.id}
                      requirement={requirement}
                      claims={claimsByRequirement.get(requirement.type) ?? []}
                      isOwner={isOwner}
                      profileToken={myProfileToken}
                      viewer={viewer}
                    />
                  ))}
                </ul>
              </Section>

              <CommissionUpdates
                commissionId={commission.id}
                updates={commissionUpdates}
                isOwner={isOwner}
                error={updateResult?.error}
              />

              <CommissionComments
                commissionId={commission.id}
                comments={commissionComments}
                profileToken={myProfileToken}
                isOwner={isOwner}
                error={commentResult?.error ?? commentDeleteResult?.error}
              />

              <ErrorBox error={requirementError ?? deleteResult?.error} />
            </section>

            <aside>
              <section>
                <strong>发布者联系方式</strong>
                <address>
                  {contactMethods.length > 0 ? (
                    contactMethods.map(contact => (
                      <p>
                        {contact.label === 'QQ' && (
                          <IconQq aria-hidden="true" />
                        )}
                        {contact.label === 'GitHub' && (
                          <IconGithub aria-hidden="true" />
                        )}
                        {contact.label === 'Steam' && (
                          <IconSteam aria-hidden="true" />
                        )}
                        <span>{contact.value}</span>
                      </p>
                    ))
                  ) : (
                    <p>未填写</p>
                  )}
                </address>
              </section>

              <p>
                如果你对这份委托感兴趣，可以先认领一项需求，再通过联系方式开始交流。
              </p>

              <TocNav navs={navs} />

              {isOwner && (
                <form
                  method="POST"
                  action={actions.deleteCommission}
                  data-confirm="确定删除这份委托吗？删除后不可恢复。"
                >
                  <Button
                    type="button"
                    variant="ghost"
                    href={`/commissions/${commission.id}/edit`}
                  >
                    编辑委托
                  </Button>
                  <input
                    type="hidden"
                    name="commissionId"
                    value={commission.id}
                  />
                  <Button variant="danger" type="submit">
                    删除
                  </Button>
                </form>
              )}
            </aside>
          </div>
        </article>
      ) : (
        <Notice>该委托不存在或已被删除</Notice>
      )
    }
  </main>
</Layout>

<style>
  header {
    border-bottom: 1px solid var(--line);
    margin-bottom: 16px;

    h1 {
      color: var(--forest);
      font-size: 2.5rem;
      line-height: 1.25;
    }

    address {
      display: flex;
      align-items: center;
      gap: 8px;

      color: var(--text-muted);
      font-size: 0.75rem;
      font-style: normal;
      font-family: var(--mono);
      margin-block: 16px;

      time,
      span {
        margin-bottom: -1.5px;
      }
    }
  }

  .main-wrapper {
    display: flex;
    gap: 32px;

    @media (max-width: 768px) {
      flex-wrap: wrap;
    }
  }

  .main-wrapper > section {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 56px;

    & > p {
      line-height: 1.5;
      margin-bottom: 8px;

      &:has(+ ul) {
        margin-bottom: -40px;
      }
    }

    & > section[id] {
      scroll-margin-top: 80px;
    }

    #requirements ul {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
  }

  .main-wrapper aside {
    position: sticky;
    top: 88px;

    display: flex;
    flex-direction: column;
    gap: 16px;

    flex-basis: 280px;
    align-self: start;

    @media (max-width: 768px) {
      flex-grow: 1;

      nav {
        display: none;
      }
    }

    & > section {
      padding: 16px;
      background-color: var(--surface);
      border: 1px solid var(--line);

      strong {
        color: var(--forest);
        font-family: var(--serif);
      }

      address {
        display: flex;
        flex-direction: column;
        gap: 8px;

        font-style: normal;
        font-family: var(--mono);
        margin-top: 12px;

        p {
          display: flex;
          align-items: center;
          gap: 8px;

          span {
            color: var(--accent-strong);
          }
        }
      }
    }

    & > p {
      color: var(--text-muted);
      font-size: 0.875rem;
      line-height: 1.5;
    }

    & > form {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
  }
</style>
