---
import Layout from '../../layouts/Layout.astro'
import AuthorAvatar from '../../components/AuthorAvatar.astro'
import ErrorBox from '../../components/ui/ErrorBox.astro'
import Textarea from '../../components/ui/Textarea.astro'
import {
  COMMISSION_SELECT,
  commissionFromRow,
  requirementTypeLabel,
  requirementStatusLabel,
  tagLabel,
  formatDate,
  type Commission,
  type CommissionRow,
  type RequirementType,
} from '../../lib/commissions'
import { avatarUrl } from '../../lib/avatar'
import { actions } from 'astro:actions'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const { id } = Astro.params

const row = await db
  .prepare(`${COMMISSION_SELECT} WHERE c.id = ? GROUP BY c.id`)
  .bind(Number(id))
  .first<CommissionRow>()

const commission: Commission | undefined = row
  ? commissionFromRow(row)
  : undefined

if (!commission) {
  Astro.response.status = 404
}

const isOwner =
  !!commission && Astro.locals.auth?.profileToken === commission.author_token
const myProfileToken = Astro.locals.auth?.profileToken ?? null

const requirementStatusResult = Astro.getActionResult(
  actions.updateRequirementStatus,
)
if (requirementStatusResult && !requirementStatusResult.error && commission) {
  return Astro.redirect(`/commissions/${commission.id}`)
}
const claimResult = Astro.getActionResult(actions.claimRequirement)
if (claimResult && !claimResult.error && commission) {
  return Astro.redirect(`/commissions/${commission.id}`)
}
const cancelClaimResult = Astro.getActionResult(actions.cancelClaim)
if (cancelClaimResult && !cancelClaimResult.error && commission) {
  return Astro.redirect(`/commissions/${commission.id}`)
}
const deleteResult = Astro.getActionResult(actions.deleteCommission)
if (deleteResult && !deleteResult.error) {
  return Astro.redirect('/me')
}
const updateResult = Astro.getActionResult(actions.addCommissionUpdate)
if (updateResult && !updateResult.error && commission) {
  return Astro.redirect(`/commissions/${commission.id}`)
}

let commissionUpdateRows: {
  id: number
  content: string
  created_at: string
}[] = []
let claimRows: {
  commission_id: number
  requirement_type: string
  profile_token: string
  created_at: string
  author_name: string
  author_id: string
}[] = []

if (commission) {
  const { results: updates } = await db
    .prepare(
      'SELECT id, content, created_at FROM commission_updates WHERE commission_id = ? ORDER BY created_at DESC, id DESC',
    )
    .bind(commission.id)
    .all<{ id: number; content: string; created_at: string }>()
  commissionUpdateRows = updates

  const { results: claims } = await db
    .prepare(
      `SELECT r.commission_id, r.requirement_type, r.profile_token, r.created_at, p.author_name, p.author_id
			FROM claims r
			JOIN profiles p ON p.token = r.profile_token
			WHERE r.commission_id = ?
			ORDER BY r.created_at ASC`,
    )
    .bind(commission.id)
    .all<{
      commission_id: number
      requirement_type: string
      profile_token: string
      created_at: string
      author_name: string
      author_id: string
    }>()
  claimRows = claims
}

const claimsByRequirement = new Map<string, typeof claimRows>()
for (const claim of claimRows) {
  const list = claimsByRequirement.get(claim.requirement_type) ?? []
  list.push(claim)
  claimsByRequirement.set(claim.requirement_type, list)
}
---

<script>
  const forms = Array.from(document.forms).filter(form =>
    form.hasAttribute('data-confirm'),
  )
  forms.forEach(form => {
    form.addEventListener('submit', event => {
      const message = form.dataset.confirm
      if (!confirm(message)) {
        event.preventDefault()
      }
    })
  })
</script>

<Layout
  title={commission
    ? `${commission.title} · 边缘工会`
    : '委托不存在 · 边缘工会'}
  back
>
  <main>
    {
      commission ? (
        <article>
          <header>
            <h1>{commission.title}</h1>
            <div>
              <AuthorAvatar
                seed={commission.author_token}
                name={commission.author_name}
                href={`/authors/${commission.author_id}`}
                size={32}
              />
              <span>/</span>
              <time>{formatDate(commission.created_at)}</time>
            </div>
          </header>

          <div>
            <div>
              {commission.description && (
                <div class="detail-description">
                  <p>{commission.description}</p>
                </div>
              )}

              {commission.tags.length > 0 && (
                <div class="commission-tags">
                  {commission.tags.map(tag => (
                    <span class="tag tag-muted">{tagLabel(tag)}</span>
                  ))}
                </div>
              )}

              <section class="requirement-section">
                <div class="section-heading">
                  <h2>需求</h2>
                  <span class="section-count">
                    {commission.requirements.length}项需求
                  </span>
                </div>

                <div class="requirement-list">
                  {commission.requirements.map(requirement => {
                    const claims =
                      claimsByRequirement.get(requirement.type) ?? []
                    const registered = claims.some(
                      r => r.profile_token === myProfileToken,
                    )
                    return (
                      <div class="requirement-card">
                        <div class="requirement-card-head">
                          <div class="requirement-title">
                            <span class="tag">
                              {requirementTypeLabel(requirement.type)}
                            </span>
                            <span class="requirement-count-label">
                              共需{requirement.count}人
                              {claims.length > 0
                                ? `，${claims.length}人已认领`
                                : ''}
                            </span>
                          </div>
                          <span class={`status status-${requirement.status}`}>
                            {requirementStatusLabel(requirement.status)}
                          </span>
                        </div>
                        <p>{requirement.description}</p>

                        {claims.length > 0 && (
                          <div class="response-area">
                            <span class="response-label">已加入</span>
                            <div class="response-avatars">
                              {claims.map(claim => (
                                <a
                                  class="author"
                                  href={`/authors/${claim.author_id}`}
                                >
                                  <img
                                    class="author-avatar"
                                    src={avatarUrl(claim.profile_token, 30)}
                                    width={30}
                                    height={30}
                                    alt={`${claim.author_name} 的头像`}
                                    title={claim.author_name}
                                  />
                                </a>
                              ))}
                            </div>
                          </div>
                        )}

                        <div class="requirement-actions">
                          {isOwner ? (
                            <form
                              method="POST"
                              action={actions.updateRequirementStatus}
                            >
                              <input
                                type="hidden"
                                name="commissionId"
                                value={commission.id}
                              />
                              <input
                                type="hidden"
                                name="requirementType"
                                value={requirement.type}
                              />
                              <input
                                type="hidden"
                                name="status"
                                value={
                                  requirement.status === 'open'
                                    ? 'closed'
                                    : 'open'
                                }
                              />
                              <button
                                class="btn btn-ghost btn-sm"
                                type="submit"
                              >
                                {requirement.status === 'open'
                                  ? '停止招募'
                                  : '重新开放'}
                              </button>
                            </form>
                          ) : requirement.status === 'open' ? (
                            !myProfileToken ? (
                              <a
                                class="btn btn-sm"
                                href={`/login?next=/commissions/${commission.id}`}
                              >
                                登录后认领需求
                              </a>
                            ) : registered ? (
                              <form method="POST" action={actions.cancelClaim}>
                                <input
                                  type="hidden"
                                  name="commissionId"
                                  value={commission.id}
                                />
                                <input
                                  type="hidden"
                                  name="requirementType"
                                  value={requirement.type}
                                />
                                <button
                                  class="btn btn-ghost btn-sm"
                                  type="submit"
                                >
                                  取消认领
                                </button>
                              </form>
                            ) : (
                              <form
                                method="POST"
                                action={actions.claimRequirement}
                              >
                                <input
                                  type="hidden"
                                  name="commissionId"
                                  value={commission.id}
                                />
                                <input
                                  type="hidden"
                                  name="requirementType"
                                  value={requirement.type}
                                />
                                <button class="btn btn-sm" type="submit">
                                  认领需求
                                </button>
                              </form>
                            )
                          ) : null}
                        </div>
                      </div>
                    )
                  })}
                </div>
              </section>

              <section class="commission-updates">
                <div class="section-heading">
                  <h2>委托进展</h2>
                  <span class="section-count">
                    {commissionUpdateRows.length}条记录
                  </span>
                </div>
                {commissionUpdateRows.length > 0 ? (
                  <ul>
                    {commissionUpdateRows.map(update => (
                      <li>
                        <p>{update.content}</p>
                        <time>{formatDate(update.created_at)}</time>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="field-note">还没有更新</p>
                )}
                {isOwner && (
                  <form method="POST" action={actions.addCommissionUpdate}>
                    <input
                      type="hidden"
                      name="commissionId"
                      value={commission.id}
                    />
                    <Textarea
                      name="content"
                      required
                      maxlength="1000"
                      placeholder="发布委托进展，例如：画师已加入，还在找开发者……"
                    />
                    <ErrorBox error={updateResult?.error} />
                    <button class="btn btn-sm" type="submit">
                      发布更新
                    </button>
                  </form>
                )}
              </section>

              <ErrorBox
                error={
                  requirementStatusResult?.error ??
                  deleteResult?.error ??
                  claimResult?.error ??
                  cancelClaimResult?.error
                }
              />
            </div>

            <aside>
              <section class="contact-box">
                <strong>发布者联系方式</strong>
                {commission.author_qq && <div>QQ：{commission.author_qq}</div>}
                {commission.author_github && (
                  <div>GitHub：{commission.author_github}</div>
                )}
                {commission.author_steam && (
                  <div>Steam：{commission.author_steam}</div>
                )}
                {!commission.author_qq &&
                  !commission.author_github &&
                  !commission.author_steam && <div>未填写</div>}
              </section>

              <p>
                如果你对这份委托感兴趣，可以先认领一项开放需求，再通过联系方式开始交流。
              </p>

              {isOwner && (
                <div class="commission-owner-actions">
                  <a
                    class="btn btn-ghost"
                    href={`/commissions/${commission.id}/edit`}
                  >
                    编辑委托
                  </a>
                  <form
                    method="POST"
                    action={actions.deleteCommission}
                    data-confirm="确定删除这份委托吗？删除后不可恢复。"
                  >
                    <input
                      type="hidden"
                      name="commissionId"
                      value={commission.id}
                    />
                    <button class="btn btn-danger" type="submit">
                      删除
                    </button>
                  </form>
                </div>
              )}
            </aside>
          </div>
        </article>
      ) : (
        <p class="not-found">该委托不存在或已被删除</p>
      )
    }
  </main>
</Layout>

<style>
  article {
    > header {
      padding: 40px 0 34px;
      border-bottom: 1px solid var(--line);

      h1 {
        margin: 0 0 24px;
        color: var(--forest);
        font-size: 5.3rem;
        font-weight: 500;
      }

      > div {
        display: flex;
        align-items: center;
        gap: 12px;

        .author {
          color: var(--text);
          font-weight: 700;

          &:hover {
            color: color-mix(
              in oklch,
              var(--accent) 78%,
              light-dark(black, white)
            );
          }
        }

        span {
          color: color-mix(in oklch, var(--line) 50%, var(--text-muted));
        }
      }
    }

    > div {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(230px, 280px);
      gap: 24px;
      padding-top: 44px;

      > div {
        .detail-description {
          margin-bottom: 22px;
          padding: 22px 24px;
          border-left: 3px solid var(--accent);
          background: color-mix(in srgb, var(--surface) 72%, transparent);

          p {
            margin: 0;
            white-space: pre-wrap;
            color: var(--text);
            font-size: 1rem;
          }
        }

        .commission-tags {
          display: flex;
          flex-wrap: wrap;
          gap: 8px;
          margin-bottom: 18px;
        }

        .tag-muted {
          border-color: var(--line);
          color: var(--text-muted);
        }

        .requirement-section {
          margin-top: 40px;

          .section-heading {
            margin-bottom: 16px;
          }

          .requirement-list {
            display: grid;
            gap: 12px;

            .requirement-card {
              padding: 20px 22px;
              border: 1px solid var(--line);
              background-color: var(--surface);
              box-shadow: var(--shadow-small);

              &:has(.status-closed) {
                opacity: 0.68;
              }

              > p {
                margin: 15px 0 0;
                white-space: pre-wrap;
                color: var(--text);
              }

              .requirement-card-head {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;

                .requirement-title {
                  display: flex;
                  align-items: center;
                  flex-wrap: wrap;
                  gap: 9px;

                  .requirement-count-label {
                    color: var(--text-muted);
                    font-size: 0.8rem;
                  }
                }
              }

              .response-area {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-top: 16px;
                padding-top: 13px;
                border-top: 1px dashed var(--line);

                .response-label {
                  flex: 0 0 auto;
                  color: var(--text-muted);
                  font-size: 0.72rem;
                }

                .response-avatars {
                  display: flex;
                  align-items: center;

                  .author + .author {
                    margin-left: -6px;
                  }

                  .author-avatar {
                    border-color: var(--surface);
                  }
                }
              }

              .requirement-actions {
                margin-top: 16px;

                form {
                  display: inline-flex;
                }
              }
            }
          }
        }

        .commission-updates {
          margin-top: 54px;

          .section-heading {
            margin-bottom: 17px;
          }

          ul {
            display: grid;
            gap: 10px;
            margin: 0 0 20px;
            padding: 0;
            list-style: none;

            li {
              padding: 16px 18px;
              border-left: 2px solid var(--gold);
              background-color: var(--surface);
              box-shadow: var(--shadow-small);

              p {
                margin: 0 0 8px;
                white-space: pre-wrap;
              }
            }
          }

          form {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid var(--line);

            textarea {
              min-height: 130px;
              margin-bottom: 12px;
            }
          }
        }
      }

      > aside {
        position: sticky;
        top: 110px;
        align-self: start;

        .contact-box {
          padding: 22px;
          border: 1px solid color-mix(in oklch, var(--accent) 52%, var(--line));
          background: color-mix(in oklch, var(--accent) 10%, var(--surface));
          color: color-mix(
            in oklch,
            var(--accent) 78%,
            light-dark(black, white)
          );

          strong {
            display: block;
            margin-bottom: 12px;
            color: var(--forest);
            font-family: var(--serif);
            font-size: 1.1rem;
            font-weight: 600;
          }

          div {
            padding: 7px 0;
            border-top: 1px solid
              color-mix(in srgb, var(--accent) 40%, transparent);
            color: color-mix(
              in oklch,
              var(--accent) 78%,
              light-dark(black, white)
            );
            font-size: 0.87rem;

            &:first-of-type {
              border-top: 0;
            }
          }
        }

        p {
          margin: 18px 0 0;
          color: var(--text-muted);
          font-size: 0.78rem;
        }

        .commission-owner-actions {
          display: flex;
          flex-wrap: wrap;
          gap: 9px;
          margin-top: 28px;
          padding-top: 20px;
          border-top: 1px solid var(--line);

          form {
            display: inline-flex;
          }
        }
      }
    }
  }

  @media (max-width: 768px) {
    header {
      padding-top: 30px;

      h1 {
        font-size: 2.25rem;
      }
    }

    article > div {
      display: flex;
      flex-direction: column;
      padding-top: 32px;
    }

    aside {
      position: static;
    }

    .requirement-card {
      padding: 17px;

      .requirement-card-head {
        align-items: flex-start;
        flex-direction: column;

        .status {
          align-self: flex-start;
        }
      }
    }

    .response-area {
      align-items: flex-start;
      flex-direction: column;
      gap: 7px;
    }
  }
</style>
