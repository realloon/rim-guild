---
import Layout from '../../../layouts/Layout.astro'
import CommissionForm from '../../../components/CommissionForm.astro'
import ErrorBox from '../../../components/ui/ErrorBox.astro'
import {
  COMMISSION_SELECT,
  commissionFromRow,
  type Commission,
  type CommissionRow,
} from '../../../lib/commissions'
import { actions } from 'astro:actions'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const { id } = Astro.params

const row = await db
  .prepare(`${COMMISSION_SELECT} WHERE c.id = ? GROUP BY c.id`)
  .bind(Number(id))
  .first<CommissionRow>()

const commission: Commission | undefined = row
  ? commissionFromRow(row)
  : undefined
const isOwner =
  !!commission && Astro.locals.auth?.profileToken === commission.author_token

if (!commission) {
  Astro.response.status = 404
} else if (!isOwner) {
  Astro.response.status = 403
}

const result = Astro.getActionResult(actions.updateCommission)
if (result && !result.error && commission) {
  return Astro.redirect(`/commissions/${commission.id}`)
}
---

<Layout
  title={commission
    ? `编辑 ${commission.title} · 边缘工会`
    : '委托不存在 · 边缘工会'}
>
  <main>
    {
      commission ? (
        isOwner ? (
          <>
            <header>
              <h1>编辑委托</h1>
              <p>
                更新委托说明、需求类型或人数，让所有正在关注这份委托的人看到最新状态。
              </p>
            </header>

            <CommissionForm commission={commission}>
              <ErrorBox error={result?.error} />
            </CommissionForm>
          </>
        ) : (
          <p class="not-found">你没有权限编辑这份委托</p>
        )
      ) : (
        <p class="not-found">该委托不存在或已被删除</p>
      )
    }
  </main>
</Layout>
