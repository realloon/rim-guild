---
import Layout from '../../../layouts/Layout.astro'
import CommissionForm from '../../../components/CommissionForm.astro'
import ErrorBox from '../../../components/ui/ErrorBox.astro'
import Notice from '../../../components/ui/Notice.astro'
import {
  findCommission,
} from '../../../lib/commissions'
import { actions } from 'astro:actions'
import { env } from 'cloudflare:workers'

const db = env.rim_guild_db
const { id } = Astro.params

const commission = await findCommission(db, Number(id))
const isOwner =
  !!commission && Astro.locals.auth?.profileToken === commission.author_token

if (!commission) {
  Astro.response.status = 404
} else if (!isOwner) {
  Astro.response.status = 403
}

const result = Astro.getActionResult(actions.updateCommission)
if (result && !result.error && commission) {
  return Astro.redirect(`/commissions/${commission.id}`)
}
---

<Layout
  title={commission
    ? `编辑 ${commission.title} · 边缘公会`
    : '委托不存在 · 边缘公会'}
>
  <main>
    {
      commission ? (
        isOwner ? (
          <CommissionForm
            commission={commission}
            title="编辑委托"
            description="更新委托说明、需求类型或人数，让所有正在关注这份委托的人看到最新状态。"
          >
            <ErrorBox error={result?.error} />
          </CommissionForm>
        ) : (
          <Notice>你没有权限编辑这份委托</Notice>
        )
      ) : (
        <Notice>该委托不存在或已被删除</Notice>
      )
    }
  </main>
</Layout>
