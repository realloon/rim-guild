---
import type { HTMLAttributes } from 'astro/types'
import type { ContactMethod } from '../lib/profiles'
import { avatarUrl } from '../lib/avatar'
import BadgeList from './ui/BadgeList.astro'

interface Props extends HTMLAttributes<'section'> {
  seed: string
  name: string
  subtitle?: string
  tags?: string[]
  contacts?: ContactMethod[]
}

const { seed, name, subtitle, tags = [], contacts = [], ...attrs } = Astro.props
---

<section class="profile-card" {...attrs}>
  <header>
    <img src={avatarUrl(seed)} width={64} height={64} alt="avatar" />
    <div>
      <h1>{name}</h1>
      {subtitle && <span>{subtitle}</span>}
      {tags.length > 0 && <BadgeList items={tags} />}
    </div>
  </header>

  {
    contacts.length > 0 && (
      <dl>
        {contacts.map(contact => (
          <div>
            <dt>{contact.label}</dt>
            <dd>{contact.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
  <slot />
</section>

<style>
  .profile-card {
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background-color: var(--surface);
    box-shadow: var(--shadow);
  }

  header {
    position: relative;

    display: flex;
    align-items: start;
    gap: 24px;
    padding-bottom: 24px;
    border-bottom: 1px dashed var(--line);

    div {
      flex-grow: 1;

      h1 {
        color: var(--forest);
        font-size: 2.5rem;
        font-weight: normal;
      }

      span {
        color: var(--text-muted);
        font-size: 0.875rem;
        font-family: var(--mono);
      }

      ul {
        margin-top: 6px;
      }
    }
  }

  dl {
    display: flex;
    gap: 16px;
    margin: 24px 0 0;

    & > div {
      flex: 1;
      padding: 13px 14px;
      border: 1px solid var(--line);
      background-color: var(--page);
    }

    dt {
      margin-bottom: 4px;
      color: var(--text-muted);
      font-family: var(--mono);
      font-size: 0.64rem;
      text-transform: uppercase;
    }

    dd {
      margin: 0;
      overflow: hidden;
      color: var(--text);
      font-size: 0.87rem;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>
