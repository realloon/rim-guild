---
import CommissionListItem from './CommissionListItem.astro'
import type { CommissionSummary, RequirementType } from '../lib/commissions'

interface Props {
  commissions: CommissionSummary[]
  emptyMessage?: string
  requirementFilter?: RequirementType | null
}

const { commissions, emptyMessage, requirementFilter } = Astro.props
const filterable = requirementFilter !== undefined
---

{
  filterable ? (
    <>
      <ul data-filter-list>
        {commissions.map(commission => (
          <CommissionListItem
            commission={commission}
            requirementFilter={requirementFilter}
          />
        ))}
      </ul>
      <slot name="empty" />
    </>
  ) : commissions.length > 0 ? (
    <ul>
      {commissions.map(commission => (
        <CommissionListItem commission={commission} />
      ))}
    </ul>
  ) : emptyMessage ? (
    <p>{emptyMessage}</p>
  ) : (
    <slot name="empty" />
  )
}

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  p {
    margin: 0;
    padding: 64px 24px;
    border: 1px dashed var(--line-muted);
    border-radius: 4px;
    color: var(--text-muted);
    text-align: center;
  }
</style>
