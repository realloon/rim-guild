---
import { actions } from 'astro:actions'
import AuthorAvatar from './AuthorAvatar.astro'
import Button from './ui/Button.astro'
import Control from './ui/Control.astro'
import ErrorBox from './ui/ErrorBox.astro'
import Section from './Section.astro'
import type { CommissionComment } from '../lib/commissions'
import { formatDate } from '../lib/date'

interface Props {
  commissionId: number
  comments: CommissionComment[]
  profileToken: string | null
  commenter: {
    token: string
    author_id: string
    author_name: string
  } | null
  isOwner: boolean
  error?: { message?: string; issues?: { message: string }[] } | null
}

const {
  commissionId,
  comments,
  profileToken,
  commenter,
  isOwner,
  error,
  ...attrs
} = Astro.props
---

<Section
  id="comments"
  title="留言板"
  meta={`${comments.length}条评论`}
  {...attrs}
>
  <ul data-comment-list hidden={comments.length === 0}>
    {
      comments.map(comment => (
        <li>
          <header>
            <AuthorAvatar
              seed={comment.profile_token}
              name={comment.author_name}
              href={`/authors/${comment.author_id}`}
              size={20}
            />
            <time datetime={comment.created_at}>
              {formatDate(comment.created_at)}
            </time>
            {(comment.profile_token === profileToken || isOwner) && (
              <form
                method="POST"
                action={actions.deleteCommissionComment}
                data-comment-delete
                data-confirm="确定删除这条评论吗？"
              >
                <input type="hidden" name="commentId" value={comment.id} />
                <Button variant="link" type="submit">
                  删除
                </Button>
              </form>
            )}
          </header>

          <p>{comment.content}</p>
        </li>
      ))
    }
  </ul>

  {
    commenter && (
      <template data-comment-template>
        <li>
          <header>
            <AuthorAvatar
              seed={commenter.token}
              name={commenter.author_name}
              href={`/authors/${commenter.author_id}`}
              size={20}
            />
            <time data-comment-time />
            <form
              method="POST"
              action={actions.deleteCommissionComment}
              data-comment-delete
              data-confirm="确定删除这条评论吗？"
            >
              <input type="hidden" name="commentId" />
              <Button variant="link" type="submit">
                删除
              </Button>
            </form>
          </header>

          <p data-comment-content />
        </li>
      </template>
    )
  }

  {
    profileToken ? (
      <form
        method="POST"
        action={actions.addCommissionComment}
        data-comment-form
      >
        <input type="hidden" name="commissionId" value={commissionId} />
        <label class="sr-only" for={`comment-content-${commissionId}`}>
          评论内容
        </label>
        <Control
          as="textarea"
          id={`comment-content-${commissionId}`}
          variant="surface"
          density="compact"
          name="content"
          required
          maxlength="500"
          rows="3"
          placeholder="留下你的评论……"
        />
        {error ? <ErrorBox error={error} /> : <p role="alert" hidden />}
        <Button size="sm" type="submit">
          发表
        </Button>
      </form>
    ) : (
      <Button
        size="sm"
        variant="ghost"
        href={'/login?next=/commissions/' + commissionId}
      >
        登录后参与评论
      </Button>
    )
  }
</Section>

<script>
  import { actions } from 'astro:actions'
  import { formatDate } from '../lib/date'

  const forms = Array.from(
    document.querySelectorAll<HTMLFormElement>('form[data-comment-form]'),
  )
  const lists = Array.from(
    document.querySelectorAll<HTMLUListElement>('ul[data-comment-list]'),
  )

  lists.forEach(list => {
    const section = list.closest<HTMLElement>('section')!
    const count = section.querySelector<HTMLElement>('header > span')!

    list.addEventListener('submit', async event => {
      const form = event.target as HTMLFormElement
      if (
        !form.matches('form[data-comment-delete]') ||
        !form.hasAttribute('data-confirmed')
      ) {
        return
      }

      event.preventDefault()
      event.stopPropagation()

      const button = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      )!
      const errorMessage = section.querySelector<HTMLElement>(
        'form[data-comment-form] [role="alert"]',
      )!

      button.disabled = true
      form.setAttribute('aria-busy', 'true')
      errorMessage.hidden = true
      errorMessage.textContent = ''

      try {
        const result = await actions
          .deleteCommissionComment(new FormData(form))
          .catch(error => {
            if (!(error instanceof TypeError)) throw error
            errorMessage.textContent = '网络请求失败，请稍后重试'
            errorMessage.hidden = false
            return null
          })

        if (!result) return

        if (result.error) {
          errorMessage.textContent = result.error.message
          errorMessage.hidden = false
          return
        }

        form.closest<HTMLLIElement>('li')!.remove()
        list.hidden = list.children.length === 0
        count.textContent = `${list.children.length}条评论`
      } finally {
        button.disabled = false
        form.removeAttribute('aria-busy')
      }
    })
  })

  forms.forEach(form => {
    const section = form.closest<HTMLElement>('section')!
    const list = section.querySelector<HTMLUListElement>(
      'ul[data-comment-list]',
    )!
    const count = section.querySelector<HTMLElement>('header > span')!
    const template = section.querySelector<HTMLTemplateElement>(
      'template[data-comment-template]',
    )!
    const errorMessage = form.querySelector<HTMLElement>('[role="alert"]')!
    const content = form.querySelector<HTMLTextAreaElement>(
      'textarea[name="content"]',
    )!
    const button = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    )!

    form.addEventListener('submit', async event => {
      event.preventDefault()
      if (button.disabled) return

      button.disabled = true
      form.setAttribute('aria-busy', 'true')
      errorMessage.hidden = true
      errorMessage.textContent = ''

      try {
        let result
        try {
          result = await actions.addCommissionComment(new FormData(form))
        } catch (error) {
          if (!(error instanceof TypeError)) throw error
          errorMessage.textContent = '网络请求失败，请稍后重试'
          errorMessage.hidden = false
          return
        }

        if (result.error) {
          errorMessage.textContent = result.error.message
          errorMessage.hidden = false
          return
        }

        const comment = template.content.firstElementChild!.cloneNode(
          true,
        ) as HTMLLIElement
        const time = comment.querySelector<HTMLTimeElement>(
          '[data-comment-time]',
        )!
        time.dateTime = result.data.created_at
        time.textContent = formatDate(result.data.created_at)
        comment.querySelector<HTMLParagraphElement>(
          '[data-comment-content]',
        )!.textContent = result.data.content
        comment.querySelector<HTMLInputElement>(
          'input[name="commentId"]',
        )!.value = String(result.data.id)

        list.appendChild(comment)
        list.hidden = false
        count.textContent = `${list.children.length}条评论`
        form.reset()
        content.dispatchEvent(new Event('input', { bubbles: true }))
      } finally {
        button.disabled = false
        form.removeAttribute('aria-busy')
      }
    })
  })
</script>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 0;

    padding-block: 0;
    border-top: 1px solid var(--line);
    margin-block: 0;

    &[hidden] {
      display: none;
    }
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 8px;

    padding-block: 16px;
    border-bottom: 1px dashed var(--line);

    &:last-child {
      border-bottom: 0;
    }

    header {
      display: flex;
      align-items: center;
      gap: 8px;

      time {
        color: var(--text-muted);
        font-size: 0.75rem;
        font-family: var(--mono);
        margin-right: auto;
        margin-bottom: -2px;
      }
    }

    p {
      padding-inline-start: 28px;
      line-height: 1.5;
    }
  }

  section > form {
    display: flex;
    flex-direction: column;
    gap: 12px;

    margin-top: 16px;

    button {
      align-self: end;
    }
  }

  p[role='alert'] {
    margin: 0;
    color: var(--danger);
    font-size: 0.875rem;
  }
</style>
