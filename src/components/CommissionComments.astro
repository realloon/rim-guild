---
import { actions } from 'astro:actions'
import AuthorAvatar from './AuthorAvatar.astro'
import Button from './ui/Button.astro'
import Control from './ui/Control.astro'
import ErrorBox from './ui/ErrorBox.astro'
import Section from './Section.astro'
import { formatDate, type CommissionComment } from '../lib/commissions'

interface Props {
  commissionId: number
  comments: CommissionComment[]
  profileToken: string | null
  isOwner: boolean
  error?: { message?: string; issues?: { message: string }[] } | null
}

const { commissionId, comments, profileToken, isOwner, error } = Astro.props
---

<Section id="comments" title="评论" meta={`${comments.length}条评论`}>
  {
    comments.length > 0 && (
      <ul>
        {comments.map(comment => (
          <li>
            <header>
              <AuthorAvatar
                seed={comment.profile_token}
                name={comment.author_name}
                href={`/authors/${comment.author_id}`}
                size={20}
              />
              <time datetime={comment.created_at}>
                {formatDate(comment.created_at)}
              </time>
              {(comment.profile_token === profileToken || isOwner) && (
                <form
                  method="POST"
                  action={actions.deleteCommissionComment}
                  data-confirm="确定删除这条评论吗？"
                >
                  <input type="hidden" name="commentId" value={comment.id} />
                  <Button variant="link" type="submit">
                    删除
                  </Button>
                </form>
              )}
            </header>

            <p>{comment.content}</p>
          </li>
        ))}
      </ul>
    )
  }

  {
    profileToken ? (
      <form method="POST" action={actions.addCommissionComment}>
        <input type="hidden" name="commissionId" value={commissionId} />
        <Control
          as="textarea"
          name="content"
          required
          maxlength="500"
          rows="4"
          placeholder="留下你的评论……"
        />
        <ErrorBox error={error} />
        <Button size="sm" type="submit">
          发表
        </Button>
      </form>
    ) : (
      <Button
        size="sm"
        variant="ghost"
        href={'/login?next=/commissions/' + commissionId}
      >
        登录后参与评论
      </Button>
    )
  }
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 8px;

    background-color: var(--surface);
    padding: 16px;
    border: 1px solid var(--line);

    header {
      display: flex;
      align-items: center;
      gap: 8px;

      time {
        color: var(--text-muted);
        font-size: 0.75rem;
        font-family: var(--mono);
        margin-right: auto;
        margin-bottom: -2px;
      }
    }

    p {
      line-height: 1.5;
    }
  }

  section > form {
    display: flex;
    flex-direction: column;
    gap: 16px;

    margin-top: 16px;

    textarea {
      border: 1px solid var(--line);
    }

    button {
      align-self: end;
    }
  }
</style>
