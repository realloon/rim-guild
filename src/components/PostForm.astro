---
import { actions } from 'astro:actions'
import { POST_TAGS, ROLE_TYPES, type Post } from '../lib/posts'
import CheckboxGroup from './ui/CheckboxGroup.astro'

interface Props {
  post?: Post
}

const { post } = Astro.props
const action = post ? actions.updatePost : actions.createPost
const submitLabel = post ? '保存修改' : '发布'
---

<script>
  const form = document.querySelector<HTMLFormElement>('[data-role-form]')
  if (form) {
    const pairs = form.querySelector<HTMLElement>('.role-pairs')!
    const addBtn = form.querySelector<HTMLButtonElement>('.add-role')!

    const makePair = () => {
      const template = pairs.querySelector<HTMLElement>('.role-pair')!
      const pair = template.cloneNode(true) as HTMLDivElement
      const removeBtn = pair.querySelector<HTMLButtonElement>('.remove-role')!
      removeBtn.hidden = false
      const select = pair.querySelector('select')!
      select.selectedIndex = 0
      const descInput = pair.querySelector<HTMLInputElement>(
        'input[name="roleDescriptions"]',
      )!
      descInput.value = ''
      const countInput = pair.querySelector<HTMLInputElement>(
        'input[name="roleCounts"]',
      )!
      countInput.value = '1'
      return pair
    }

    addBtn.addEventListener('click', () => {
      const pair = makePair()
      pairs.appendChild(pair)
    })

    pairs.addEventListener('click', event => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>(
        '.remove-role',
      )
      if (btn) {
        const pair = btn.closest<HTMLElement>('.role-pair')!
        if (pairs.querySelectorAll('.role-pair').length > 1) {
          pair.remove()
        } else {
          const descInput = pair.querySelector<HTMLInputElement>(
            'input[name="roleDescriptions"]',
          )!
          descInput.value = ''
          const countInput = pair.querySelector<HTMLInputElement>(
            'input[name="roleCounts"]',
          )!
          countInput.value = '1'
        }
      }
    })
  }
</script>

<form method="POST" action={action} data-role-form>
  {post && <input type="hidden" name="postId" value={post.id} />}

  <label class="form-field" for="title">
    项目标题
    <input
      id="title"
      name="title"
      required
      maxlength="80"
      value={post?.title}
      placeholder="例如：为武器扩展模组招募成员"
    />
  </label>
  <label class="form-field" for="description">
    项目描述（可选）
    <textarea
      id="description"
      name="description"
      maxlength="5000"
      placeholder="介绍你的模组项目：玩法、规模、进度、工期与报酬……"
      >{post?.description}</textarea
    >
  </label>

  <CheckboxGroup
    legend="项目标签（可多选）"
    name="tags"
    options={POST_TAGS}
    checked={post?.tags ?? []}
  />

  <fieldset class="form-section">
    <legend>招揽需求</legend>
    <p class="section-help">把需要的角色拆开写清楚，合作者会更容易判断自己是否适合加入。</p>
    <div class="role-pairs">
      {
        post ? (
          post.roles.map((role, i) => (
            <div class="role-pair">
              <select name="roleTypes" required aria-label="岗位类型">
                {Object.entries(ROLE_TYPES).map(([value, label]) => (
                  <option value={value} selected={role.type === value}>
                    {label}
                  </option>
                ))}
              </select>
              <input
                name="roleDescriptions"
                required
                aria-label="岗位说明"
                value={role.description}
                placeholder="面向该类型的具体需求……"
                maxlength="2000"
              />
              <input
                class="role-count"
                name="roleCounts"
                type="number"
                min="1"
                max="99"
                value={role.count}
                aria-label="需要人数"
                title="需要人数"
              />
              <button
                class="remove-role"
                type="button"
                title="移除"
                aria-label="移除这一项招揽"
                hidden={i === 0 && post.roles.length === 1}
              >
                ×
              </button>
            </div>
          ))
        ) : (
          <div class="role-pair">
            <select name="roleTypes" required aria-label="岗位类型">
              {Object.entries(ROLE_TYPES).map(([value, label]) => (
                <option value={value}>{label}</option>
              ))}
            </select>
            <input
              name="roleDescriptions"
              required
              aria-label="岗位说明"
              placeholder="面向该类型的具体需求……"
              maxlength="2000"
            />
            <input
              class="role-count"
              name="roleCounts"
              type="number"
              min="1"
              max="99"
              value="1"
              aria-label="需要人数"
              title="需要人数"
            />
            <button
              class="remove-role"
              type="button"
              title="移除"
              aria-label="移除这一项招揽"
              hidden
            >
              ×
            </button>
          </div>
        )
      }
    </div>
    <button class="add-role" type="button">+ 添加一项招揽</button>
  </fieldset>

  <div class="form-actions">
    <button class="btn" type="submit">{submitLabel}</button>
    <span>发布后仍可随时编辑项目进度与招揽状态。</span>
  </div>
</form>

<style>
  form {
    max-width: 820px;
  }

  .section-help {
    max-width: 620px;
    margin: -2px 0 16px;
    color: var(--text-dim);
    font-size: 0.84rem;
  }

  .role-pairs {
    display: flex;
    flex-direction: column;
    gap: 10px;
    counter-reset: role-pair;
  }

  .role-pair {
    position: relative;
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr) 76px 38px;
    gap: 8px;
    align-items: center;
    counter-increment: role-pair;

    &::before {
      position: absolute;
      top: 50%;
      left: -42px;
      color: var(--accent);
      content: "0" counter(role-pair);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.64rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      transform: translateY(-50%);
    }

    select,
    input {
      min-width: 0;
    }
  }

  .role-count {
    width: 76px !important;
  }

  .remove-role {
    width: 32px;
    height: 32px;
    padding: 0;
    background: none;
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text-dim);
    font-size: 1rem;
    line-height: 1;

    &:hover {
      border-color: var(--contact-border);
      color: var(--danger);
    }
  }

  .add-role {
    margin-top: 12px;
    padding: 7px 14px;
    border: 1px dashed var(--border-strong);
    border-radius: 3px;
    background: transparent;
    color: var(--text-dim);
    font-size: 0.8rem;
    font-weight: 700;
    transition: 0.2s;
  }

  .add-role:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .form-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .form-actions > span {
    color: var(--text-dim);
    font-size: 0.76rem;
  }

  @media (max-width: 640px) {
    .role-pair {
      grid-template-columns: minmax(0, 1fr) 76px 38px;
      padding-left: 28px;
    }

    .role-pair::before {
      top: 17px;
      left: 0;
      transform: none;
    }

    .role-pair select,
    .role-pair input[name="roleDescriptions"] {
      grid-column: 1 / -1;
    }

    .role-pair .role-count {
      grid-column: 2;
    }

    .role-pair .remove-role {
      grid-column: 3;
    }

    .form-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
