---
import { actions } from 'astro:actions'
import { POST_TAGS, ROLE_TYPES, type Post, type PostTag } from '../lib/posts'

interface Props {
  post?: Post
}

const { post } = Astro.props
const action = post ? actions.updatePost : actions.createPost
const submitLabel = post ? '保存修改' : '发布'
---

<script>
  const form = document.querySelector<HTMLFormElement>('[data-role-form]')
  if (form) {
    const pairs = form.querySelector<HTMLElement>('.role-pairs')!
    const addBtn = form.querySelector<HTMLButtonElement>('.add-role')!

    const makePair = () => {
      const template = pairs.querySelector<HTMLElement>('.role-pair')!
      const pair = template.cloneNode(true) as HTMLDivElement
      const removeBtn = pair.querySelector<HTMLButtonElement>('.remove-role')!
      removeBtn.hidden = false
      const select = pair.querySelector('select')!
      select.selectedIndex = 0
      const descInput = pair.querySelector<HTMLInputElement>(
        'input[name="roleDescriptions"]',
      )!
      descInput.value = ''
      const countInput = pair.querySelector<HTMLInputElement>(
        'input[name="roleCounts"]',
      )!
      countInput.value = '1'
      return pair
    }

    addBtn.addEventListener('click', () => {
      const pair = makePair()
      pairs.appendChild(pair)
    })

    pairs.addEventListener('click', event => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>(
        '.remove-role',
      )
      if (btn) {
        const pair = btn.closest<HTMLElement>('.role-pair')!
        if (pairs.querySelectorAll('.role-pair').length > 1) {
          pair.remove()
        } else {
          const descInput = pair.querySelector<HTMLInputElement>(
            'input[name="roleDescriptions"]',
          )!
          descInput.value = ''
          const countInput = pair.querySelector<HTMLInputElement>(
            'input[name="roleCounts"]',
          )!
          countInput.value = '1'
        }
      }
    })
  }
</script>

<form method="POST" action={action} data-role-form>
  {post && <input type="hidden" name="postId" value={post.id} />}

  <label class="form-field" for="title">
    项目标题
    <input
      id="title"
      name="title"
      required
      maxlength="80"
      value={post?.title}
      placeholder="例如：为武器扩展模组招募成员"
    />
  </label>
  <label class="form-field" for="description">
    项目描述（可选）
    <textarea
      id="description"
      name="description"
      maxlength="5000"
      placeholder="介绍你的模组项目：玩法、规模、进度、工期与报酬……"
      >{post?.description}</textarea
    >
  </label>

  <fieldset class="form-options">
    <legend>项目标签（可多选）</legend>
    <div class="role-checkboxes">
      {
        Object.entries(POST_TAGS).map(([value, label]) => (
          <label class="role-checkbox">
            <input
              type="checkbox"
              name="tags"
              value={value}
              checked={post?.tags.includes(value as PostTag)}
            />
            {label}
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset class="form-section">
    <legend>招揽需求</legend>
    <div class="role-pairs">
      {
        post ? (
          post.roles.map((role, i) => (
            <div class="role-pair">
              <select name="roleTypes" required>
                {Object.entries(ROLE_TYPES).map(([value, label]) => (
                  <option value={value} selected={role.type === value}>
                    {label}
                  </option>
                ))}
              </select>
              <input
                name="roleDescriptions"
                required
                value={role.description}
                placeholder="面向该类型的具体需求……"
                maxlength="2000"
              />
              <input
                class="role-count"
                name="roleCounts"
                type="number"
                min="1"
                max="99"
                value={role.count}
                title="需要人数"
              />
              <button
                class="remove-role"
                type="button"
                title="移除"
                hidden={i === 0 && post.roles.length === 1}
              >
                ×
              </button>
            </div>
          ))
        ) : (
          <div class="role-pair">
            <select name="roleTypes" required>
              {Object.entries(ROLE_TYPES).map(([value, label]) => (
                <option value={value}>{label}</option>
              ))}
            </select>
            <input
              name="roleDescriptions"
              required
              placeholder="面向该类型的具体需求……"
              maxlength="2000"
            />
            <input
              class="role-count"
              name="roleCounts"
              type="number"
              min="1"
              max="99"
              value="1"
              title="需要人数"
            />
            <button class="remove-role" type="button" title="移除" hidden>
              ×
            </button>
          </div>
        )
      }
    </div>
    <button class="add-role" type="button">+ 添加一项招揽</button>
  </fieldset>

  <button class="btn" type="submit">{submitLabel} </button>
</form>

<style>
  .role-pairs {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .role-pair {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .role-pair select {
    flex-shrink: 0;
    width: auto;
    min-width: 6.5rem;
  }

  .role-pair input {
    flex: 1;
  }

  .role-count {
    flex: 0 0 auto;
    width: 4.5rem !important;
  }

  .remove-role {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    box-sizing: border-box;
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-dim);
    font-size: 1rem;
    cursor: pointer;
  }

  .remove-role:hover {
    border-color: #e08b8b;
    color: #e08b8b;
  }

  .add-role {
    margin-top: 0.5rem;
    background: none;
    border: 1px dashed var(--border);
    border-radius: 6px;
    color: var(--text-dim);
    padding: 0.4rem 0.9rem;
    cursor: pointer;
  }

  .add-role:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }
</style>
