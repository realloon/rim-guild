---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'input'> & {
  variant?: 'default' | 'search'
  density?: 'default' | 'compact'
}

const {
  variant = 'default',
  density = 'default',
  class: className,
  ...attrs
} = Astro.props
---

<input
  {...attrs}
  class:list={[
    className,
    {
      'input-search': variant === 'search',
      'input-compact': density === 'compact',
    },
  ]}
/>

<style>
  input {
    display: block;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    min-height: 46px;
    padding: 10px 13px;
    border: 0;
    border-radius: 0;
    outline: 0;
    background-color: var(--page);
    box-shadow: none;
    color: var(--text);
    font-size: 1rem;
    transition: 0.2s;

    &::placeholder {
      color: color-mix(in oklch, var(--text-muted) 55%, var(--surface));
    }

    &:focus {
      border: 0;
      background-color: var(--page);
      box-shadow: none;
    }
  }

  .input-search {
    flex: 1;
    width: auto;
    min-height: 44px;
    padding: 0;
    background-color: transparent;

    &:focus {
      background-color: transparent;
    }
  }

  .input-compact {
    flex: 0 0 76px;
    width: 76px;
  }
</style>
