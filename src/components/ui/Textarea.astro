---
interface Props {
  density?: 'default' | 'compact'
  class?: string
}

const { density = 'default', class: className, ...attrs } = Astro.props
---

<textarea
  {...attrs}
  class:list={[className, { 'textarea-compact': density === 'compact' }]}
  data-auto-resize
><slot /></textarea>

<script>
  const resize = (textarea: HTMLTextAreaElement) => {
    textarea.style.height = 'auto'
    textarea.style.overflowY = 'hidden'

    const maxHeight = Number.parseFloat(getComputedStyle(textarea).maxHeight)
    const height = Math.min(textarea.scrollHeight, maxHeight)
    textarea.style.height = `${height}px`
    textarea.style.overflowY =
      textarea.scrollHeight > height ? 'auto' : 'hidden'
  }

  const setup = () => {
    Array.from(
      document.querySelectorAll<HTMLTextAreaElement>(
        'textarea[data-auto-resize]',
      ),
    ).forEach(resize)
  }

  document.addEventListener('input', event => {
    const target = event.target as HTMLElement
    if (target.matches('textarea[data-auto-resize]')) {
      resize(target as HTMLTextAreaElement)
    }
  })

  setup()
  document.addEventListener('astro:page-load', setup)
</script>

<style>
  textarea[data-auto-resize] {
    display: block;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    padding: 10px 13px;
    border: 0;
    border-radius: 0;
    outline: 0;
    background-color: var(--page);
    box-shadow: none;
    color: var(--text);
    font-size: 1rem;
    transition: 0.2s;

    min-height: calc(3.4lh + 20px);
    max-height: calc(10.2lh + 20px);
    line-height: 1.5;
    overflow-y: hidden;
    resize: none;

    &::placeholder {
      color: color-mix(in oklch, var(--text-muted) 55%, var(--surface));
    }

    &:focus {
      border: 0;
      background-color: var(--page);
      box-shadow: none;
    }
  }

  .textarea-compact {
    flex: 0 0 100%;
    min-height: 72px;
  }
</style>
