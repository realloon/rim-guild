---
const attrs = Astro.props
---

<textarea {...attrs} data-auto-resize><slot /></textarea>

<script>
  const resize = (textarea: HTMLTextAreaElement) => {
    textarea.style.height = 'auto'
    textarea.style.overflowY = 'hidden'

    const maxHeight = Number.parseFloat(getComputedStyle(textarea).maxHeight)
    const height = Math.min(textarea.scrollHeight, maxHeight)
    textarea.style.height = `${height}px`
    textarea.style.overflowY =
      textarea.scrollHeight > height ? 'auto' : 'hidden'
  }

  const setup = () => {
    Array.from(
      document.querySelectorAll<HTMLTextAreaElement>(
        'textarea[data-auto-resize]',
      ),
    ).forEach(resize)
  }

  document.addEventListener('input', event => {
    const target = event.target as HTMLElement
    if (target.matches('textarea[data-auto-resize]')) {
      resize(target as HTMLTextAreaElement)
    }
  })

  setup()
  document.addEventListener('astro:page-load', setup)
</script>

<style>
  textarea[data-auto-resize] {
    min-height: calc(3.4em + 20px);
    max-height: calc(10.2em + 20px);
    overflow-y: hidden;
    resize: none;
  }
</style>
