---
interface Props {
  legend: string
  name: string
  options: Record<string, string>
  checked: string[]
}

const { legend, name, options, checked } = Astro.props
---

<fieldset>
  <legend>{legend}</legend>
  {
    Object.entries(options).map(([value, label]) => (
      <label>
        <input
          type="checkbox"
          name={name}
          value={value}
          checked={checked.includes(value)}
        />
        {label}
      </label>
    ))
  }
</fieldset>

<style>
  fieldset {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: unset;
    border: unset;
    margin-inline: unset;

    legend {
      color: var(--text-muted);

      font-size: 0.75rem;
      font-weight: bold;

      padding-inline: unset;
      margin-bottom: 8px;
    }
  }

  label {
    display: flex;
    align-items: center;
    gap: 8px;

    color: var(--text-muted);
    background: color-mix(in srgb, var(--surface) 68%, transparent);

    font-size: 0.875rem;
    line-height: 1.5;

    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 12px;

    cursor: pointer;
    transition: 0.2s;

    input {
      width: auto;
      min-height: auto;
      margin: 0;
      accent-color: var(--accent);
    }

    &:hover {
      border-color: var(--accent);
      color: var(--accent-strong);
    }

    &:has(input:checked) {
      border-color: var(--accent);
      background: color-mix(
        in oklch,
        var(--accent) 22%,
        light-dark(white, black)
      );
      color: var(--accent-strong);
    }
  }
</style>
