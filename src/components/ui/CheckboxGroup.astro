---
interface Props {
  legend: string
  name: string
  options: Record<string, string>
  checked: string[]
}

const { legend, name, options, checked } = Astro.props
---

<div>
  <span class="legend">{legend}</span>
  <div class="options">
    {
      Object.entries(options).map(([value, label]) => (
        <label>
          <input
            type="checkbox"
            name={name}
            value={value}
            checked={checked.includes(value)}
          />
          {label}
        </label>
      ))
    }
  </div>
</div>

<style>
  .legend {
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: bold;
  }

  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }

  label {
    display: flex;
    align-items: center;
    gap: 8px;

    color: var(--text-muted);
    background-color: var(--page);

    font-size: 0.875rem;

    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    cursor: pointer;

    transition: 0.2s;

    input {
      margin: unset;
      accent-color: var(--accent);
    }

    &:hover,
    &:has(input:checked) {
      color: var(--accent-strong);
      border-color: var(--accent);
    }

    &:has(input:checked) {
      background: color-mix(
        in oklch,
        var(--accent) 22%,
        light-dark(white, black)
      );
    }
  }
</style>
