---
interface Props {
  legend: string
  name: string
  options: Record<string, string>
  checked: string[]
}

const { legend, name, options, checked } = Astro.props
---

<fieldset>
  <legend>{legend}</legend>
  {
    Object.entries(options).map(([value, label]) => (
      <label>
        <input
          type="checkbox"
          name={name}
          value={value}
          checked={checked.includes(value)}
        />
        {label}
      </label>
    ))
  }
</fieldset>

<style>
  fieldset {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 28px;
    padding: 0;
    border: 0;

    legend {
      flex-basis: 100%;
      margin-bottom: 2px;
      padding: 0;
      color: var(--text-muted);
      font-size: 0.76rem;
      font-weight: 700;
    }
  }

  fieldset > label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 68%, transparent);
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.84rem;
    transition: 0.2s;

    input {
      width: auto;
      min-height: auto;
      margin: 0;
      accent-color: var(--accent);
    }

    &:hover {
      border-color: var(--accent);
      color: var(--accent-strong);
    }

    &:has(input:checked) {
      border-color: var(--accent);
      background: color-mix(
        in oklch,
        var(--accent) 22%,
        light-dark(white, black)
      );
      color: var(--accent-strong);
    }
  }
</style>
