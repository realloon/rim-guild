---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'label'>

const { class: className, ...attrs } = Astro.props
---

<label {...attrs} class={className}>
  <slot />
</label>

<style>
  label {
    display: flex;
    flex-direction: column;
    gap: 8px;

    color: var(--text-muted);

    font-size: 0.75rem;
    font-weight: bold;
  }

</style>
