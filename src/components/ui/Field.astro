---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'label'>
---

<label {...Astro.props}>
  <slot />
</label>

<style>
  label {
    display: flex;
    flex-direction: column;
    gap: 8px;

    color: var(--text-muted);

    font-size: 0.75rem;
    font-weight: bold;
  }
</style>
