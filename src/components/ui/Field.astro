---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'label'> {
  label: string
}

const { label, ...attrs } = Astro.props
---

<label {...attrs}>
  <span>{label}</span>
  <slot />
</label>

<style>
  label {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  span {
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: bold;
  }
</style>
