---
import Button from './Button.astro'
---

<dialog
  data-confirm-dialog
  aria-labelledby="confirm-dialog-title"
  aria-describedby="confirm-dialog-message"
>
  <form method="dialog">
    <h2 id="confirm-dialog-title">确认操作</h2>
    <p data-confirm-message></p>
    <footer>
      <Button type="submit" value="cancel" variant="ghost">取消</Button>
      <Button type="submit" value="confirm" variant="danger">确认</Button>
    </footer>
  </form>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(
    'dialog[data-confirm-dialog]',
  )!
  const message = dialog.querySelector<HTMLElement>('[data-confirm-message]')!
  let pendingForm: HTMLFormElement | null = null
  let returnFocus: HTMLElement | null = null

  document.addEventListener('submit', event => {
    const form = event.target as HTMLFormElement
    const confirmation = form.dataset.confirm
    if (!confirmation || form.hasAttribute('data-confirmed')) return

    event.preventDefault()
    if (dialog.open) return

    pendingForm = form
    returnFocus =
      document.activeElement instanceof HTMLElement
        ? document.activeElement
        : null
    message.textContent = confirmation
    dialog.showModal()
  })

  dialog.addEventListener('close', () => {
    const form = pendingForm
    const focus = returnFocus
    pendingForm = null
    returnFocus = null

    if (dialog.returnValue !== 'confirm' || !form) {
      focus?.focus()
      return
    }

    form.setAttribute('data-confirmed', '')
    form.requestSubmit()
    form.removeAttribute('data-confirmed')
  })
</script>

<style>
  dialog {
    background-color: var(--surface);

    width: min(calc(100% - 32px), 420px);
    padding: 24px;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);

    &::backdrop {
      background-color: rgb(0 0 0 / 0.48);
      backdrop-filter: blur(2px);
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    h2 {
      color: var(--forest);
      font-size: 1.5rem;
    }

    p {
      line-height: 1.5;
    }

    footer {
      display: flex;
      justify-content: end;
      gap: 8px;
    }
  }
</style>
