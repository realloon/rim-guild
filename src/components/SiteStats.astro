---
interface Props {
  registeredUserCount: number
  commissionCount: number
  variant: 'card' | 'inline'
}

const { registeredUserCount, commissionCount, variant, ...attrs } = Astro.props
---

<dl data-variant={variant} {...attrs}>
  <div>
    <dt>注册会员</dt>
    <dd>{registeredUserCount}</dd>
  </div>
  <div>
    <dt>委托数量</dt>
    <dd>{commissionCount}</dd>
  </div>
</dl>

<style>
  dl {
    display: flex;

    &[data-variant='card'] {
      justify-content: space-between;
      gap: 16px;
      margin: 0;
      border-top: 1px dashed var(--line);
      padding-top: 16px;

      & > div {
        justify-content: space-between;
        gap: 8px;
      }

      dt {
        color: var(--text-muted);
        font-size: 0.7rem;
      }
    }

    &[data-variant='inline'] {
      gap: 36px;
      color: var(--text-muted);
      margin-block: unset;
    }

    div {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    dd {
      margin: 0;
      color: var(--accent-strong);
      font-family: var(--serif);
      font-size: 1.5rem;
    }
  }
</style>
