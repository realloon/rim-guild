---
import { actions } from 'astro:actions'
import {
  COMMISSION_TAGS,
  REQUIREMENT_TYPES,
  type Commission,
} from '../lib/commissions'
import CheckboxGroup from './ui/CheckboxGroup.astro'
import Button from './ui/Button.astro'
import Control from './ui/Control.astro'
import Field from './ui/Field.astro'

interface Props {
  commission?: Commission
  title: string
  description: string
}

const { commission, title, description } = Astro.props
const action = commission ? actions.updateCommission : actions.createCommission
const submitLabel = commission ? '保存修改' : '发布'
const requirements = commission?.requirements ?? [
  { type: 'artist', count: 1, description: '' },
]
---

<script>
  const form = document.querySelector<HTMLFormElement>(
    'form[data-requirement-form]',
  )
  if (!form) throw new Error('需求表单未找到')

  const pairs = form.querySelector<HTMLUListElement>('fieldset > ul')!
  const addBtn = form.querySelector<HTMLButtonElement>('[data-add-requirement]')!

  const updateRequirementOptions = () => {
    const selects = Array.from(pairs.querySelectorAll('select'))
    const selectedRoles = new Set(selects.map(select => select.value))

    selects.forEach(select => {
      Array.from(select.options).forEach(option => {
        option.disabled =
          option.value !== select.value && selectedRoles.has(option.value)
      })
    })

    addBtn.disabled = selects.length >= selects[0]!.options.length
  }

  const makePair = () => {
    const template = pairs.querySelector('li')!
    const pair = template.cloneNode(true) as HTMLLIElement
    const removeBtn = pair.querySelector<HTMLButtonElement>(
      '[data-remove-requirement]',
    )!
    removeBtn.hidden = false
    const select = pair.querySelector('select') as HTMLSelectElement
    const usedRoles = new Set(
      Array.from(pairs.querySelectorAll('select')).map(
        existingSelect => existingSelect.value,
      ),
    )
    Array.from(select.options).forEach(option => {
      option.disabled = false
    })
    const nextRole = Array.from(select.options).find(
      option => !usedRoles.has(option.value),
    )
    if (nextRole) select.value = nextRole.value

    const descInput = pair.querySelector<HTMLTextAreaElement>('textarea')!
    descInput.style.height = ''
    descInput.value = ''
    const countInput = pair.querySelector<HTMLInputElement>(
      'input[name="requirementCounts"]',
    )!
    countInput.value = '1'
    return pair
  }

  addBtn.addEventListener('click', () => {
    pairs.appendChild(makePair())
    updateRequirementOptions()
  })

  pairs.addEventListener('change', event => {
    if (
      event.target instanceof HTMLSelectElement &&
      event.target.name === 'requirementTypes'
    ) {
      updateRequirementOptions()
    }
  })

  pairs.addEventListener('click', event => {
    if (!(event.target instanceof Element)) return
    const btn = event.target.closest<HTMLButtonElement>(
      '[data-remove-requirement]',
    )
    if (!btn) return

    const pair = btn.closest<HTMLLIElement>('li')!
    if (pairs.querySelectorAll('li').length > 1) {
      pair.remove()
    } else {
      pair.querySelector<HTMLTextAreaElement>('textarea')!.value = ''
      pair.querySelector<HTMLInputElement>(
        'input[name="requirementCounts"]',
      )!.value = '1'
    }
    updateRequirementOptions()
  })

  updateRequirementOptions()
</script>

<header>
  <h1>{title}</h1>
  <p>{description}</p>
</header>

<section>
  <form method="POST" action={action} data-requirement-form>
    {
      commission && (
        <input type="hidden" name="commissionId" value={commission.id} />
      )
    }

    <Field for="title">
      标题
      <Control
        as="input"
        id="title"
        name="title"
        required
        maxlength="80"
        value={commission?.title}
        placeholder="例如：电磁武器拓展模组"
      />
    </Field>
    <Field for="description">
      描述
      <Control
        as="textarea"
        id="description"
        name="description"
        maxlength="5000"
        placeholder="描述模组的玩法、规模和工期，内容越详细具体越容易吸引创作者喔"
        >{commission?.description}</Control
      >
    </Field>

    <CheckboxGroup
      legend="标签"
      name="tags"
      options={COMMISSION_TAGS}
      checked={commission?.tags ?? []}
    />

    <fieldset>
      <legend>需求</legend>
      <ul>
        {
          requirements.map((requirement, i) => (
            <li>
              <Control
                as="select"
                density="compact"
                name="requirementTypes"
                required
                aria-label="需求类型"
              >
                {Object.entries(REQUIREMENT_TYPES).map(([value, label]) => (
                  <option value={value} selected={requirement.type === value}>
                    {label}
                  </option>
                ))}
              </Control>
              <Control
                as="input"
                density="compact"
                name="requirementCounts"
                type="number"
                min="1"
                max="99"
                value={requirement.count}
                aria-label="需要人数"
                title="需要人数"
              />
              <button
                data-remove-requirement
                type="button"
                title="移除"
                aria-label="移除这一项需求"
                hidden={i === 0 && requirements.length === 1}
              >
                ×
              </button>
              <Control
                as="textarea"
                density="compact"
                name="requirementDescriptions"
                required
                aria-label="需求说明"
                placeholder="面向该需求的具体要求"
                maxlength="2000"
                rows="2"
              >
                {requirement.description}
              </Control>
            </li>
          ))
        }
      </ul>
      <button data-add-requirement type="button">
        + 添加需求岗位
      </button>
    </fieldset>

    <footer>
      <Button type="submit">{submitLabel}</Button>
      <small>发布后仍可随时修改</small>
    </footer>
  </form>
  <slot />
</section>

<style>
  header {
    h1 {
      margin-bottom: 16px;
      color: var(--forest);
      font-size: 2.5rem;
    }

    p {
      color: var(--text-muted);
    }
  }

  section {
    padding: clamp(16px, 100%, 32px);
    border: 1px solid var(--line);
    border-top: 3px solid var(--forest);
    background-color: var(--surface);
    box-shadow: var(--shadow);

    @media (max-width: 768px) {
      padding-inline: 16px;
      margin-inline: -8px;
    }
  }

  form {
    max-width: 820px;

    & > fieldset:last-of-type {
      margin: 0 0 28px;
      padding: 0;
      border: 0;
      background: transparent;

      legend {
        margin-bottom: 16px;
      }
    }
  }

  fieldset > ul {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  fieldset > ul > li {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding-bottom: 16px;

    & + & {
      padding-top: 16px;
    }

    &:last-child {
      padding-bottom: 0;
    }
  }

  button[data-remove-requirement],
  button[data-add-requirement] {
    background-color: transparent;
    color: var(--text-muted);
    border-radius: 0;
    transition: 0.2s;
  }

  button[data-remove-requirement] {
    flex: 0 0 32px;
    width: 32px;
    height: 32px;
    padding: 0;
    box-sizing: border-box;
    border: 1px solid transparent;
    font-size: 1rem;

    &:hover {
      border-color: var(--accent-line);
      color: var(--danger);
    }
  }

  button[data-add-requirement] {
    margin-top: 12px;
    padding: 7px 0;
    border: 0;
    font-size: 0.8rem;
    font-weight: 700;

    &:hover {
      color: var(--accent-strong);
    }

    &:disabled {
      color: var(--line-muted);
      cursor: not-allowed;
      opacity: 0.6;
    }
  }

  form > footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;

    & > small {
      color: var(--text-muted);
      font-size: 0.76rem;
    }
  }
</style>
