---
import { actions } from 'astro:actions'
import AuthorAvatar from './AuthorAvatar.astro'
import Button from './ui/Button.astro'
import Badge from './ui/Badge.astro'
import {
  requirementStatusLabel,
  requirementTypeLabel,
  type CommissionClaim,
  type CommissionRequirement,
} from '../lib/commissions'

interface Props {
  commissionId: number
  requirement: CommissionRequirement
  claims: CommissionClaim[]
  isOwner: boolean
  profileToken: string | null
  viewer: {
    token: string
    author_id: string
    author_name: string
  } | null
}

const { commissionId, requirement, claims, isOwner, profileToken, viewer } =
  Astro.props
const registered = claims.some(claim => claim.profile_token === profileToken)
const isOpen = requirement.status === 'open'
const showForm = isOwner || (isOpen && profileToken !== null)
const action = isOwner
  ? actions.updateRequirementStatus
  : registered
    ? actions.cancelClaim
    : actions.claimRequirement
const actionLabel = isOwner
  ? isOpen
    ? '停止招募'
    : '重新开放'
  : registered
    ? '取消认领'
    : '认领需求'
const actionVariant = isOwner || registered ? 'ghost' : 'accent'
---

<li data-status={requirement.status}>
  <header>
    <span>
      <Badge>{requirementTypeLabel(requirement.type)}</Badge>
      <span>需{requirement.count}人</span>
    </span>
    <Badge variant={requirement.status}>
      {requirementStatusLabel(requirement.status)}
    </Badge>
  </header>

  <p>{requirement.description}</p>

  {
    (
      <section
        aria-label="已认领"
        data-claim-summary
        hidden={claims.length === 0}
      >
        <div data-claim-avatars>
          {claims.map(claim => (
            <AuthorAvatar
              seed={claim.profile_token}
              name={claim.author_name}
              href={'/authors/' + claim.author_id}
              size={30}
              showName={false}
              overlap
              data-claim-current={
                claim.profile_token === profileToken ? 'true' : undefined
              }
            />
          ))}
        </div>
        <span data-claim-count>{claims.length}人已认领</span>
      </section>
    )
  }

  {
    viewer && (
      <template data-claim-avatar-template>
        <AuthorAvatar
          seed={viewer.token}
          name={viewer.author_name}
          href={'/authors/' + viewer.author_id}
          size={30}
          showName={false}
          overlap
          data-claim-current="true"
        />
      </template>
    )
  }

  {
    (showForm || isOpen) && (
      <footer>
        {showForm ? (
          <>
            <form
              method="POST"
              action={action}
              data-claim-action={
                !isOwner ? (registered ? 'cancel' : 'claim') : undefined
              }
            >
              <input type="hidden" name="commissionId" value={commissionId} />
              <input
                type="hidden"
                name="requirementType"
                value={requirement.type}
              />
              {isOwner && (
                <input
                  type="hidden"
                  name="status"
                  value={isOpen ? 'closed' : 'open'}
                />
              )}
              <Button
                data-claim-button={!isOwner ? 'true' : undefined}
                aria-pressed={!isOwner ? registered : undefined}
                variant={actionVariant}
                size="sm"
                type="submit"
              >
                {actionLabel}
              </Button>
            </form>
            {!isOwner && <p data-claim-error role="alert" hidden />}
          </>
        ) : (
          <Button size="sm" href={'/login?next=/commissions/' + commissionId}>
            登录后认领需求
          </Button>
        )}
      </footer>
    )
  }
</li>

<style>
  li {
    display: flex;
    flex-direction: column;
    gap: 12px;

    padding: 16px;
    border: 1px solid var(--line);
    background-color: var(--surface);
    box-shadow: var(--shadow-small);

    &[data-status='closed'] {
      opacity: 0.7;
    }
  }

  p {
    color: var(--text);
    line-height: 1.5;

    &:has(+ *) {
      padding-bottom: 8px;
      border-bottom: 1px dashed var(--line);
    }
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    span:first-child {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;

      span:last-child {
        color: var(--text-muted);
        font-size: 0.875rem;
      }
    }
  }

  p[data-claim-error] {
    margin-top: 8px;
    color: var(--danger);
    font-size: 0.875rem;
  }

  section {
    display: flex;
    align-items: center;
    gap: 12px;

    &[hidden] {
      display: none;
    }

    & > span {
      color: var(--text-muted);
      font-size: 0.75rem;
    }

    & > div {
      display: flex;
      align-items: center;
    }
  }
</style>
