---
import { avatarUrl } from '../lib/avatar'

interface Props {
  seed: string
  name: string
  href: string
  size?: number
  avatarSide?: 'left' | 'right'
  showName?: boolean
  overlap?: boolean
}

const {
  seed,
  name,
  href,
  size = 40,
  avatarSide = 'left',
  showName = true,
  overlap = false,
} = Astro.props
---

<a
  data-overlap={overlap || undefined}
  data-side={avatarSide}
  href={href}
  aria-label={showName ? undefined : name + '的作者主页'}
>
  <img
    src={avatarUrl(seed, size)}
    width={size}
    height={size}
    alt={showName ? '' : name + '的头像'}
    title={showName ? undefined : name}
  />
  {showName && name}
</a>

<style>
  a {
    display: flex;
    align-items: center;
    gap: 8px;

    color: var(--text-muted);
    font-size: 0.75rem;
    font-family: var(--serif);

    &:hover {
      color: var(--accent-strong);
    }
  }

  img {
    border-radius: 50%;
    box-shadow: 0 0 4px 1px var(--line);
  }

  a[data-side='right'] img {
    order: 1;
  }

  a[data-overlap] + a[data-overlap] {
    margin-left: -6px;
  }

  a[data-overlap] img {
    border: 2px solid var(--surface);
  }
</style>
