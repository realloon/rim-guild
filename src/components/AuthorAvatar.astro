---
import { avatarUrl } from '../lib/avatar'

interface Props {
  seed: string
  name: string
  href: string
  size?: number
  avatarSide?: 'left' | 'right'
}

const { seed, name, href, size = 40, avatarSide = 'left' } = Astro.props
---

<a class="author" href={href}>
  <img
    class:list={{ 'author-avatar-right': avatarSide === 'right' }}
    class="author-avatar"
    src={avatarUrl(seed, size)}
    width={size}
    height={size}
    alt=""
  />
  {name}
</a>

<style>
  .author-avatar-right {
    order: 1;
  }
</style>
