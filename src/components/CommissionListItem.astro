---
import AuthorAvatar from './AuthorAvatar.astro'
import {
  requirementTypeLabel,
  formatDate,
  type Commission,
} from '../lib/commissions'

interface Props {
  commission: Commission
}

const { commission } = Astro.props
const openRequirements = commission.requirements.filter(
  requirement => requirement.status === 'open',
)
---

<li>
  <div class="commission-card-top">
    <span class="commission-card-type">
      {
        openRequirements.length > 0 ? (
          <>
            <span
              class="requirement-pin requirement-pin-open"
              aria-hidden="true"
            />
            招募中
          </>
        ) : (
          <>
            <span
              class="requirement-pin requirement-pin-closed"
              aria-hidden="true"
            />
            招募已结束
          </>
        )
      }
      <time>{formatDate(commission.created_at)}</time>
    </span>
    <span class="commission-card-top-meta">
      <AuthorAvatar
        seed={commission.author_token}
        name={commission.author_name}
        href={`/authors/${commission.author_id}`}
        size={28}
        avatarSide="right"
      />
    </span>
  </div>
  <a href={`/commissions/${commission.id}`}>
    <h2>{commission.title}</h2>
    {commission.description && <p>{commission.description}</p>}
  </a>
  <div class="commission-card-footer">
    <span class="tags">
      {
        openRequirements.map(requirement => (
          <span class="tag">{requirementTypeLabel(requirement.type)}</span>
        ))
      }
    </span>
  </div>
</li>

<style>
  li {
    position: relative;
    min-width: 0;

    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    box-shadow: var(--shadow-small);
    overflow: hidden;

    transition: 0.2s;

    &::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;

      width: 3px;
      height: 100%;
      background-color: var(--accent);

      transition: 0.2s;
      opacity: 0;
    }

    &:hover {
      border-color: color-mix(in oklch, var(--accent) 60%, var(--line));
      box-shadow: var(--shadow);

      &::after {
        opacity: 1;
      }
    }
  }

  li > a {
    display: block;
    padding: 0 24px;

    h2 {
      margin: 0 0 7px;
      color: var(--forest);
      font-size: 1.28rem;
      font-weight: 600;
    }

    p {
      margin: 0 0 15px;
      overflow: hidden;
      color: var(--text-muted);
      font-size: 0.88rem;

      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }

    &:hover h2 {
      color: color-mix(in oklch, var(--accent) 78%, light-dark(black, white));
    }
  }

  .commission-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: 20px 24px 0;
    margin-bottom: 11px;
  }

  .commission-card-type {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font-family: var(--mono);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;

    time {
      color: var(--text-muted);
      font-family: inherit;
      font-size: 0.72rem;
      font-weight: 400;
      text-transform: none;
    }
  }

  .commission-card-top-meta {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: 12px;
  }

  .commission-card-footer {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: 11px 24px 13px;
    border-top: 1px dashed color-mix(in srgb, var(--line) 75%, transparent);
  }

  .requirement-pin {
    position: relative;
    display: inline-block;
    box-sizing: border-box;
    width: 11px;
    height: 11px;
    flex: 0 0 auto;
    border: 2px solid var(--surface);
    border-radius: 50%;

    &::after {
      content: '';
      position: absolute;
      top: 2px;
      left: 2px;
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background-color: currentColor;
    }
  }

  .requirement-pin-open {
    color: var(--on-forest);
    background-color: var(--success);
    box-shadow:
      0 0 0 1px var(--success),
      0 0 0 3px color-mix(in oklch, var(--forest) 24%, light-dark(white, black)),
      0 1px 3px light-dark(rgb(73 57 40 / 0.07), rgb(0 0 0 / 0.25));
  }

  .requirement-pin-closed {
    color: color-mix(in oklch, var(--line) 50%, var(--text-muted));
    background-color: color-mix(in oklch, var(--page) 80%, var(--line) 20%);
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--line) 50%, var(--text-muted)),
      0 1px 3px light-dark(rgb(73 57 40 / 0.07), rgb(0 0 0 / 0.25));
  }

  @media (max-width: 768px) {
    li > a {
      padding-inline: 20px;
    }

    .commission-card-top {
      align-items: flex-start;
      gap: 7px;
    }

    .commission-card-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 11px;
      padding: 11px 20px 13px;
    }
  }
</style>
