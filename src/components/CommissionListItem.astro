---
import AuthorAvatar from './AuthorAvatar.astro'
import {
  requirementTypeLabel,
  formatDate,
  type Commission,
} from '../lib/commissions'

interface Props {
  commission: Commission
}

const { commission } = Astro.props
const openRequirements = commission.requirements.filter(
  requirement => requirement.status === 'open',
)
---

<li>
  <header>
    <span class="commission-card-type">
      {
        openRequirements.length > 0 ? (
          <>
            <span
              class="requirement-pin requirement-pin-open"
              aria-hidden="true"
            />
            招募中
          </>
        ) : (
          <>
            <span
              class="requirement-pin requirement-pin-closed"
              aria-hidden="true"
            />
            招募已结束
          </>
        )
      }
      <time datetime={commission.created_at}>
        {formatDate(commission.created_at)}
      </time>
    </span>
    <AuthorAvatar
      seed={commission.author_token}
      name={commission.author_name}
      href={`/authors/${commission.author_id}`}
      size={24}
      avatarSide="right"
    />
  </header>
  <a href={`/commissions/${commission.id}`}>
    <h2>{commission.title}</h2>
    {commission.description && <p>{commission.description}</p>}
  </a>
  <div class="commission-card-footer">
    <span class="tags">
      {
        openRequirements.map(requirement => (
          <span class="tag">{requirementTypeLabel(requirement.type)}</span>
        ))
      }
    </span>
  </div>
</li>

<style>
  li {
    position: relative;

    background-color: var(--surface);

    padding: 16px 24px;
    border: 1px solid var(--line);
    border-radius: 4px;
    box-shadow: var(--shadow-small);

    transition: 0.2s;

    &::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;

      width: 3px;
      height: 100%;
      background-color: var(--accent);

      transition: 0.2s;
      opacity: 0;
    }

    &:hover {
      border-color: color-mix(in oklch, var(--accent) 60%, var(--line));
      box-shadow: var(--shadow);

      &::after {
        opacity: 1;
      }
    }
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;

    .commission-card-type {
      display: flex;
      align-items: center;
      gap: 8px;

      color: var(--text-muted);

      font-size: 0.75rem;
      font-weight: bold;

      time {
        font-family: var(--mono);
        font-weight: normal;
        margin-bottom: -1.5px;
      }
    }
  }

  a {
    display: flex;
    flex-direction: column;
    gap: 4px;

    padding-block: 2px 8px;

    &:hover h2 {
      color: color-mix(in oklch, var(--accent) 78%, light-dark(black, white));
    }

    h2 {
      color: var(--forest);
      font-size: 1.25rem;
      line-height: 1.25;
    }

    p {
      color: var(--text-muted);
      font-size: 0.875rem;
      line-height: 1.5;

      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }
  }

  .commission-card-footer {
    display: flex;
    align-items: center;

    padding-top: 12px;
    border-top: 1px dashed color-mix(in srgb, var(--line) 75%, transparent);
  }

  .requirement-pin {
    position: relative;
    display: inline-block;
    box-sizing: border-box;
    width: 11px;
    height: 11px;
    flex: 0 0 auto;
    border: 2px solid var(--surface);
    border-radius: 50%;

    &::after {
      content: '';
      position: absolute;
      top: 2px;
      left: 2px;
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background-color: currentColor;
    }
  }

  .requirement-pin-open {
    color: var(--on-forest);
    background-color: var(--success);
    box-shadow:
      0 0 0 1px var(--success),
      0 0 0 3px color-mix(in oklch, var(--forest) 24%, light-dark(white, black)),
      0 1px 3px light-dark(rgb(73 57 40 / 0.07), rgb(0 0 0 / 0.25));
  }

  .requirement-pin-closed {
    color: color-mix(in oklch, var(--line) 50%, var(--text-muted));
    background-color: color-mix(in oklch, var(--page) 80%, var(--line) 20%);
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--line) 50%, var(--text-muted)),
      0 1px 3px light-dark(rgb(73 57 40 / 0.07), rgb(0 0 0 / 0.25));
  }

  @media (max-width: 768px) {
    .commission-card-top {
      align-items: flex-start;
      gap: 7px;
    }
  }
</style>
