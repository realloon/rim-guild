---
import AuthorAvatar from './AuthorAvatar.astro'
import BadgeList from './ui/BadgeList.astro'
import {
  requirementTypeLabel,
  formatDate,
  type CommissionSummary,
  type RequirementType,
} from '../lib/commissions'

interface Props {
  commission: CommissionSummary
  requirementFilter?: RequirementType | null
}

const { commission, requirementFilter } = Astro.props
const openRequirements = commission.requirements.filter(
  requirement => requirement.status === 'open',
)
const openRequirementTypes = openRequirements.map(
  requirement => requirement.type,
)
const hasOpenRequirements = openRequirements.length > 0
---

<li
  data-requirements={requirementFilter !== undefined
    ? openRequirementTypes.join(' ')
    : undefined}
  hidden={requirementFilter !== undefined &&
    requirementFilter !== null &&
    !openRequirementTypes.includes(requirementFilter)}
>
  <header>
    <span>
      <span
        class="requirement-pin"
        data-status={hasOpenRequirements ? 'open' : 'closed'}
        aria-hidden="true"></span>
      {hasOpenRequirements ? '招募中' : '招募已结束'}
      <time datetime={commission.created_at}>
        {formatDate(commission.created_at)}
      </time>
    </span>
    <AuthorAvatar
      seed={commission.author_token}
      name={commission.author_name}
      href={`/authors/${commission.author_id}`}
      size={24}
      avatarSide="right"
    />
  </header>
  <a href={`/commissions/${commission.id}`}>
    <h2>{commission.title}</h2>
    {commission.description && <p>{commission.description}</p>}
  </a>
  <footer>
    <BadgeList
      items={openRequirements.map(requirement =>
        requirementTypeLabel(requirement.type),
      )}
    />
  </footer>
</li>

<style>
  li {
    background-color: var(--surface);

    padding: 16px 24px;
    border: 1px solid var(--line);
    border-radius: 4px;
    box-shadow: var(--shadow-small);
    transition: 0.2s;

    &:hover {
      border-color: color-mix(in oklch, var(--accent) 60%, var(--line));
      box-shadow: var(--shadow);
    }
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;

    & > span:first-child {
      display: flex;
      align-items: center;
      gap: 8px;

      color: var(--text-muted);

      font-size: 0.75rem;
      font-weight: bold;

      time {
        font-family: var(--mono);
        font-weight: normal;
        margin-bottom: -1.5px;
      }
    }
  }

  a {
    display: flex;
    flex-direction: column;
    gap: 4px;

    padding-block: 8px;

    &:hover h2 {
      color: var(--accent-strong);
    }

    h2 {
      color: var(--forest);
      font-size: 1.25rem;
      line-height: 1.25;
      transition: 0.2s;
    }

    p {
      color: var(--text-muted);
      font-size: 0.875rem;
      line-height: 1.5;

      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }
  }

  footer {
    display: flex;
    align-items: center;

    padding-top: 12px;
    border-top: 1px dashed color-mix(in srgb, var(--line) 75%, transparent);
  }

  .requirement-pin {
    position: relative;
    display: inline-block;
    box-sizing: border-box;
    width: 11px;
    height: 11px;
    flex: 0 0 auto;
    border: 2px solid var(--surface);
    border-radius: 50%;

    &::after {
      content: '';
      position: absolute;
      top: 2px;
      left: 2px;
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background-color: currentColor;
    }
  }

  .requirement-pin[data-status='open'] {
    color: var(--on-forest);
    background-color: var(--success);
    box-shadow:
      0 0 0 1px var(--success),
      0 0 0 3px color-mix(in oklch, var(--forest) 24%, light-dark(white, black)),
      0 1px 3px light-dark(rgb(73 57 40 / 0.07), rgb(0 0 0 / 0.25));
  }

  .requirement-pin[data-status='closed'] {
    color: var(--line-muted);
    background-color: color-mix(in oklch, var(--page) 80%, var(--line) 20%);
    box-shadow:
      0 0 0 1px var(--line-muted),
      0 1px 3px light-dark(rgb(73 57 40 / 0.07), rgb(0 0 0 / 0.25));
  }
</style>
