---
import '../assets/styles/main.css'
import { avatarUrl } from '../lib/avatar'
import { actions } from 'astro:actions'

interface Props {
	title?: string
	back?: boolean
}

const { title = '边缘工会', back = false } = Astro.props
const profileToken = Astro.locals.auth?.profileToken ?? null
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="container">
			<header class="site-header">
				<h1><a href="/">边缘工会</a></h1>
				<div class="header-actions">
					{back && <a class="btn btn-ghost" href="/">返回列表</a>}
					<a class="btn" href={profileToken ? '/posts/new' : '/login?next=/posts/new'}>发布需求</a>
					<button class="header-profile" type="button" popovertarget="profile-menu" title="菜单">
						{profileToken ? (
							<img class="author-avatar" src={avatarUrl(profileToken, 32)} width={32} height={32} alt="我的头像" />
						) : (
							<span class="header-profile-placeholder" aria-hidden="true"></span>
						)}
					</button>
				</div>

				<div id="profile-menu" class="profile-menu" popover>
					{profileToken ? (
						<>
							<a href="/me">我的主页</a>
							<form method="POST" action={actions.logout}>
								<button class="menu-item" type="submit">登出</button>
							</form>
						</>
					) : (
						<a href="/login?next=/me">登录</a>
					)}
				</div>
			</header>

			<slot />
		</div>
	</body>
</html>
