---
import '../assets/styles/main.css'
import Button from '../components/ui/Button.astro'
import { avatarUrl } from '../lib/avatar'
import { actions } from 'astro:actions'

interface Props {
  title?: string
}

const { title = '边缘公会' } = Astro.props
const profileToken = Astro.locals.auth?.profileToken ?? null
const isHome = Astro.url.pathname === '/'
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a href="/" aria-label="home">
        <svg aria-hidden="true" viewBox="0 0 36 36" fill="none">
          <path
            d="M7 8.5h22M7 14.5h15M7 20.5h22M7 26.5h15"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="square"></path>
          <path
            d="m25 14 4 4-4 4"
            stroke="var(--accent)"
            stroke-width="2.5"
            stroke-linecap="square"
            stroke-linejoin="miter"></path>
        </svg>
        <h1>边缘公会</h1>
      </a>

      <nav aria-label="主导航">
        <a aria-current={isHome ? 'page' : undefined} href="/#board">
          查看委托
        </a>
      </nav>

      <div>
        <Button
          variant="primary"
          href={profileToken
            ? '/commissions/new'
            : '/login?next=/commissions/new'}
        >
          <span>发布委托</span>
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M8 3v10M3 8h10"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="square"></path>
          </svg>
        </Button>
        <button
          type="button"
          popovertarget="profile-menu"
          aria-label="打开账户菜单"
        >
          {
            profileToken ? (
              <img
                src={avatarUrl(profileToken)}
                width={36}
                height={36}
                alt=""
              />
            ) : (
              <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
                <circle
                  cx="10"
                  cy="7"
                  r="3"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M4.5 17c.7-3 2.5-4.5 5.5-4.5s4.8 1.5 5.5 4.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            )
          }
        </button>
      </div>
    </header>

    <menu id="profile-menu" popover>
      {
        profileToken ? (
          <>
            <li>
              <a href="/me#profile">个人资料</a>
            </li>
            <li>
              <a href="/me#commissions">我的委托</a>
            </li>
            <li>
              <a href="/me#claims">我认领的</a>
            </li>
            <hr />
            <form method="POST" action={actions.logout}>
              <button type="submit">
                登出
              </button>
            </form>
          </>
        ) : (
          <li>
            <a href="/login?next=/me">登录</a>
          </li>
        )
      }
    </menu>

    <slot />

    <footer>
      <span
        >Copyright © {new Date().getFullYear()} RimGuild. All Rights Reserved.</span
      >
      <span>好的想法值得认真实现</span>
    </footer>
  </body>
</html>

<style>
  header {
    z-index: 1;
    position: sticky;
    top: 0;

    display: flex;
    align-items: center;
    gap: 32px;

    background-color: var(--page);
    height: var(--site-header-height);
    box-shadow: 0 8px 18px var(--page);

    margin-bottom: 72px;
    @media (max-width: 768px) {
      margin-bottom: 48px;
    }

    a[href='/'] {
      display: flex;
      align-items: center;
      gap: 12px;

      margin-right: auto;

      svg {
        vertical-align: top;
        width: 24px;
        height: 24px;
        border: 1px solid var(--forest);
      }

      h1 {
        font-size: 1.5rem;
        font-family: var(--serif);
        color: var(--forest);
      }
    }

    nav {
      justify-content: end;

      display: flex;
      align-items: center;
      gap: 24px;

      a {
        position: relative;
        color: var(--text-muted);

        font-size: 0.875rem;
        font-weight: bold;
        text-decoration: none;

        padding: 20px 0;

        &::after {
          content: '';
          position: absolute;
          right: 0;
          left: 0;
          bottom: 0px;

          height: 2px;
          background-color: var(--accent);

          transition: 0.2s;
          opacity: 0;
          transform: scaleX(0.8);
        }

        &:hover,
        &[aria-current='page'] {
          color: var(--accent-strong);
        }

        &[aria-current='page']::after,
        &:hover::after {
          opacity: 1;
        }
      }
    }

    & > div:last-child {
      display: flex;
      align-items: center;
      gap: 12px;

      button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: transparent;

        anchor-name: --profile-anchor;

        padding: 0;
        border: 1px solid var(--line-muted);
        border-radius: 50%;
        transition: 0.2s;

        &:hover {
          color: var(--accent-strong);
          border-color: var(--accent);
        }

        img,
        svg {
          vertical-align: top;
          width: 32px;
          height: 32px;
          border-radius: 50%;
          border: 0;
        }
      }
    }
  }

  #profile-menu:popover-open {
    position: fixed;
    position-anchor: --profile-anchor;
    position-area: bottom span-left;
    top: 8px; /* gap hack */

    list-style-type: none;
    background-color: color-mix(in oklch, var(--surface) 90%, transparent);
    backdrop-filter: blur(10px);

    min-width: 8rem;
    padding: 4px;
    border: 1px solid var(--line-soft);
    border-radius: 12px;
    box-shadow: var(--shadow);

    a,
    form > button {
      display: block;
      box-sizing: border-box;

      font-size: 0.875rem;
      text-align: left;

      color: var(--text);
      background-color: transparent;

      width: 100%;
      padding: 10px 12px;
      border: 0;
      border-radius: 6px;

      transition: 0.2s;
    }

    a:hover,
    form > button:hover {
      color: var(--accent-strong);
    }

    a:hover {
      background: color-mix(in oklch, var(--page) 80%, var(--line) 20%);
    }

    hr {
      height: 1px;
      margin: 4px -4px;
      border: 0;
      background: var(--line-soft);
    }
  }

  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;

    color: var(--text-muted);
    font-size: 0.75rem;
    font-family: var(--serif);

    padding-block: 24px;
    border-top: 1px solid var(--line);

    margin-top: 96px;

    span:first-of-type {
      font-family: var(--mono);
    }
  }

  @media (max-width: 768px) {
    [aria-label='主导航'] {
      display: none;
    }

    header > div:last-child > :global(a) svg {
      display: none;
    }

    footer {
      flex-direction: column-reverse;
    }
  }
</style>
