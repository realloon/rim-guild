---
import '../assets/styles/main.css'
import { avatarUrl } from '../lib/avatar'
import { actions } from 'astro:actions'

interface Props {
  title?: string
  back?: boolean
}

const { title = '边缘工会', back = false } = Astro.props
const profileToken = Astro.locals.auth?.profileToken ?? null
const isHome = Astro.url.pathname === '/'
---

<script>
  const profileMenu = document.querySelector<HTMLElement>('#profile-menu')!
  const items = profileMenu.querySelectorAll('a')

  items.forEach(item =>
    item.addEventListener('click', () => {
      profileMenu.hidePopover()
    }),
  )
</script>

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a href="/" aria-label="home">
        <svg aria-hidden="true" viewBox="0 0 36 36" fill="none">
          <path
            d="M7 8.5h22M7 14.5h15M7 20.5h22M7 26.5h15"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="square"></path>
          <path
            d="m25 14 4 4-4 4"
            stroke="var(--accent)"
            stroke-width="2.5"
            stroke-linecap="square"
            stroke-linejoin="miter"></path>
        </svg>
        <h1>边缘工会</h1>
      </a>

      <nav aria-label="主导航">
        <a class:list={{ active: isHome }} href="/#board">查看委托</a>
      </nav>

      <section>
        {
          back && (
            <a class="back-link header-back" href="/">
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M13 8H3m4-4-4 4 4 4"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="square"
                  stroke-linejoin="miter"
                />
              </svg>
              <span>返回列表</span>
            </a>
          )
        }
        <a
          class="btn publish-link"
          href={profileToken
            ? '/commissions/new'
            : '/login?next=/commissions/new'}
        >
          <span>发布委托</span>
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M8 3v10M3 8h10"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="square"></path>
          </svg>
        </a>
        <button
          type="button"
          popovertarget="profile-menu"
          aria-label="打开账户菜单"
        >
          {
            profileToken ? (
              <img
                src={avatarUrl(profileToken, 36)}
                width={36}
                height={36}
                alt=""
              />
            ) : (
              <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
                <circle
                  cx="10"
                  cy="7"
                  r="3"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M4.5 17c.7-3 2.5-4.5 5.5-4.5s4.8 1.5 5.5 4.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            )
          }
        </button>
      </section>
    </header>
  </body>

  <div id="profile-menu" popover>
    {
      profileToken ? (
        <>
          <a href="/me#profile">个人资料</a>
          <a href="/me#commissions">我的委托</a>
          <a href="/me#claims">我认领的</a>
          <hr />
          <form method="POST" action={actions.logout}>
            <button class="menu-item" type="submit">
              登出
            </button>
          </form>
        </>
      ) : (
        <a href="/login?next=/me">登录</a>
      )
    }
  </div>

  <slot />

  <footer class="site-footer">
    <span
      >Copyright © {new Date().getFullYear()} RimGuild. All Rights Reserved.</span
    >
    <span>好的想法值得认真实现</span>
  </footer>
</html>

<style>
  header {
    z-index: 1;
    position: sticky;
    top: 0;

    display: flex;
    align-items: center;
    gap: 32px;

    background-color: var(--page);
    height: var(--site-header-height);
    box-shadow: 0 8px 18px var(--page);

    a[href='/'] {
      display: flex;
      align-items: center;
      gap: 12px;

      svg {
        vertical-align: top;
        width: 32px;
        height: 32px;
        border: 1px solid var(--forest);
      }

      h1 {
        font-size: 1.5rem;
        font-family: var(--serif);
        color: var(--forest);
      }
    }

    nav {
      flex-grow: 1;
      justify-content: end;

      display: flex;
      align-items: center;
      gap: 24px;

      a {
        position: relative;
        color: var(--text-muted);

        font-size: 0.875rem;
        font-weight: bold;
        text-decoration: none;

        padding: 20px 0;

        &::after {
          content: '';
          position: absolute;
          right: 0;
          left: 0;
          bottom: 0px;

          height: 2px;
          background-color: var(--accent);

          transition: 0.2s;
          opacity: 0;
          transform: scaleX(0.8);
        }

        &:hover,
        &.active {
          color: color-mix(
            in oklch,
            var(--accent) 78%,
            light-dark(black, white)
          );
        }

        &.active::after,
        &:hover::after {
          opacity: 1;
        }
      }
    }

    section {
      display: flex;
      align-items: center;
      gap: 12px;

      .publish-link {
        background-color: var(--forest);

        svg {
          width: 14px;
          height: 14px;
          border: unset;
        }
      }

      button {
        background-color: transparent;

        anchor-name: --profile-anchor;
        place-items: center;

        padding: 0;
        border: 1px solid
          color-mix(in oklch, var(--line) 50%, var(--text-muted));
        border-radius: 50%;
        transition: 0.2s;

        &:hover {
          color: color-mix(
            in oklch,
            var(--accent) 78%,
            light-dark(black, white)
          );
          border-color: var(--accent);
        }

        img,
        svg {
          vertical-align: top;
          width: 32px;
          height: 32px;
          border-radius: 50%;
          border: unset;
        }
      }
    }
  }

  #profile-menu:popover-open {
    position: fixed;
    position-anchor: --profile-anchor;
    position-area: bottom span-left;
    top: 8px;

    display: flex;
    flex-direction: column;

    background-color: color-mix(in oklch, var(--surface) 90%, transparent);
    backdrop-filter: blur(10px);

    min-width: 8rem;
    padding: 4px;
    border: 1px solid color-mix(in oklch, var(--line) 50%, transparent);
    border-radius: 12px;
    box-shadow: var(--shadow);

    a,
    .menu-item {
      box-sizing: border-box;

      font-size: 0.875rem;
      text-align: left;

      color: var(--text);
      background-color: transparent;

      width: 100%;
      padding: 10px 12px;
      border: unset;
      border-radius: 6px;
    }

    a:hover {
      color: color-mix(in oklch, var(--accent) 78%, light-dark(black, white));
      background: color-mix(in oklch, var(--page) 80%, var(--line) 20%);
    }

    .menu-item:hover {
      color: color-mix(in oklch, var(--accent) 78%, light-dark(black, white));
      background-color: color-mix(
        in oklch,
        var(--accent) 22%,
        light-dark(white, black)
      );
    }

    hr {
      height: 1px;
      margin: 4px -4px;
      border: unset;
      background: var(--line);
    }
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;

    color: var(--text-muted);
    font-size: 0.75rem;

    padding-block: 24px;
    border-top: 1px solid var(--line);

    span:first-of-type {
      font-family: var(--mono);
    }

    span:last-of-type {
      font-family: var(--serif);
    }
  }
</style>
