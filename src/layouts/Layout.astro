---
import '../assets/styles/main.css'
import { avatarUrl } from '../lib/avatar'
import { actions } from 'astro:actions'

interface Props {
  title?: string
  back?: boolean
}

const { title = '边缘工会', back = false } = Astro.props
const profileToken = Astro.locals.auth?.profileToken ?? null
const isHome = Astro.url.pathname === '/'
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/" aria-label="边缘工会首页">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 36 36" fill="none">
              <path
                d="M7 8.5h22M7 14.5h15M7 20.5h22M7 26.5h15"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="square"></path>
              <path
                d="m25 14 4 4-4 4"
                stroke="var(--accent)"
                stroke-width="2.5"
                stroke-linecap="square"
                stroke-linejoin="miter"></path>
            </svg>
          </span>
          <span class="brand-copy">
            <strong>边缘工会</strong>
            <small>模组创作者协作平台</small>
          </span>
        </a>

        <nav class="site-nav" aria-label="主导航">
          <a class:list={{ active: isHome }} href="/#board">查看委托</a>
        </nav>

        <div class="header-actions">
          {
            back && (
              <a class="back-link header-back" href="/">
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path
                    d="M13 8H3m4-4-4 4 4 4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="square"
                    stroke-linejoin="miter"
                  />
                </svg>
                <span>返回列表</span>
              </a>
            )
          }
          <a
            class="btn btn-primary publish-link"
            href={profileToken
              ? '/commissions/new'
              : '/login?next=/commissions/new'}
          >
            <span>发布委托</span>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M8 3v10M3 8h10"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"></path>
            </svg>
          </a>
          <button
            class="header-profile"
            type="button"
            popovertarget="profile-menu"
            aria-label="打开账户菜单"
          >
            {
              profileToken ? (
                <img
                  class="author-avatar"
                  src={avatarUrl(profileToken, 36)}
                  width={36}
                  height={36}
                  alt=""
                />
              ) : (
                <span class="header-profile-placeholder" aria-hidden="true">
                  <svg viewBox="0 0 20 20" fill="none">
                    <circle
                      cx="10"
                      cy="7"
                      r="3"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                    <path
                      d="M4.5 17c.7-3 2.5-4.5 5.5-4.5s4.8 1.5 5.5 4.5"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                  </svg>
                </span>
              )
            }
          </button>
        </div>
      </div>

      <div id="profile-menu" class="profile-menu" popover>
        {
          profileToken ? (
            <>
              <a href="/me#profile">个人资料</a>
              <a href="/me#commissions">我的委托</a>
              <a href="/me#claims">我认领的</a>
              <hr />
              <form method="POST" action={actions.logout}>
                <button class="menu-item" type="submit">
                  登出
                </button>
              </form>
            </>
          ) : (
            <a href="/login?next=/me">登录</a>
          )
        }
      </div>
    </header>

    <script>
      const profileMenu = document.querySelector<HTMLElement>('#profile-menu')!
      const items = profileMenu.querySelectorAll('a')

      items.forEach(item =>
        item.addEventListener('click', () => {
          profileMenu.hidePopover()
        }),
      )
    </script>

    <slot />

    <footer class="site-footer">
      <span>Copyright © 2026 RimGuild. All Rights Reserved.</span>
      <span>让创意成为创造</span>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    width: 100%;
    margin: 0;
    background: color-mix(in srgb, var(--page) 90%, transparent);
    box-shadow: 0 8px 18px var(--page);
    backdrop-filter: blur(14px);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 72px);
    min-height: var(--site-header-height);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-width: 0;
    color: var(--forest);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--forest);
    color: var(--forest);
  }

  .brand-mark svg {
    width: 30px;
    height: 30px;
  }

  .brand-copy {
    display: grid;
    gap: 2px;
  }

  .brand-copy strong {
    font-family: var(--serif);
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1;
  }

  .brand-copy small {
    color: var(--text-muted);
    font-family: var(--mono);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    line-height: 1;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 25px;
    margin-left: auto;
  }

  .site-nav a {
    position: relative;
    padding: 21px 0 20px;
    color: var(--text-muted);
    font-size: 0.83rem;
    font-weight: 700;
    text-decoration: none;
  }

  .site-nav a::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--accent);
    content: '';
    opacity: 0;
    transform: scaleX(0.35);
    transition: 0.2s;
  }

  .site-nav a:hover,
  .site-nav a.active {
    color: color-mix(in oklch, var(--accent) 78%, light-dark(black, white));
  }

  .site-nav a.active::after,
  .site-nav a:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .publish-link svg {
    width: 15px;
    height: 15px;
  }

  .header-back {
    margin-right: 4px;
    font-size: 0.78rem;
  }

  .header-back svg {
    width: 16px;
    height: 16px;
  }

  .header-profile {
    display: grid;
    width: 40px;
    height: 40px;
    padding: 1px;
    border: 1px solid color-mix(in oklch, var(--line) 50%, var(--text-muted));
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    line-height: 0;
    place-items: center;
    anchor-name: --profile-anchor;
    transition: 0.2s;
  }

  .header-profile:hover {
    border-color: var(--accent);
    color: color-mix(in oklch, var(--accent) 78%, light-dark(black, white));
  }

  .header-profile .author-avatar {
    width: 36px;
    height: 36px;
    border: 0;
    box-shadow: none;
  }

  .header-profile-placeholder {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
  }

  .header-profile-placeholder svg {
    width: 20px;
    height: 20px;
  }

  .profile-menu {
    position: fixed;
    position-anchor: --profile-anchor;
    position-area: bottom span-left;
    top: 10px;
    z-index: 30;
    min-width: 178px;
    margin: 0;
    padding: 8px;
    border: 1px solid color-mix(in oklch, var(--line) 50%, var(--text-muted));
    border-radius: 3px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .profile-menu::backdrop {
    background: transparent;
  }

  .profile-menu hr {
    height: 1px;
    margin: 8px 4px;
    border: 0;
    background: var(--line);
  }

  .profile-menu a,
  .profile-menu .menu-item {
    display: block;
    width: 100%;
    padding: 10px 11px;
    border: 0;
    border-radius: 2px;
    background: transparent;
    color: var(--text);
    font-size: 0.84rem;
    text-align: left;
    text-decoration: none;
  }

  .profile-menu a:hover,
  .profile-menu .menu-item:hover {
    background: color-mix(in oklch, var(--page) 80%, var(--line) 20%);
    color: color-mix(in oklch, var(--accent) 78%, light-dark(black, white));
  }

  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: calc(100% - clamp(32px, 8vw, 144px));
    max-width: 1160px;
    margin: 0 auto;
    padding: 20px 0 28px;
    border-top: 1px solid var(--line);
    color: var(--text-muted);
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
  }

  @media (max-width: 800px) {
    .site-nav {
      display: none;
    }

    .site-header .btn {
      min-height: 38px;
      padding: 8px 12px;
      font-size: 0.78rem;
    }

    .header-back span {
      display: none;
    }

    .header-back {
      margin-right: 0;
    }
  }

  @media (max-width: 520px) {
    .brand-copy small {
      display: none;
    }

    .brand-copy strong {
      font-size: 1rem;
    }

    .brand-mark {
      width: 34px;
      height: 34px;
    }

    .brand-mark svg {
      width: 27px;
      height: 27px;
    }

    .publish-link span {
      display: none;
    }

    .publish-link {
      width: 38px;
      min-height: 38px !important;
      padding: 0 !important;
    }

    .site-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
