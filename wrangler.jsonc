{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-02",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "rim-guild",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "rim_guild_db",
			"database_name": "rim-guild-db",
			"database_id": "5fd6f6b6-12bf-416a-a28d-bfc5a41fc018"
		}
	]
}